#!/usr/bin/env python3
"""AryaLinux Package System (ALPS) CLI."""

import sys
from pathlib import Path

_lib = Path("/var/lib/alps")
if not (_lib / "alps").is_dir():
    _lib = Path(__file__).resolve().parents[2] / "var" / "lib" / "alps"
sys.path.insert(0, str(_lib))

from alps.cli import main

if __name__ == "__main__":
    raise SystemExit(main())
