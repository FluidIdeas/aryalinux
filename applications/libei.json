{
  "name": "libei",
  "version": "1.5.0",
  "description": "",
  "category": "",
  "dependencies": {
    "required": [
      "python-deps.attrs"
    ]
  },
  "build": {
    "user": [
      "mkdir build",
      "cd    build",
      "meson setup --prefix=/usr --buildtype=release -D tests=disabled",
      "ninja"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja install"
    ]
  },
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "meta": false,
  "book": "x/libei.html",
  "url": [
    "https://gitlab.freedesktop.org/libinput/libei/-/archive/1.5.0/libei-1.5.0.tar.bz2"
  ]
}
