{
  "name": "ddm",
  "version": "0.3.6",
  "description": "Display manager for Deepin Desktop Environment.",
  "category": "desktop-deepin",
  "dependencies": {
    "required": [
      "linux-pam",
      "qt6",
      "systemd",
      "treeland",
      "wayland",
      "xorg-server"
    ]
  },
  "build": {
    "user": [
      "cmake . -GNinja -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_INSTALL_LIBEXECDIR=lib -DCMAKE_INSTALL_PREFIX=/usr -DDBUS_CONFIG_DIR=/usr/share/dbus-1/system.d",
      "cmake --build ."
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja install",
      "rm -fv $DESTDIR/usr/share/dbus-1/system.d/org.freedesktop.DisplayManager.conf"
    ]
  },
  "post_install": [
    "systemctl enable ddm 2>/dev/null || true"
  ],
  "meta": false,
  "book": "deepin/ddm.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "url": [
    "https://github.com/linuxdeepin/ddm/archive/refs/tags/0.3.6.tar.gz"
  ]
}
