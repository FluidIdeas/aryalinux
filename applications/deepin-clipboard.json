{
  "name": "deepin-clipboard",
  "version": "6.1.28",
  "description": "DDE clipboard manager component (Deepin Desktop Environment).",
  "category": "desktop-deepin",
  "dependencies": {
    "required": [
      "deepin-shell",
      "deepin-tray-loader",
      "dtk6core",
      "dtk6gui",
      "dtk6widget",
      "gio-qt",
      "qt6"
    ]
  },
  "build": {
    "user": [
      "cmake . -GNinja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_INSTALL_LIBEXECDIR=lib -DCMAKE_INSTALL_SYSCONFDIR=/etc ",
      "ninja"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "deepin/deepin-clipboard.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "url": [
    "https://github.com/linuxdeepin/deepin-clipboard/archive/refs/tags/6.1.28.tar.gz"
  ]
}
