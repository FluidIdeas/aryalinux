{
  "name": "deepin-voice-note",
  "version": "6.5.39",
  "description": "A lightweight memo tool to make text notes and voice recordings (Deepin Desktop Environment).",
  "category": "desktop-deepin",
  "dependencies": {
    "required": [
      "deepin-movie",
      "dtk6core",
      "dtk6declarative",
      "dtk6gui",
      "dtk6widget",
      "glib2",
      "hicolor-icon-theme",
      "qt6",
      "qtwebengine"
    ]
  },
  "build": {
    "user": [
      "cmake . -GNinja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_INSTALL_LIBEXECDIR=lib -DCMAKE_INSTALL_SYSCONFDIR=/etc ",
      "ninja"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "deepin/deepin-voice-note.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "url": [
    "https://github.com/linuxdeepin/deepin-voice-note/archive/refs/tags/6.5.39.tar.gz"
  ]
}
