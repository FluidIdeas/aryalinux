{
  "name": "tigervnc",
  "version": "1.16.0",
  "description": "Tigervnc is an advanced VNC (Virtual Network Computing) implementation. It allows creation of an Xorg server not tied to a physical console and also provides a client for viewing of the remote graphical desktop.",
  "url": [
    "https://github.com/TigerVNC/tigervnc/archive/v1.16.0/tigervnc-1.16.0.tar.gz"
  ],
  "dependencies": {
    "required": [
      "cmake",
      "fltk",
      "gnutls",
      "imagemagick",
      "libgcrypt",
      "libjpeg",
      "linux-pam",
      "pixman",
      "systemd",
      "x7app",
      "x7legacy",
      "xinit"
    ]
  },
  "build": {
    "user": [
      "patch -Np1 -i ../tigervnc-1.16.0-configuration_fixes-1.patch",
      "sed -i \"/FL_MINOR_VERSION/s/3/4/\" CMakeLists.txt",
      "mkdir -p unix/xserver",
      "tar -xf ../xorg-server-21.1.21.tar.xz \\\n    --strip-components=1              \\\n    -C unix/xserver",
      "( cd unix/xserver && patch -Np1 -i ../xserver21.patch )",
      "cmake -B build -G \"Unix Makefiles\"          \\\n      -D CMAKE_INSTALL_PREFIX=/usr \\\n      -D CMAKE_BUILD_TYPE=Release  \\\n      -W no-dev .",
      "make -C build",
      "pushd unix/xserver",
      "autoreconf -fiv",
      "CPPFLAGS=\"-I/usr/include/drm\"       \\\n  ./configure $XORG_CONFIG            \\\n      --disable-xwayland    --disable-dri        --disable-dmx         \\\n      --disable-xorg        --disable-xnest      --disable-xvfb        \\\n      --disable-xwin        --disable-xephyr     --disable-kdrive      \\\n      --disable-devel-docs  --disable-config-hal --disable-config-udev \\\n      --disable-unit-tests  --disable-selective-werror                 \\\n      --disable-static      --enable-dri3                              \\\n      --without-dtrace      --enable-dri2        --enable-glx          \\\n      --with-pic",
      "make -C build",
      "popd"
    ],
    "package": [
      "make -C build install DESTDIR=$DESTDIR",
      "( cd unix/xserver/hw/vnc && make -C build install DESTDIR=$DESTDIR )",
      "[ -e $DESTDIR/usr/bin/Xvnc ] || ln -svf $XORG_PREFIX/bin/Xvnc $DESTDIR/usr/bin/Xvnc",
      "install -vdm755 $DESTDIR/etc/X11/tigervnc",
      "install -v -m755 Xsession $DESTDIR/etc/X11/tigervnc"
    ]
  },
  "post_install": [
    "install -vdm755 ~/.config/tigervnc",
    "cat > ~/.config/tigervnc/config << \"EOF\"\n# Begin ~/.config/tigervnc/config\n# The session must match one listed in /usr/share/xsessions.\n# Ensure that there are no spaces at the end of the lines.\n\nsession=lxqt\ngeometry=1024x768\n\n# End ~/.config/tigervnc/config\nEOF",
    "echo \":1=$(whoami)\" >> /etc/tigervnc/vncserver.users",
    "systemctl enable vncserver@:1"
  ],
  "meta": false,
  "book": "xsoft/tigervnc.html",
  "category": "applications",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "additionalUrls": [
    "https://www.linuxfromscratch.org/patches/blfs/13.0/tigervnc-1.16.0-configuration_fixes-1.patch"
  ]
}
