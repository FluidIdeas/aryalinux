{
  "name": "dtkdeclarative",
  "version": "1:6.7.43",
  "description": "DTK declarative/QML modules (Qt5 build) for Deepin Desktop Environment.",
  "category": "desktop-deepin",
  "dependencies": {
    "required": [
      "dtkcore",
      "dtkgui",
      "dtkwidget",
      "qt5-base"
    ]
  },
  "build": {
    "user": [
      "cmake . -Bbuild-qt5 -GNinja -DDTK5=ON -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_INSTALL_PREFIX=/usr",
      "cmake --build build-qt5"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build-qt5 install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "deepin/dtkdeclarative.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "url": [
    "https://github.com/linuxdeepin/dtkdeclarative/archive/refs/tags/6.7.43.tar.gz"
  ]
}
