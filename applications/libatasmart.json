{
  "name": "libatasmart",
  "version": "0.19",
  "description": "The libatasmart package is a disk reporting library. It only supports a subset of the ATA S.M.A.R.T. functionality.",
  "url": "https://0pointer.de/public/libatasmart-0.19.tar.xz",
  "dependencies": {},
  "build": {
    "user": [
      "./configure --prefix=/usr --disable-static",
      "make"
    ],
    "package": [
      "make docdir=/usr/share/doc/libatasmart-0.19 install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "general/libatasmart.html",
  "category": "libraries",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
