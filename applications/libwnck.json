{
  "name": "libwnck",
  "version": "43.3",
  "description": "The libwnck package contains the Window Navigator Construction Kit.",
  "url": [
    "https://download.gnome.org/sources/libwnck/43/libwnck-43.3.tar.xz"
  ],
  "dependencies": {
    "required": [
      "gtk3",
      "glib2",
      "startup-notification"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr --buildtype=release .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "xfce/libwnck.html",
  "category": "desktop-xfce",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
