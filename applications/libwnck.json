{
  "name": "libwnck",
  "version": "43.3",
  "description": "The libwnck package contains the Window Navigator Construction Kit.",
  "url": "https://download.gnome.org/sources/libwnck/43/libwnck-43.3.tar.xz",
  "dependencies": {
    "required": [
      "gtk3",
      "glib2",
      "startup-notification"
    ]
  },
  "build": {
    "user": [
      "mkdir build",
      "cd    build",
      "meson setup --prefix=/usr --buildtype=release ..",
      "ninja"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja install"
    ]
  },
  "meta": false,
  "book": "xfce/libwnck.html",
  "category": "desktop-xfce",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
