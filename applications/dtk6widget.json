{
  "name": "dtk6widget",
  "version": "6.0.50",
  "description": "Deepin base graphical widgets library (Deepin Desktop Environment).",
  "category": "desktop-deepin",
  "dependencies": {
    "required": [
      "dtk6core",
      "dtk6gui",
      "qt6",
      "startup-notification",
      "xcb-util"
    ]
  },
  "build": {
    "user": [
      "cmake . -GNinja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_INSTALL_LIBEXECDIR=lib -DBUILD_DOCS=OFF -DBUILD_PLUGINS=OFF -DCMAKE_BUILD_TYPE=Release",
      "ninja"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "deepin/dtk6widget.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "url": [
    "https://github.com/linuxdeepin/dtk6widget/archive/refs/tags/6.0.50.tar.gz"
  ]
}
