{
  "name": "perl-deps.perl-specio",
  "version": "0.53",
  "description": "Perl module perl::specio providing build-time or runtime support for other Perl packages.",
  "url": [
    "https://cpan.metacpan.org/authors/id/D/DR/DROLSKY/Specio-0.53.tar.gz"
  ],
  "dependencies": {
    "required": [
      "perl-deps.perl-devel-stacktrace",
      "perl-deps.perl-eval-closure",
      "perl-deps.perl-module-runtime",
      "perl-deps.perl-mro-compat",
      "perl-deps.perl-role-tiny",
      "perl-deps.perl-sub-quote",
      "perl-deps.perl-test-fatal",
      "perl-deps.perl-test-needs",
      "perl-deps.perl-try-tiny"
    ]
  },
  "build": {
    "user": [
      "perl Makefile.PL",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "general/perl-deps.html",
  "category": "perl-dependency",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
