{
  "name": "wingpanel",
  "version": "8.0.4",
  "description": "Pantheon top panel.",
  "category": "desktop-pantheon",
  "url": [
    "https://github.com/elementary/wingpanel/archive/refs/tags/8.0.4.tar.gz"
  ],
  "dependencies": {
    "required": [
      "gala",
      "glib2",
      "granite",
      "gtk3",
      "libgee",
      "mutter46",
      "pantheon-notifications"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr -Dbuildtype=release .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "pantheon/wingpanel.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
