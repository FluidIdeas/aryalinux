{
  "name": "yasm",
  "version": "1.3.0",
  "description": "Yasm is a complete rewrite of the NASM-3.01 assembler. It supports the x86 and AMD64 instruction sets, accepts NASM and GAS assembler syntaxes and outputs binary, ELF32 and ELF64 object formats.",
  "url": "https://www.tortall.net/projects/yasm/releases/yasm-1.3.0.tar.gz",
  "dependencies": {},
  "build": {
    "user": [
      "sed -e 's/def __cplusplus/ defined(__cplusplus) || __STDC_VERSION__ >= 202311L/' \\\n    -i libyasm/bitvect.h",
      "sed -i 's#) ytasm.*#)#' Makefile.in",
      "./configure --prefix=/usr",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "meta": false,
  "book": "general/yasm.html",
  "category": "programming",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
