{
  "name": "libshumate",
  "version": "1.5.3",
  "description": "The libshumate package contains a GTK-4 widget to display maps.",
  "url": "https://download.gnome.org/sources/libshumate/1.5/libshumate-1.5.3.tar.xz",
  "dependencies": {
    "required": [
      "gtk4",
      "glib2"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr          \\\n            --buildtype=release    \\\n            --wrap-mode=nodownload \\\n            -D gtk_doc=false       .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "gnome/libshumate.html",
  "category": "desktop-gnome",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
