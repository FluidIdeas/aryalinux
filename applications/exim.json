{
  "name": "exim",
  "version": "4.99.1",
  "description": "The Exim package contains a Mail Transport Agent written by the University of Cambridge, released under the GNU Public License.",
  "url": "https://ftp.exim.org/pub/exim/exim4/exim-4.99.1.tar.xz",
  "urls": [
    "https://www.linuxfromscratch.org/blfs/downloads/13.0-systemd/blfs-systemd-units-20251204.tar.xz"
  ],
  "dependencies": {
    "required": [
      "libnsl"
    ]
  },
  "build": {
    "user": [
      "sed -e 's,^BIN_DIR.*$,BIN_DIRECTORY=/usr/sbin,'    \\\n    -e 's,^CONF.*$,CONFIGURE_FILE=/etc/exim.conf,' \\\n    -e 's,^EXIM_USER.*$,EXIM_USER=exim,'           \\\n    -e '/# USE_OPENSSL/s,^#,,' src/EDITME > Local/Makefile",
      "printf \"USE_GDBM = yes\\nDBMLIB = -lgdbm\\n\" >> Local/Makefile",
      "sed -i '/# SUPPORT_PAM=yes/s,^#,,' Local/Makefile",
      "echo \"EXTRALIBS=-lpam\" >> Local/Makefile",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR",
      "install -m644 doc/exim.8 $DESTDIR/usr/share/man/man8",
      "install -d -m750 $DESTDIR/var/spool/exim",
      "ln -sf exim $DESTDIR/usr/sbin/sendmail",
      "install -d $DESTDIR/etc/pam.d",
      "install -vdm755 $DESTDIR/etc/pam.d",
      "cat > $DESTDIR/etc/pam.d/exim << \"EOF\"\n# Begin /etc/pam.d/exim\n\nauth    include system-auth\naccount include system-account\nsession include system-session\n\n# End /etc/pam.d/exim\nEOF",
      "tar -xf ../../blfs-systemd-units-20251204.tar.xz -C ../../",
      "cd ../../blfs-systemd-units-20251204 && make install-exim DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [
    "getent group exim >/dev/null || groupadd -g 31 exim",
    "id -u exim >/dev/null 2>&1 || useradd -d /dev/null -c \"Exim Daemon\" -g exim -s /bin/false -u 31 exim",
    "chown -R exim:exim /var/spool/exim",
    "chmod a+wt /var/mail",
    "grep -q '^postmaster:' /etc/aliases 2>/dev/null || cat >> /etc/aliases << \"EOF\"\npostmaster: root\nMAILER-DAEMON: root\nEOF",
    "systemctl enable exim"
  ],
  "meta": false,
  "book": "server/exim.html",
  "category": "server",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
