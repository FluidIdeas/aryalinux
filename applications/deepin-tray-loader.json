{
  "name": "deepin-tray-loader",
  "version": "2.0.33",
  "description": "A set of tray plugins that integrated into task bar and the tool loader which can load the plugins (Deepin Desktop Environment).",
  "category": "desktop-deepin",
  "dependencies": {
    "required": [
      "dconf",
      "deepin-api",
      "deepin-daemon",
      "deepin-qt6platform-plugins",
      "dtk6core",
      "dtk6gui",
      "dtk6widget",
      "kwindowsystem",
      "qt6",
      "wayland",
      "xcb-util",
      "xcb-util-image",
      "xcb-util-wm"
    ]
  },
  "build": {
    "user": [
      "cmake . -GNinja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_INSTALL_LIBEXECDIR=lib -DCMAKE_INSTALL_SYSCONFDIR=/etc ",
      "ninja"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "deepin/deepin-tray-loader.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "url": [
    "https://github.com/linuxdeepin/dde-tray-loader/archive/refs/tags/2.0.33.tar.gz"
  ]
}
