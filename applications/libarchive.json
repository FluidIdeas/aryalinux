{
  "name": "libarchive",
  "version": "3.8.5",
  "description": "The libarchive library provides a single interface for reading/writing various compression formats.",
  "url": [
    "https://github.com/libarchive/libarchive/releases/download/v3.8.5/libarchive-3.8.5.tar.xz"
  ],
  "dependencies": {},
  "build": {
    "user": [
      "./configure --prefix=/usr --disable-static",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR",
      "ln -sfv bsdunzip $DESTDIR/usr/bin/unzip"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "general/libarchive.html",
  "category": "libraries",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
