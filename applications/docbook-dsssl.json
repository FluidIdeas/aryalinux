{
  "name": "docbook-dsssl",
  "version": "1.79",
  "description": "The DocBook DSSSL Stylesheets package contains DSSSL stylesheets. These are used by OpenJade or other tools to transform SGML and XML DocBook files.",
  "url": "https://downloads.sourceforge.net/docbook/docbook-dsssl-1.79.tar.bz2",
  "dependencies": {
    "required": [
      "sgml-common",
      "docbook-3.1-dtd",
      "opensp"
    ]
  },
  "build": {
    "user": [],
    "package": [
      "install -m755 bin/collateindex.pl $DESTDIR/usr/bin",
      "install -m644 bin/collateindex.pl.1 $DESTDIR/usr/share/man/man1",
      "install -d $DESTDIR/usr/share/sgml/docbook/dsssl-stylesheets-1.79 $DESTDIR/etc/sgml",
      "cp -R VERSION assembly common doc eclipse extensions html lib print slides template tools $DESTDIR/usr/share/sgml/docbook/dsssl-stylesheets-1.79/",
      "install-catalog --add $DESTDIR/etc/sgml/dsssl-docbook-stylesheets.cat $DESTDIR/usr/share/sgml/docbook/dsssl-stylesheets-1.79/catalog",
      "install-catalog --add $DESTDIR/etc/sgml/dsssl-docbook-stylesheets.cat $DESTDIR/usr/share/sgml/docbook/dsssl-stylesheets-1.79/common/catalog",
      "install-catalog --add $DESTDIR/etc/sgml/sgml-docbook.cat $DESTDIR/etc/sgml/dsssl-docbook-stylesheets.cat"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "pst/docbook-dsssl.html",
  "category": "printing",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
