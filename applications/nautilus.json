{
  "name": "nautilus",
  "version": "49.3",
  "description": "The Nautilus package contains the GNOME file manager.",
  "url": "https://download.gnome.org/sources/nautilus/49/nautilus-49.3.tar.xz",
  "dependencies": {
    "required": [
      "gexiv2",
      "desktop-file-utils",
      "glib2",
      "gst10-plugins-base",
      "libcloudproviders",
      "localsearch",
      "adwaita-icon-theme",
      "gvfs"
    ]
  },
  "build": {
    "user": [
      "rm -fv /usr/lib/libnautilus-extension.so.4",
      "mkdir build",
      "cd    build",
      "meson setup --prefix=/usr       \\\n            --buildtype=release \\\n            ..",
      "ninja",
      "sed \"/docdir =/s@\\$@ / 'nautilus-49.3'@\" -i ../meson.build",
      "meson configure -D docs=true",
      "ninja",
      "glib-compile-schemas /usr/share/glib-2.0/schemas"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja install"
    ]
  },
  "meta": false,
  "book": "gnome/nautilus.html",
  "category": "desktop-gnome",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
