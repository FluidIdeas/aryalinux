{
  "name": "nautilus",
  "version": "49.3",
  "description": "The Nautilus package contains the GNOME file manager.",
  "url": [
    "https://download.gnome.org/sources/nautilus/49/nautilus-49.3.tar.xz"
  ],
  "dependencies": {
    "required": [
      "desktop-file-utils",
      "gexiv2",
      "glib2",
      "gnome-autoar",
      "gnome-desktop",
      "gst10-plugins-base",
      "libadwaita",
      "libcloudproviders",
      "libportal",
      "libseccomp",
      "tinysparql"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr       \\\n            --buildtype=release \\\n            -D docs=false       \\\n            .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "gnome/nautilus.html",
  "category": "desktop-gnome",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
