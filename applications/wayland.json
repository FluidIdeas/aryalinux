{
  "name": "wayland",
  "version": "1.24.0",
  "description": "Wayland is a project to define a protocol for a compositor to talk to its clients as well as a library implementation of the protocol.",
  "url": [
    "https://gitlab.freedesktop.org/wayland/wayland/-/releases/1.24.0/downloads/wayland-1.24.0.tar.xz"
  ],
  "dependencies": {
    "required": [
      "libxml2"
    ]
  },
  "build": {
    "user": [
      "meson setup build            \\\n      --prefix=/usr       \\\n      --buildtype=release \\\n      -D documentation=false \\\n      ..",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "general/wayland.html",
  "category": "libraries",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
