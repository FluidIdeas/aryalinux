{
  "name": "libfm-extra",
  "version": "1.3.2",
  "description": "The libfm-extra package contains a library and other files required by the menu-cache-gen program in /usr/bin/libexec installed by menu-cache-1.1.1.",
  "url": "https://downloads.sourceforge.net/pcmanfm/libfm-1.3.2.tar.xz",
  "dependencies": {
    "required": [
      "glib2"
    ]
  },
  "build": {
    "user": [
      "./configure --prefix=/usr     \\\n            --sysconfdir=/etc \\\n            --with-extra-only \\\n            --with-gtk=no     \\\n            --disable-static",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "lxqt/libfm-extra.html",
  "category": "desktop-lxqt",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
