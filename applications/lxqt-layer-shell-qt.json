{
  "name": "lxqt-layer-shell-qt",
  "version": "6.6.1",
  "description": "",
  "category": "",
  "dependencies": {
    "required": [
      "extra-cmake-modules",
      "qt6"
    ]
  },
  "build": {
    "user": [
      "cmake -B build -D CMAKE_INSTALL_PREFIX=/usr \\\n      -D CMAKE_BUILD_TYPE=Release  \\\n      -W no-dev .",
      "make -C build"
    ],
    "package": [
      "make -C build install DESTDIR=$DESTDIR"
    ]
  },
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "meta": false,
  "book": "lxqt/lxqt-layer-shell-qt.html",
  "url": [
    "https://download.kde.org/stable/plasma/6.6.1/layer-shell-qt-6.6.1.tar.xz"
  ]
}
