{
  "name": "libXau",
  "version": "1.0.12",
  "description": "",
  "category": "",
  "dependencies": {
    "required": [
      "xorgproto"
    ]
  },
  "build": {
    "environment": {
      "XORG_CONFIG": "--prefix=/usr --sysconfdir=/etc --localstatedir=/var --disable-static"
    },
    "user": [
      "./configure $XORG_CONFIG",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "meta": false,
  "book": "x/libXau.html",
  "url": [
    "https://www.x.org/pub/individual/lib/libXau-1.0.12.tar.xz"
  ]
}
