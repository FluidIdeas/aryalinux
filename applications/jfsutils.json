{
  "name": "jfsutils",
  "version": "1.1.15",
  "description": "The jfsutils package contains administration and debugging tools for the jfs file system.",
  "url": [
    "https://jfs.sourceforge.net/project/pub/jfsutils-1.1.15.tar.gz"
  ],
  "dependencies": {},
  "build": {
    "user": [
      "patch -Np1 -i ../jfsutils-1.1.15-gcc10_fix-1.patch",
      "sed -i \"/unistd.h/a#include <sys/types.h>\"    fscklog/extract.c",
      "sed -i \"/ioctl.h/a#include <sys/sysmacros.h>\" libfs/devices.c",
      "./configure",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "postlfs/jfsutils.html",
  "category": "system",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "additionalUrls": [
    "https://www.linuxfromscratch.org/patches/blfs/13.0/jfsutils-1.1.15-gcc10_fix-1.patch"
  ]
}
