{
  "name": "deepin-launchpad",
  "version": "2.0.39",
  "description": "The \"launcher\" or \"start menu\" component for DDE - next generation (Deepin Desktop Environment).",
  "category": "desktop-deepin",
  "dependencies": {
    "required": [
      "appstream-qt",
      "deepin-application-manager",
      "deepin-shell",
      "dtk6core",
      "dtk6declarative",
      "dtk6gui",
      "glib2",
      "qt6",
      "wayland"
    ]
  },
  "build": {
    "user": [
      "cmake . -GNinja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_INSTALL_LIBEXECDIR=lib -DCMAKE_INSTALL_SYSCONFDIR=/etc ",
      "ninja"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "deepin/deepin-launchpad.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "url": [
    "https://github.com/linuxdeepin/dde-launchpad/archive/refs/tags/2.0.39.tar.gz"
  ]
}
