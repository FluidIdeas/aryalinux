{
  "name": "talloc",
  "version": "2.4.4",
  "description": "Talloc provides a hierarchical, reference counted memory pool system with destructors. It is the core memory allocator used in Samba.",
  "url": [
    "https://www.samba.org/ftp/talloc/talloc-2.4.4.tar.gz"
  ],
  "dependencies": {},
  "build": {
    "user": [
      "./configure --prefix=/usr",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "general/talloc.html",
  "category": "libraries",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
