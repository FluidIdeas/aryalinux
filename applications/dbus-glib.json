{
  "name": "dbus-glib",
  "version": "0.114",
  "description": "The D-Bus GLib package contains GLib interfaces to the D-Bus API.",
  "url": [
    "https://dbus.freedesktop.org/releases/dbus-glib/dbus-glib-0.114.tar.gz"
  ],
  "dependencies": {
    "required": [
      "dbus",
      "glib2"
    ]
  },
  "build": {
    "user": [
      "./configure --prefix=/usr     \\\n            --sysconfdir=/etc \\\n            --disable-static",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "general/dbus-glib.html",
  "category": "libraries",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
