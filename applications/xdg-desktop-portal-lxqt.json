{
  "name": "xdg-desktop-portal-lxqt",
  "version": "1.3.0",
  "description": "",
  "category": "",
  "dependencies": {
    "required": [
      "libfm-qt",
      "lxqt-kwindowsystem",
      "xdg-desktop-portal"
    ]
  },
  "build": {
    "user": [
      "cmake -B build -D CMAKE_INSTALL_PREFIX=/usr \\\n      -D CMAKE_BUILD_TYPE=Release  \\\n      .",
      "make -C build"
    ],
    "package": [
      "make -C build install DESTDIR=$DESTDIR"
    ]
  },
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "meta": false,
  "book": "lxqt/xdg-desktop-portal-lxqt.html",
  "url": [
    "https://github.com/lxqt/xdg-desktop-portal-lxqt/releases/download/1.3.0/xdg-desktop-portal-lxqt-1.3.0.tar.xz"
  ]
}
