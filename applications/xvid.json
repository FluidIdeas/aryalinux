{
  "name": "xvid",
  "version": "1.3.7",
  "description": "XviD is an MPEG-4 compliant video CODEC.",
  "url": "https://downloads.xvid.com/downloads/xvidcore-1.3.7.tar.gz",
  "dependencies": {},
  "build": {
    "user": [
      "sed -i '/typedef int bool;/d' src/encoder.h",
      "cd build/generic",
      "sed -i 's/^LN_S=@LN_S@/& -f -v/' platform.inc.in",
      "./configure --prefix=/usr",
      "make",
      "sed -i '/libdir.*STATIC_LIB/ s/^/#/' Makefile",
      "chmod -v 755 /usr/lib/libxvidcore.so.4.3"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR",
      "install -v -m755 -d $DESTDIR/usr/share/doc/xvidcore-1.3.7/examples",
      "install -v -m644 ../../doc/* $DESTDIR/usr/share/doc/xvidcore-1.3.7",
      "install -v -m644 ../../examples/* \\\n    $DESTDIR/usr/share/doc/xvidcore-1.3.7/examples"
    ]
  },
  "meta": false,
  "book": "multimedia/xvid.html",
  "category": "multimedia",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
