{
  "name": "xvid",
  "version": "1.3.7",
  "description": "XviD is an MPEG-4 compliant video CODEC.",
  "url": [
    "https://downloads.xvid.com/downloads/xvidcore-1.3.7.tar.gz"
  ],
  "dependencies": {},
  "build": {
    "user": [
      "sed -i '/typedef int bool;/d' src/encoder.h",
      "(cd build/generic && sed -i 's/^LN_S=@LN_S@/& -f -v/' platform.inc.in && ./configure --prefix=/usr && make)"
    ],
    "package": [
      "(cd build/generic && sed -i '/libdir.*STATIC_LIB/ s/^/#/' Makefile && make install DESTDIR=$DESTDIR)",
      "chmod -v 755 $DESTDIR/usr/lib/libxvidcore.so.4.3"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "multimedia/xvid.html",
  "category": "multimedia",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
