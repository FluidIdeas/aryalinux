{
  "name": "zvbi",
  "version": "0.2.35",
  "description": "ZVBI is a library for capturing and decoding VBI data such as teletext.",
  "category": "multimedia",
  "dependencies": {
    "required": [
      "alsa-lib",
      "desktop-file-utils",
      "ffmpeg",
      "installing",
      "liba52",
      "libgcrypt",
      "libmad",
      "lua",
      "qt6"
    ]
  },
  "build": {
    "user": [
      "./configure --prefix=/usr \\\n            --disable-static",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "meta": false,
  "book": "multimedia/vlc.html",
  "url": [
    "http://downloads.sourceforge.net/project/zapping/zvbi/0.2.35/zvbi-0.2.35.tar.bz2"
  ],
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
