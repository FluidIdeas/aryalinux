{
  "name": "xdg-desktop-portal",
  "version": "1.20.3",
  "description": "",
  "category": "",
  "dependencies": {
    "required": [
      "dbus",
      "fuse",
      "gdk-pixbuf",
      "json-glib",
      "pipewire"
    ],
    "recommended": [
      "bubblewrap"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr --buildtype=release -D tests=disabled .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "meta": false,
  "book": "x/xdg-desktop-portal.html",
  "url": [
    "https://github.com/flatpak/xdg-desktop-portal/releases/download/1.20.3/xdg-desktop-portal-1.20.3.tar.xz"
  ]
}
