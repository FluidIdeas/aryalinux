{
  "name": "gnome-gutenprint",
  "version": "5.3.5",
  "description": "Gutenprint drivers for the GNOME CUPS stack. Do not install alongside kde-gutenprint.",
  "category": "printing",
  "url": [
    "https://downloads.sourceforge.net/gimp-print/gutenprint-5.3.5.tar.xz"
  ],
  "dependencies": {
    "required": [
      "gnome-cups"
    ]
  },
  "build": {
    "user": [
      "sed -i 's|$(PACKAGE)/doc|doc/$(PACKAGE)-$(VERSION)|' \\\n       {,doc/,doc/developer/}Makefile.in",
      "./configure --prefix=/usr    \\\n            --disable-static \\\n            --without-gimp2  \\\n            --without-gimp2-as-gutenprint",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [
    "systemctl restart cups"
  ],
  "meta": false,
  "book": "pst/gutenprint.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
