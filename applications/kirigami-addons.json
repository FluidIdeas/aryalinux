{
  "name": "kirigami-addons",
  "version": "1.10.0",
  "description": "",
  "category": "",
  "dependencies": {
    "required": [
      "frameworks6",
      "vulkan-loader"
    ]
  },
  "build": {
    "user": [
      "cmake -B build -D CMAKE_INSTALL_PREFIX=$KF6_PREFIX \\\n      -D CMAKE_BUILD_TYPE=Release         \\\n      -D BUILD_TESTING=OFF                \\\n       .",
      "make -C build"
    ],
    "package": [
      "make -C build install DESTDIR=$DESTDIR"
    ],
    "environment": {
      "KF6_PREFIX": "/usr"
    }
  },
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "meta": false,
  "book": "kde/kirigami-addons.html",
  "url": [
    "https://download.kde.org/stable/kirigami-addons/kirigami-addons-1.10.0.tar.xz"
  ]
}
