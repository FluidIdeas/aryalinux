{
  "name": "deepin-api",
  "version": "6.0.43",
  "description": "Dbus interfaces for miscellaneous desktop services (Deepin Desktop Environment).",
  "category": "desktop-deepin",
  "dependencies": {
    "required": [
      "alsa-lib",
      "alsa-utils",
      "blur-effect",
      "cairo",
      "deepin-application-manager",
      "fontconfig",
      "freetype2",
      "gdk-pixbuf",
      "glib2",
      "gtk3",
      "libcanberra",
      "libgudev",
      "librsvg",
      "pulseaudio",
      "xcur2png"
    ]
  },
  "build": {
    "environment": {
      "CGO_CPPFLAGS": "$CPPFLAGS",
      "CGO_CFLAGS": "$CFLAGS",
      "CGO_CXXFLAGS": "$CXXFLAGS",
      "CGO_LDFLAGS": "$LDFLAGS",
      "GOFLAGS": "-buildmode=pie -trimpath -mod=readonly -modcacherw"
    },
    "user": [
      "sed -i 's|/etc/os-version|/etc/uos-version|' adjust-grub-theme/main.go",
      "make"
    ],
    "package": [
      "make DESTDIR=$DESTDIR install",
      "make DESTDIR=$DESTDIR SYSTEMD_LIB_DIR=/usr/lib install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "deepin/deepin-api.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "url": [
    "https://github.com/linuxdeepin/dde-api/archive/refs/tags/6.0.43.tar.gz"
  ]
}
