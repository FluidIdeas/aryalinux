{
  "name": "xorgproto",
  "version": "2025.1",
  "description": "The xorgproto package provides the header files required to build the X Window system, and to allow other applications to build against the installed X Window system.",
  "url": [
    "https://xorg.freedesktop.org/archive/individual/proto/xorgproto-2025.1.tar.xz"
  ],
  "dependencies": {
    "required": [
      "util-macros"
    ]
  },
  "build": {
    "environment": {
      "XORG_PREFIX": "/usr"
    },
    "user": [
      "meson setup build --prefix=$XORG_PREFIX .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install",
      "mv -v $DESTDIR$XORG_PREFIX/share/doc/xorgproto{,-2025.1}"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "x/xorgproto.html",
  "category": "x11",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
