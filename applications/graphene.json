{
  "name": "graphene",
  "version": "1.10.8",
  "description": "The Graphene package provides a thin layer of types for graphics libraries.",
  "url": "https://download.gnome.org/sources/graphene/1.10/graphene-1.10.8.tar.xz",
  "dependencies": {
    "required": [
      "glib2"
    ]
  },
  "build": {
    "user": [
      "mkdir build",
      "cd    build",
      "meson setup --prefix=/usr --buildtype=release ..",
      "ninja"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja install"
    ]
  },
  "meta": false,
  "book": "x/graphene.html",
  "category": "x11",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
