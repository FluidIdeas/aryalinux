{
  "name": "phonon",
  "version": "4.12.0",
  "description": "Phonon is the multimedia API for KDE. It replaces the old aRts package. Phonon needs the VLC backend.",
  "url": "https://download.kde.org/stable/phonon/4.12.0/phonon-4.12.0.tar.xz",
  "dependencies": {
    "required": [
      "cmake",
      "glib2"
    ],
    "post": [
      "phonon-backend-vlc"
    ]
  },
  "build": {
    "user": [
      "mkdir build",
      "cd    build",
      "cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n      -D CMAKE_BUILD_TYPE=Release  \\\n      -D PHONON_BUILD_QT5=OFF      \\\n      -W no-dev ..",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "meta": false,
  "book": "kde/phonon.html",
  "category": "desktop-kde",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
