{
  "name": "pantheon-print",
  "version": "0.1.3",
  "description": "Pantheon print dialog.",
  "category": "desktop-pantheon",
  "url": [
    "https://github.com/elementary/pantheon-print/archive/refs/tags/0.1.3.tar.gz"
  ],
  "dependencies": {
    "required": [
      "cairo",
      "contractor",
      "glib2",
      "gtk3",
      "pango"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr -Dbuildtype=release  .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "pantheon/pantheon-print.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
