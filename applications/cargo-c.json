{
  "name": "cargo-c",
  "version": "0.10.20",
  "description": "",
  "category": "",
  "dependencies": {
    "required": [
      "libssh2",
      "rust"
    ]
  },
  "build": {
    "user": [
      "curl -fLO https://github.com/lu-zero/cargo-c/releases/download/v0.10.20/Cargo.lock",
      "export LIBSSH2_SYS_USE_PKG_CONFIG=1",
      "export LIBSQLITE3_SYS_USE_PKG_CONFIG=1",
      "cargo build --release",
      "unset LIB{SSH2,SQLITE3}_SYS_USE_PKG_CONFIG"
    ],
    "package": [
      "install -vdm755 $DESTDIR/usr/bin",
      "install -vm755 target/release/cargo-{capi,cbuild,cinstall,ctest} $DESTDIR/usr/bin/"
    ]
  },
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "meta": false,
  "book": "general/cargo-c.html",
  "url": [
    "https://github.com/lu-zero/cargo-c/archive/v0.10.20/cargo-c-0.10.20.tar.gz"
  ]
}
