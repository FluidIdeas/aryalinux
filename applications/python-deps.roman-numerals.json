{
  "name": "python-deps.roman-numerals",
  "version": "4.1.0",
  "description": "Python package roman-numerals required as a dependency of other Python modules.",
  "url": [
    "https://files.pythonhosted.org/packages/source/r/roman-numerals/roman_numerals-4.1.0.tar.gz"
  ],
  "dependencies": {},
  "build": {
    "user": [
      "pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD"
    ],
    "package": [
      "pip3 install --root=$DESTDIR --no-index --find-links dist --no-user roman-numerals"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "general/python-dependencies.html",
  "category": "python-dependency",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
