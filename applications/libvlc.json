{
  "name": "libvlc",
  "version": "3.0.23",
  "description": "libvlc provides the VLC media engine libraries and plugins needed by applications such as Phonon, without the VLC player UI or Qt front end.",
  "url": [
    "https://download.videolan.org/vlc/3.0.23/vlc-3.0.23.tar.xz"
  ],
  "dependencies": {
    "required": [
      "alsa-lib",
      "ffmpeg"
    ]
  },
  "build": {
    "user": [
      "sed -i 's/gstvideopool.h/video.h/' modules/codec/gstreamer/gstvlcvideopool.h",
      "BUILDCC=gcc ./configure --prefix=/usr            \\\n            --disable-libplacebo       \\\n            --disable-qt                 \\\n            --disable-lua                \\\n            --disable-ncurses            \\\n            --disable-skins2             \\\n            --disable-update-check       \\\n            --disable-taglib             \\\n            --disable-v4l2               \\\n            --disable-vcd                \\\n            --disable-jack               \\\n            --disable-sndio",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR",
      "rm -f $DESTDIR/usr/bin/vlc            \\\n   $DESTDIR/usr/bin/cvlc           \\\n   $DESTDIR/usr/bin/nvlc           \\\n   $DESTDIR/usr/bin/rvlc           \\\n   $DESTDIR/usr/bin/svlc           \\\n   $DESTDIR/usr/bin/vlc-wrapper",
      "rm -rf $DESTDIR/usr/share/applications \\\n        $DESTDIR/usr/share/icons/hicolor \\\n        $DESTDIR/usr/share/kde4          \\\n        $DESTDIR/usr/share/doc/vlc-*"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "multimedia/libvlc.html",
  "category": "multimedia",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
