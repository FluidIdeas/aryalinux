{
  "name": "gdm",
  "version": "49.2",
  "description": "GDM is a system service that is responsible for providing graphical logins and managing local and remote displays.",
  "url": [
    "https://download.gnome.org/sources/gdm/49/gdm-49.2.tar.xz"
  ],
  "dependencies": {
    "required": [
      "accountsservice",
      "dconf",
      "gtk3",
      "libcanberra",
      "linux-pam"
    ],
    "runtime": [
      "gnome-session",
      "gnome-shell",
      "systemd"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr        \\\n      --buildtype=release  \\\n      -D gdm-xsession=true \\\n      -D run-dir=/run/gdm .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install",
      "install -d $DESTDIR/etc/gdm",
      "if grep -q '^#WaylandEnable=false' $DESTDIR/etc/gdm/custom.conf; then\n  sed -i 's/^#WaylandEnable=false/WaylandEnable=false/' $DESTDIR/etc/gdm/custom.conf\nfi"
    ]
  },
  "post_install": [
    "getent group gdm >/dev/null || groupadd -g 21 gdm",
    "id -u gdm >/dev/null 2>&1 || useradd -c \"GDM Daemon Owner\" -d /var/lib/gdm -u 21 -g gdm -s /bin/false gdm",
    "passwd -ql gdm",
    "systemctl enable gdm",
    "systemctl set-default graphical.target"
  ],
  "meta": false,
  "book": "x/gdm.html",
  "category": "x11",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
