{
  "name": "qps",
  "version": "2.12.0",
  "description": "",
  "category": "",
  "dependencies": {
    "required": [
      "liblxqt"
    ]
  },
  "build": {
    "user": [
      "cmake -B build -D CMAKE_BUILD_TYPE=Release  \\\n      -D CMAKE_INSTALL_PREFIX=/usr \\\n      .",
      "make -C build"
    ],
    "package": [
      "make -C build install DESTDIR=$DESTDIR"
    ]
  },
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "meta": false,
  "book": "lxqt/qps.html",
  "url": [
    "https://github.com/lxqt/qps/releases/download/2.12.0/qps-2.12.0.tar.xz"
  ]
}
