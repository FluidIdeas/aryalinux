{
  "name": "dconf-editor",
  "version": "49.0",
  "description": "Graphical editor for dconf/GSettings keys.",
  "category": "desktop-gnome",
  "url": [
    "https://download.gnome.org/sources/dconf-editor/49/dconf-editor-49.0.tar.xz"
  ],
  "dependencies": {
    "required": [
      "dconf",
      "gtk3",
      "libhandy1",
      "libxml2",
      "vala"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr --buildtype=release .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "gnome/dconf.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
