{
  "name": "python-deps.pyproject-hooks",
  "version": "1.2.0",
  "description": "Python package pyproject-hooks required as a dependency of other Python modules.",
  "url": [
    "https://files.pythonhosted.org/packages/source/p/pyproject-hooks/pyproject_hooks-1.2.0.tar.gz"
  ],
  "dependencies": {},
  "build": {
    "user": [
      "pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD"
    ],
    "package": [
      "pip3 install --root=$DESTDIR --no-index --find-links dist --no-user pyproject_hooks"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "general/python-dependencies.html",
  "category": "python-dependency",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
