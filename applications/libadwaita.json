{
  "name": "libadwaita",
  "version": "1.8.4",
  "description": "The libadwaita package provides additional GTK4 UI widgets for use in developing user interfaces. It is used primarily for GNOME applications.",
  "url": [
    "https://download.gnome.org/sources/libadwaita/1.8/libadwaita-1.8.4.tar.xz"
  ],
  "dependencies": {
    "required": [
      "appstream",
      "gtk4",
      "sassc",
      "vala"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr --buildtype=release \\\n      -D documentation=disabled .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "x/libadwaita.html",
  "category": "x11",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
