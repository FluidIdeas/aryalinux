{
  "name": "glibmm2",
  "version": "2.86.0",
  "description": "",
  "category": "",
  "dependencies": {
    "required": [
      "glib2",
      "libsigc3"
    ]
  },
  "build": {
    "user": [
      "meson setup bld --prefix=/usr --buildtype=release .",
      "ninja -C bld"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C bld install"
    ]
  },
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "meta": false,
  "book": "general/glibmm2.html",
  "url": [
    "https://download.gnome.org/sources/glibmm/2.86/glibmm-2.86.0.tar.xz"
  ]
}
