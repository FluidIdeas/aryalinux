{
  "name": "gnome-autoar",
  "version": "0.4.5",
  "description": "The gnome-autoar package provides a framework for automatic archive extraction, compression, and management.",
  "url": [
    "https://download.gnome.org/sources/gnome-autoar/0.4/gnome-autoar-0.4.5.tar.xz"
  ],
  "dependencies": {
    "required": [
      "libarchive",
      "vala"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr       \\\n            --buildtype=release \\\n            -D vapi=true        \\\n            -D tests=true       \\\n            .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "gnome/gnome-autoar.html",
  "category": "desktop-gnome",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
