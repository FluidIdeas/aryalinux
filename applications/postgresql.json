{
  "name": "postgresql",
  "version": "18.2",
  "description": "PostgreSQL is an advanced object-relational database management system (ORDBMS), derived from the Berkeley Postgres database management system.",
  "url": [
    "https://ftp.postgresql.org/pub/source/v18.2/postgresql-18.2.tar.bz2"
  ],
  "dependencies": {},
  "build": {
    "user": [
      "sed -e '/DEFAULT_PGSOCKET_DIR/s@/tmp@/run/postgresql@' \\\n    -i src/include/pg_config_manual.h",
      "./configure --prefix=/usr",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR",
      "tar -xf ../../blfs-systemd-units-20251204.tar.xz -C ../../",
      "cd ../../blfs-systemd-units-20251204 && make install-postgresql DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [
    "getent group postgres >/dev/null || groupadd -g 41 postgres",
    "id -u postgres >/dev/null 2>&1 || useradd -c \"PostgreSQL Server\" -g postgres -d /srv/pgsql/data -u 41 postgres",
    "install -v -dm700 /srv/pgsql/data",
    "install -v -dm755 /run/postgresql",
    "chown -Rv postgres:postgres /srv/pgsql /run/postgresql",
    "su - postgres -c '/usr/bin/initdb -D /srv/pgsql/data'",
    "systemctl enable postgresql"
  ],
  "meta": false,
  "book": "server/postgresql.html",
  "category": "server",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "additionalUrls": [
    "https://www.linuxfromscratch.org/blfs/downloads/13.0-systemd/blfs-systemd-units-20251204.tar.xz"
  ]
}
