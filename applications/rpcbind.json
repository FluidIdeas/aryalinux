{
  "name": "rpcbind",
  "version": "1.2.8",
  "description": "The rpcbind program is a replacement for portmap. It is required for import or export of Network File System (NFS) shared directories.",
  "url": "https://downloads.sourceforge.net/rpcbind/rpcbind-1.2.8.tar.bz2",
  "dependencies": {
    "required": [
      "libtirpc"
    ]
  },
  "build": {
    "user": [
      "sed -i \"/servname/s:rpcbind:sunrpc:\" src/rpcbind.c",
      "./configure --prefix=/usr       \\\n            --bindir=/usr/sbin  \\\n            --enable-warmstarts \\\n            --with-rpcuser=rpc",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR",
      "echo 'RPCBIND_OPTIONS=\"\"' > $DESTDIR/etc/rpcbind.conf"
    ]
  },
  "post_install": [
    "getent group rpc >/dev/null || groupadd -g 28 rpc",
    "id -u rpc >/dev/null 2>&1 || useradd -c \"RPC Bind Daemon Owner\" -d /dev/null -g rpc \\\n        -s /bin/false -u 28 rpc",
    "systemctl enable rpcbind"
  ],
  "meta": false,
  "book": "basicnet/rpcbind.html",
  "category": "networking",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
