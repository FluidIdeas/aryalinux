{
  "name": "konsole",
  "version": "25.12.2",
  "description": "",
  "category": "",
  "dependencies": {
    "required": [
      "frameworks6"
    ]
  },
  "build": {
    "user": [
      "patch -Np1 -i ../konsole-adjust_scrollbar-1.patch",
      "cmake -B build -D CMAKE_INSTALL_PREFIX=$KF6_PREFIX \\\n      -D CMAKE_BUILD_TYPE=Release         \\\n      -D BUILD_TESTING=OFF                \\\n      -W no-dev .",
      "make -C build"
    ],
    "package": [
      "make -C build install DESTDIR=$DESTDIR"
    ],
    "environment": {
      "KF6_PREFIX": "/usr"
    }
  },
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "meta": false,
  "book": "kde/konsole.html",
  "url": [
    "https://download.kde.org/stable/release-service/25.12.2/src/konsole-25.12.2.tar.xz"
  ],
  "additionalUrls": [
    "https://www.linuxfromscratch.org/patches/blfs/13.0/konsole-adjust_scrollbar-1.patch"
  ]
}
