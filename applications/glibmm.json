{
  "name": "glibmm",
  "version": "2.66.8",
  "description": "The GLibmm package is a set of C++ bindings for GLib.",
  "url": [
    "https://download.gnome.org/sources/glibmm/2.66/glibmm-2.66.8.tar.xz"
  ],
  "dependencies": {
    "required": [
      "glib2",
      "libsigc"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr --buildtype=release .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "general/glibmm.html",
  "category": "libraries",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
