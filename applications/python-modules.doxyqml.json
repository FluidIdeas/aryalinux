{
  "name": "python-modules.doxyqml",
  "version": "0.5.3",
  "description": "The Doxyqml package allows using Doxygen to document QML classes.",
  "url": [
    "https://files.pythonhosted.org/packages/source/d/doxyqml/doxyqml-0.5.3.tar.gz"
  ],
  "dependencies": {
    "required": [
      "doxygen"
    ]
  },
  "build": {
    "user": [
      "pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD"
    ],
    "package": [
      "pip3 install --root=$DESTDIR --no-index --find-links dist --no-user doxyqml"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "general/python-modules.html",
  "category": "python-module",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
