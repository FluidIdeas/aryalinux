{
  "name": "perl-modules.perl-lwp-protocol-https",
  "version": "6.14",
  "description": "Perl module perl::lwp::protocol::https used by applications and other Perl packages on the system.",
  "url": [
    "https://www.cpan.org/authors/id/O/OA/OALDERS/LWP-Protocol-https-6.14.tar.gz"
  ],
  "dependencies": {
    "required": [
      "perl-modules.perl-io-socket-ssl",
      "perl-modules.perl-libwww-perl",
      "make-ca"
    ]
  },
  "build": {
    "user": [
      "perl Makefile.PL",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "general/perl-modules.html",
  "category": "perl-module",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
