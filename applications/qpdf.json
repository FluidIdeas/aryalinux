{
  "name": "qpdf",
  "version": "12.3.2",
  "description": "The Qpdf package contains command-line programs and a library that does structural, content-preserving transformations on PDF files.",
  "url": "https://github.com/qpdf/qpdf/releases/download/v12.3.2/qpdf-12.3.2.tar.gz",
  "dependencies": {
    "required": [
      "libjpeg"
    ]
  },
  "build": {
    "user": [
      "cmake -B build -D CMAKE_INSTALL_PREFIX=/usr \\\n      -D CMAKE_BUILD_TYPE=Release  \\\n      -D BUILD_STATIC_LIBS=OFF     \\\n      ..",
      "make -C build"
    ],
    "package": [
      "make -C build install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "general/qpdf.html",
  "category": "graphics",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
