{
  "name": "libkeybinder3",
  "version": "0.3.2",
  "description": "Global keyboard shortcut library for Cinnamon.",
  "category": "libraries",
  "url": [
    "https://github.com/kupferlauncher/keybinder/releases/download/keybinder-3.0-v0.3.2/keybinder-3.0-0.3.2.tar.gz"
  ],
  "dependencies": {
    "required": [
      "gtk3"
    ]
  },
  "build": {
    "user": [
      "cd keybinder-3.0-0.3.2 && ./configure --prefix=/usr && make"
    ],
    "package": [
      "make DESTDIR=$DESTDIR -C keybinder-3.0-0.3.2 install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "cinnamon/libkeybinder3.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
