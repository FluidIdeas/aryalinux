{
  "name": "gucharmap",
  "version": "17.0.1",
  "description": "Gucharmap is a Unicode character map and font viewer. It allows you to browse through all the available Unicode characters and categories for the installed fonts, and to examine their detailed properties. It is an easy way to find the character you might only know by its Unicode name or code point.",
  "url": [
    "https://gitlab.gnome.org/GNOME/gucharmap/-/archive/17.0.1/gucharmap-17.0.1.tar.bz2"
  ],
  "dependencies": {
    "required": [
      "desktop-file-utils",
      "glib2",
      "gsettings-desktop-schemas",
      "gtk3",
      "itstool",
      "libarchive",
      "vala"
    ]
  },
  "build": {
    "user": [
      "(mkdir -p build/ucd && cd build/ucd && unzip -o ../../../UCD.zip && cp -v ../../../Unihan.zip .)",
      "meson setup build --prefix=/usr --strip --buildtype=release -D ucd_path=./ucd -D docs=false .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install",
      "rm -fv $DESTDIR/usr/share/glib-2.0/schemas/org.gnome.Charmap.enums.xml"
    ]
  },
  "post_install": [
    "glib-compile-schemas /usr/share/glib-2.0/schemas"
  ],
  "meta": false,
  "book": "gnome/gucharmap.html",
  "category": "desktop-gnome",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "additionalUrls": [
    "https://www.unicode.org/Public/17.0.0/ucd/UCD.zip",
    "https://www.unicode.org/Public/17.0.0/ucd/Unihan.zip"
  ]
}
