{
  "name": "perl-deps.perl-exception-class",
  "version": "1.45",
  "description": "Perl module perl::exception::class providing build-time or runtime support for other Perl packages.",
  "url": "https://cpan.metacpan.org/authors/id/D/DR/DROLSKY/Exception-Class-1.45.tar.gz",
  "dependencies": {
    "required": [
      "perl-deps.perl-class-data-inheritable",
      "perl-deps.perl-devel-stacktrace"
    ]
  },
  "build": {
    "user": [
      "perl Makefile.PL",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "general/perl-deps.html",
  "category": "perl-dependency",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
