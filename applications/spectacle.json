{
  "name": "spectacle",
  "version": "6.6.1",
  "description": "KDE Plasma component spectacle.",
  "category": "desktop-kde",
  "url": [
    "https://download.kde.org/stable/plasma/6.6.1/spectacle-6.6.1.tar.xz"
  ],
  "dependencies": {
    "required": [
      "opencv",
      "oxygen",
      "prison",
      "zxing-cpp"
    ]
  },
  "build": {
    "environment": {
      "KF6_PREFIX": "/usr",
      "QT6DIR": "/opt/qt6"
    },
    "user": [
      "cmake -B build -D CMAKE_INSTALL_PREFIX=$KF6_PREFIX \\\n      -D CMAKE_PREFIX_PATH=$QT6DIR        \\\n      -D CMAKE_INSTALL_LIBEXECDIR=libexec \\\n      -D CMAKE_BUILD_TYPE=Release \\\n      -D BUILD_QT5=OFF \\\n      -D BUILD_TESTING=OFF \\\n      -W no-dev .",
      "make -C build"
    ],
    "package": [
      "make -C build install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "kde/plasma-all.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
