{
  "name": "cinnamon-session",
  "version": "6.6.3",
  "description": "Cinnamon session manager.",
  "category": "desktop-cinnamon",
  "url": [
    "https://github.com/linuxmint/cinnamon-session/archive/refs/tags/6.6.3.tar.gz"
  ],
  "dependencies": {
    "required": [
      "cinnamon-desktop",
      "dconf",
      "glib2",
      "gtk3",
      "hicolor-icon-theme",
      "libcanberra",
      "python-modules.pygobject3",
      "python3",
      "systemd",
      "xapp"
    ],
    "optional": [
      "cinnamon-translations"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr --libexecdir=lib/cinnamon-session -Dbuildtype=release .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "cinnamon/cinnamon-session.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
