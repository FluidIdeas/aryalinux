{
  "name": "python-modules.sphinx",
  "version": "9.1.0",
  "description": "The Sphinx package is a set of tools for translating some structured text formats into pretty documentation in various formats.",
  "url": [
    "https://files.pythonhosted.org/packages/source/s/sphinx/sphinx-9.1.0.tar.gz"
  ],
  "dependencies": {
    "required": [
      "python-dependencies",
      "python-modules.docutils",
      "python-modules.pygments",
      "python-modules.requests"
    ]
  },
  "build": {
    "user": [
      "pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD"
    ],
    "package": [
      "pip3 install --root=$DESTDIR --no-index --find-links dist --no-user sphinx"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "general/python-modules.html",
  "category": "python-module",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
