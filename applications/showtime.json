{
  "name": "showtime",
  "version": "49.1",
  "description": "",
  "category": "",
  "dependencies": {
    "required": [
      "gst10-plugins-base",
      "libadwaita"
    ]
  },
  "build": {
    "user": [
      "mkdir build",
      "cd    build",
      "meson setup --prefix=/usr       \\\n            --buildtype=release \\\n            ..",
      "ninja"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja install"
    ]
  },
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "meta": false,
  "book": "gnome/showtime.html",
  "url": [
    "https://download.gnome.org/sources/showtime/49/showtime-49.1.tar.xz"
  ]
}
