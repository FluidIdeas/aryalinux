{
  "name": "deepin-printer",
  "version": "0.9.21",
  "description": "Printer configuration project for DDE (Deepin Desktop Environment).",
  "category": "desktop-deepin",
  "dependencies": {
    "required": [
      "gnome-cups",
      "gnome-cups-filters",
      "dtkcore",
      "dtkgui",
      "dtkwidget",
      "hicolor-icon-theme",
      "libusb",
      "qt5-base",
      "samba",
      "xdg-utils"
    ]
  },
  "build": {
    "user": [
      "make"
    ],
    "package": [
      "make DESTDIR=$DESTDIR install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "deepin/deepin-printer.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "url": [
    "https://github.com/linuxdeepin/deepin-printer/archive/refs/tags/0.9.21.tar.gz"
  ]
}
