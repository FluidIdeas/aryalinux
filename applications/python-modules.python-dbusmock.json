{
  "name": "python-modules.python-dbusmock",
  "version": "0.38.1",
  "description": "Python module python-dbusmock for scripts and applications that depend on it.",
  "url": [
    "https://files.pythonhosted.org/packages/source/p/python-dbusmock/python_dbusmock-0.38.1.tar.gz"
  ],
  "dependencies": {
    "required": [
      "python-modules.dbus-python"
    ]
  },
  "build": {
    "user": [
      "pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD"
    ],
    "package": [
      "pip3 install --root=$DESTDIR --no-index --find-links dist --no-user python-dbusmock"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "general/python-modules.html",
  "category": "python-module",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
