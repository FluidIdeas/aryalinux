{
  "name": "glslc",
  "version": "2026.1",
  "description": "",
  "category": "",
  "dependencies": {
    "required": [
      "cmake",
      "glslang",
      "spirv-tools"
    ]
  },
  "build": {
    "user": [
      "sed '/build-version/d'   -i glslc/CMakeLists.txt",
      "sed '/third_party/d'     -i CMakeLists.txt",
      "sed 's|SPIRV|glslang/&|' -i libshaderc_util/src/compiler.cc",
      "echo '\"2026.1\"' > glslc/src/build-version.inc",
      "cmake -B build -D CMAKE_INSTALL_PREFIX=/usr \\\n      -D CMAKE_BUILD_TYPE=Release  \\\n      -D SHADERC_SKIP_TESTS=ON     \\\n      -G Ninja .",
      "ninja -C build glslc/glslc"
    ],
    "package": [
      "install -Dm755 build/glslc/glslc $DESTDIR/usr/bin/glslc"
    ]
  },
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "meta": false,
  "book": "general/glslc.html",
  "url": [
    "https://github.com/google/shaderc/archive/v2026.1/shaderc-2026.1.tar.gz"
  ]
}
