{
  "name": "pantheon-sideload",
  "version": "6.3.1",
  "description": "Pantheon Flatpak sideload helper.",
  "category": "applications",
  "url": [
    "https://github.com/elementary/sideload/archive/refs/tags/6.3.1.tar.gz"
  ],
  "dependencies": {
    "required": [
      "flatpak",
      "glib2",
      "granite7",
      "gtk4"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr -Dbuildtype=release  .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "pantheon/pantheon-sideload.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
