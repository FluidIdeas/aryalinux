{
  "name": "libdvdcss",
  "version": "1.5.0",
  "description": "libdvdcss is a simple library designed for accessing DVDs as a block device without having to bother about the decryption.",
  "url": "https://get.videolan.org/libdvdcss/1.5.0/libdvdcss-1.5.0.tar.xz",
  "dependencies": {},
  "build": {
    "user": [
      "meson setup build --prefix=/usr --buildtype=release .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install",
      "rm -fv $DESTDIR/usr/lib/libdvdcss.a"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "multimedia/libdvdcss.html",
  "category": "multimedia",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
