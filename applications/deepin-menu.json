{
  "name": "deepin-menu",
  "version": "5.0.1",
  "description": "Deepin menu service for building beautiful menus (Deepin Desktop Environment).",
  "category": "desktop-deepin",
  "dependencies": {
    "required": [
      "deepin-qt5integration"
    ]
  },
  "build": {
    "user": [
      "make"
    ],
    "package": [
      "make DESTDIR=$DESTDIR install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "deepin/deepin-menu.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "url": [
    "https://github.com/linuxdeepin/dde-menu/archive/refs/tags/5.0.1.tar.gz"
  ]
}
