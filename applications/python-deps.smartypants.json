{
  "name": "python-deps.smartypants",
  "version": "2.0.2",
  "description": "Python package smartypants required as a dependency of other Python modules.",
  "url": [
    "https://files.pythonhosted.org/packages/source/s/smartypants/smartypants-2.0.2.tar.gz"
  ],
  "dependencies": {},
  "build": {
    "user": [
      "pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD"
    ],
    "package": [
      "pip3 install --root=$DESTDIR --no-index --find-links dist --no-user smartypants"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "general/python-dependencies.html",
  "category": "python-dependency",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
