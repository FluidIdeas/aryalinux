{
  "name": "power-profiles-daemon",
  "version": "0.30",
  "description": "",
  "category": "",
  "dependencies": {
    "required": [
      "polkit",
      "python-modules.pygobject3",
      "upower"
    ]
  },
  "build": {
    "user": [
      "meson setup build                \\\n      --prefix=/usr        \\\n      --buildtype=release  \\\n      -D gtk_doc=false     \\\n      -D tests=false       \\\n      .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [
    "systemctl enable power-profiles-daemon"
  ],
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "meta": false,
  "book": "general/power-profiles-daemon.html",
  "url": [
    "https://gitlab.freedesktop.org/upower/power-profiles-daemon/-/archive/0.30/power-profiles-daemon-0.30.tar.gz"
  ]
}
