{
  "name": "wdisplays",
  "version": "1.1.3",
  "description": "GUI display settings utility for wlroots compositors.",
  "category": "applications",
  "url": [
    "https://github.com/artizirk/wdisplays/archive/refs/tags/1.1.3.tar.gz"
  ],
  "dependencies": {
    "required": [
      "cairo",
      "glib2",
      "gtk3",
      "hicolor-icon-theme",
      "libepoxy",
      "pango",
      "wayland",
      "wayland-protocols"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr -Dbuildtype=release .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "budgie/wdisplays.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
