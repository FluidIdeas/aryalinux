{
  "name": "perl-modules.perl-test-differences",
  "version": "0.72",
  "description": "Perl module perl::test::differences used by applications and other Perl packages on the system.",
  "url": "https://www.cpan.org/authors/id/D/DC/DCANTRELL/Test-Differences-0.72.tar.gz",
  "dependencies": {
    "required": [
      "perl-deps.perl-text-diff",
      "perl-deps.perl-capture-tiny"
    ]
  },
  "build": {
    "user": [
      "perl Makefile.PL",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "meta": false,
  "book": "general/perl-modules.html",
  "category": "perl-module",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
