{
  "name": "deepin-session-shell",
  "version": "6.0.26",
  "description": "Deepin desktop-environment - session-shell module (Deepin Desktop Environment).",
  "category": "desktop-deepin",
  "dependencies": {
    "required": [
      "dconf",
      "deepin-daemon",
      "deepin-network-core",
      "deepin-pw-check",
      "deepin-qt5integration",
      "deepin-session",
      "deepin-wallpapers",
      "dtkcore",
      "dtkgui",
      "dtkwidget",
      "gsettings-qt6",
      "kwayland",
      "liblightdm-qt5",
      "lightdm",
      "linux-pam",
      "qt5-base",
      "qt5-svg",
      "qt5-tools",
      "qt5-x11extras",
      "startdde"
    ]
  },
  "build": {
    "user": [
      "cmake . -GNinja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_INSTALL_LIBEXECDIR=lib -DCMAKE_INSTALL_SYSCONFDIR=/etc ",
      "ninja"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "deepin/deepin-session-shell.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "url": [
    "https://github.com/linuxdeepin/dde-session-shell/archive/refs/tags/6.0.26.tar.gz"
  ]
}
