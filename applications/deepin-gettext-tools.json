{
  "name": "deepin-gettext-tools",
  "version": "1.0.11",
  "description": "Deepin Gettext Tools (Deepin Desktop Environment).",
  "category": "desktop-deepin",
  "dependencies": {
    "required": [
      "perl-modules.perl-xml-libxml",
      "python3"
    ]
  },
  "build": {
    "user": [
      "sed -e 's/sudo cp/cp/' -i deepin-gettext-tools-1.0.11/src/generate_mo.py",
      "sed -e 's/qmake/qmake-qt5/' -e '/lupdate/d' -i deepin-gettext-tools-1.0.11/Makefile"
    ],
    "package": [
      "make DESTDIR=$DESTDIR -C deepin-gettext-tools-1.0.11 install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "deepin/deepin-gettext-tools.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "url": [
    "https://github.com/linuxdeepin/deepin-gettext-tools/archive/1.0.11.tar.gz"
  ]
}
