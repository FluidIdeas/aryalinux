{
  "name": "libgweather",
  "version": "4.4.4",
  "description": "The libgweather package is a library used to access weather information from online services for numerous locations.",
  "url": [
    "https://download.gnome.org/sources/libgweather/4.4/libgweather-4.4.4.tar.xz"
  ],
  "dependencies": {
    "required": [
      "geocode-glib",
      "glib2",
      "libsoup3",
      "libxml2",
      "python-modules.pygobject3",
      "vala"
    ]
  },
  "build": {
    "user": [
      "patch -Np1 -i ../libgweather-4.4.4-upstream_fix-1.patch",
      "meson setup build --prefix=/usr       \\\n            --buildtype=release \\\n            -D gtk_doc=false    .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "gnome/libgweather.html",
  "category": "desktop-gnome",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "additionalUrls": [
    "https://www.linuxfromscratch.org/patches/blfs/13.0/libgweather-4.4.4-upstream_fix-1.patch"
  ]
}
