{
  "name": "pantheon-onboarding",
  "version": "8.1.0",
  "description": "Pantheon first-run onboarding.",
  "category": "applications",
  "url": [
    "https://github.com/elementary/onboarding/archive/refs/tags/8.1.0.tar.gz"
  ],
  "dependencies": {
    "required": [
      "glib2",
      "granite7",
      "gtk4",
      "pantheon-wayland"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr -Dbuildtype=release  .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "pantheon/pantheon-onboarding.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
