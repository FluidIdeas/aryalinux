{
  "name": "python-modules.PyYAML",
  "version": "6.0.3",
  "description": "",
  "category": "",
  "dependencies": {
    "required": [
      "python-modules.cython"
    ]
  },
  "build": {
    "user": [
      "pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD"
    ],
    "package": [
      "pip3 install --root=$DESTDIR --no-index --find-links dist --no-user PyYAML"
    ]
  },
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "meta": false,
  "book": "general/python-modules.html",
  "url": [
    "https://files.pythonhosted.org/packages/source/P/PyYAML/pyyaml-6.0.3.tar.gz"
  ]
}
