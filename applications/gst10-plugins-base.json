{
  "name": "gst10-plugins-base",
  "version": "1.28.1",
  "description": "GStreamer Base Plug-ins is a well-groomed and well-maintained collection of GStreamer plug-ins and elements, spanning the range of possible types of elements one would want to write for GStreamer. You will need at least one of Good, Bad, Ugly or Libav plugins for GStreamer applications to function properly.",
  "url": [
    "https://gstreamer.freedesktop.org/src/gst-plugins-base/gst-plugins-base-1.28.1.tar.xz"
  ],
  "dependencies": {
    "required": [
      "alsa-lib",
      "cdparanoia",
      "glib2",
      "gstreamer10",
      "iso-codes",
      "libgudev",
      "libjpeg",
      "libogg",
      "libpng",
      "libvorbis",
      "mesa",
      "pango",
      "wayland-protocols",
      "x7lib"
    ]
  },
  "build": {
    "user": [
      "sed -i '/tcase_add_test (tc_chain, test_reorder_buffer);/d' tests/check/libs/gstglcolorconvert.c",
      "meson setup build --prefix=/usr --buildtype=release --wrap-mode=nodownload .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "multimedia/gst10-plugins-base.html",
  "category": "multimedia",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
