{
  "name": "deepin-screen-recorder",
  "version": "6.5.2",
  "description": "Deepin Screen Recorder (Deepin Desktop Environment).",
  "category": "desktop-deepin",
  "dependencies": {
    "required": [
      "dconf",
      "deepin-image-editor",
      "deepin-qt-dbus-factory",
      "deepin-qt6integration",
      "deepin-tray-loader",
      "deepin-turbo",
      "dtk6core",
      "dtk6gui",
      "dtk6widget",
      "hicolor-icon-theme",
      "opencv",
      "qt6",
      "wayland"
    ]
  },
  "build": {
    "user": [
      "make"
    ],
    "package": [
      "make DESTDIR=$DESTDIR install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "deepin/deepin-screen-recorder.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "url": [
    "https://github.com/linuxdeepin/deepin-screen-recorder/archive/refs/tags/6.5.2.tar.gz"
  ]
}
