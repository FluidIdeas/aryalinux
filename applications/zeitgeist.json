{
  "name": "zeitgeist",
  "version": "1.0.4",
  "description": "Activity logging framework (required by Pantheon Files).",
  "category": "libraries",
  "url": [
    "https://launchpad.net/zeitgeist/libzeitgeist/1.0.4/+download/libzeitgeist-1.0.4.tar.gz"
  ],
  "dependencies": {
    "required": [
      "dbus",
      "glib2",
      "json-glib",
      "sqlite"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr -Dbuildtype=release .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "pantheon/zeitgeist.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
