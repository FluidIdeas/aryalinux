{
  "name": "pantheon-tasks",
  "version": "6.3.3",
  "description": "Pantheon tasks/reminders.",
  "category": "applications",
  "url": [
    "https://github.com/elementary/tasks/archive/refs/tags/6.3.3.tar.gz"
  ],
  "dependencies": {
    "required": [
      "evolution-data-server",
      "glib2",
      "granite7",
      "libical"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr -Dbuildtype=release  .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "pantheon/pantheon-tasks.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
