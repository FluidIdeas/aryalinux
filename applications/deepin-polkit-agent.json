{
  "name": "deepin-polkit-agent",
  "version": "6.0.21",
  "description": "Deepin Polkit Agent (Deepin Desktop Environment).",
  "category": "desktop-deepin",
  "dependencies": {
    "required": [
      "deepin-shell",
      "dtk6core",
      "dtk6gui",
      "dtk6widget",
      "polkit-qt",
      "qt6"
    ]
  },
  "build": {
    "user": [
      "cmake . -GNinja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_INSTALL_LIBEXECDIR=lib -DCMAKE_INSTALL_SYSCONFDIR=/etc ",
      "ninja"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "deepin/deepin-polkit-agent.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "url": [
    "https://github.com/linuxdeepin/deepin-polkit-agent/archive/refs/tags/6.0.21.tar.gz"
  ]
}
