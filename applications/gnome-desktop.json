{
  "name": "gnome-desktop",
  "version": "44.5",
  "description": "The GNOME Desktop package contains a library that provides an API shared by several applications on the GNOME Desktop.",
  "url": "https://download.gnome.org/sources/gnome-desktop/44/gnome-desktop-44.5.tar.xz",
  "dependencies": {
    "required": [
      "gsettings-desktop-schemas",
      "iso-codes",
      "gtk3",
      "bubblewrap",
      "glib2"
    ]
  },
  "build": {
    "user": [
      "mkdir build",
      "cd    build",
      "meson setup --prefix=/usr         \\\n            --buildtype=release   \\\n            -D desktop_docs=false \\\n            ..",
      "ninja"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja install"
    ]
  },
  "meta": false,
  "book": "gnome/gnome-desktop.html",
  "category": "desktop-gnome",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
