{
  "name": "cjs",
  "version": "128.1",
  "description": "JavaScript bindings for Cinnamon (SpiderMonkey).",
  "category": "programming",
  "url": [
    "https://github.com/linuxmint/cjs/archive/refs/tags/128.1.tar.gz"
  ],
  "dependencies": {
    "required": [
      "cairo",
      "glib2",
      "gobject-introspection",
      "js128",
      "libffi",
      "readline"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr -Dbuildtype=release -Dinstalled_tests=false .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install",
      "rm -rf $DESTDIR/usr/lib/installed-tests"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "cinnamon/cjs.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
