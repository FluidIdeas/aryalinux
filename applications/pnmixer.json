{
  "name": "pnmixer",
  "version": "0.7.2",
  "description": "The Pnmixer package provides a lightweight volume control with a tray icon.",
  "url": "https://github.com/nicklan/pnmixer/releases/download/v0.7.2/pnmixer-v0.7.2.tar.gz",
  "dependencies": {
    "required": [
      "alsa-utils",
      "gtk3",
      "libnotify"
    ]
  },
  "build": {
    "user": [
      "cmake -B build -D CMAKE_INSTALL_PREFIX=/usr        \\\n      -D CMAKE_POLICY_VERSION_MINIMUM=3.5 \\\n      .",
      "make -C build"
    ],
    "package": [
      "make -C build install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "multimedia/pnmixer.html",
  "category": "multimedia",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
