{
  "name": "ibus",
  "version": "1.5.33",
  "description": "ibus is an Intelligent Input Bus. It is a new input framework for the Linux OS. It provides a fully featured and user friendly input method user interface.",
  "url": [
    "https://github.com/ibus/ibus/archive/1.5.33/ibus-1.5.33.tar.gz"
  ],
  "dependencies": {
    "required": [
      "dconf",
      "glib2",
      "gtk3",
      "gtk4",
      "iso-codes",
      "libarchive",
      "libnotify",
      "vala"
    ]
  },
  "build": {
    "user": [
      "sed -e 's@/desktop/ibus@/org/freedesktop/ibus@g' \\\n    -i data/dconf/org.freedesktop.ibus.gschema.xml",
      "if ! [ -e /usr/bin/gtkdocize ]; then\n  sed '/docs/d;/GTK_DOC/d' -i Makefile.am configure.ac\nfi",
      "SAVE_DIST_FILES=1 NOCONFIGURE=1 ./autogen.sh",
      "mkdir -p ucd && unzip -o ../UCD.zip -d ucd",
      "./configure --prefix=/usr          \\\n            --sysconfdir=/etc      \\\n            --disable-python2      \\\n            --disable-appindicator \\\n            --disable-gtk2         \\\n            --disable-emoji-dict   \\\n            --with-ucd-dir=$(pwd)/ucd",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR",
      "mkdir -p $DESTDIR/usr/share/unicode/ucd",
      "unzip -o ../UCD.zip -d $DESTDIR/usr/share/unicode/ucd"
    ]
  },
  "post_install": [
    "gtk-query-immodules-3.0 --update-cache"
  ],
  "meta": false,
  "book": "general/ibus.html",
  "category": "libraries",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "additionalUrls": [
    "https://www.unicode.org/Public/17.0.0/ucd/UCD.zip"
  ]
}
