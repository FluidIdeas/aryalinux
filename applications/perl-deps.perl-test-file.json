{
  "name": "perl-deps.perl-test-file",
  "version": "1.995",
  "description": "Perl module perl::test::file providing build-time or runtime support for other Perl packages.",
  "url": "https://cpan.metacpan.org/authors/id/B/BR/BRIANDFOY/Test-File-1.995.tar.gz",
  "dependencies": {
    "required": [
      "perl-deps.perl-test-utf8"
    ]
  },
  "build": {
    "user": [
      "perl Makefile.PL",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "general/perl-deps.html",
  "category": "perl-dependency",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
