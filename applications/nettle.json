{
  "name": "nettle",
  "version": "3.10.2",
  "description": "The Nettle package contains a low-level cryptographic library that is designed to fit easily in many contexts.",
  "url": "https://ftpmirror.gnu.org/nettle/nettle-3.10.2.tar.gz",
  "dependencies": {},
  "build": {
    "user": [
      "./configure --prefix=/usr --disable-static",
      "make",
      "chmod   -v   755 /usr/lib/lib{hogweed,nettle}.so"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR",
      "install -v -m755 -d $DESTDIR/usr/share/doc/nettle-3.10.2",
      "install -v -m644 nettle.{html,pdf} $DESTDIR/usr/share/doc/nettle-3.10.2"
    ]
  },
  "meta": false,
  "book": "postlfs/nettle.html",
  "category": "security",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
