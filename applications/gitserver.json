{
  "name": "gitserver",
  "version": "0",
  "description": "Sets up a Git daemon for serving repositories over the network.",
  "dependencies": {
    "required": [
      "git",
      "openssh"
    ]
  },
  "build": {
    "user": [],
    "package": [
      "tar -xf ../blfs-systemd-units-20251204.tar.xz",
      "(cd blfs-systemd-units-20251204 && make install-git-daemon DESTDIR=$DESTDIR)",
      "install -d -m700 $DESTDIR/home/git/.ssh",
      "install -m600 /dev/null $DESTDIR/home/git/.ssh/authorized_keys",
      "install -d -m755 $DESTDIR/srv/git/project1.git"
    ]
  },
  "post_install": [
    "getent group git >/dev/null || groupadd -g 58 git",
    "id -u git >/dev/null 2>&1 || useradd -c \"git Owner\" -d /home/git -m -g git -s /usr/bin/git-shell -u 58 git",
    "sed -i '/^git:/s/^git:[^:]:/git:NP:/' /etc/shadow",
    "grep -q '^/usr/bin/git-shell$' /etc/shells || echo \"/usr/bin/git-shell\" >> /etc/shells",
    "git config --system init.defaultBranch trunk",
    "chown -R git:git /home/git /srv/git",
    "chmod 700 /home/git/.ssh",
    "chmod 600 /home/git/.ssh/authorized_keys",
    "(cd /srv/git/project1.git && git init --bare && chown -R git:git .)",
    "touch /srv/git/project1.git/git-daemon-export-ok",
    "chown git:git /srv/git/project1.git/git-daemon-export-ok",
    "systemctl enable git-daemon"
  ],
  "meta": false,
  "book": "general/gitserver.html",
  "category": "programming",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "additionalUrls": [
    "https://www.linuxfromscratch.org/blfs/downloads/13.0-systemd/blfs-systemd-units-20251204.tar.xz"
  ]
}
