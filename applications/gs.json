{
  "name": "gs",
  "version": "10.06.0",
  "description": "Ghostscript is a versatile processor for PostScript data with the ability to render PostScript to different targets. It is a mandatory part of the cups printing stack.",
  "url": [
    "https://github.com/ArtifexSoftware/ghostpdl-downloads/releases/download/gs10060/ghostscript-10.06.0.tar.xz",
    "https://downloads.sourceforge.net/gs-fonts/ghostscript-fonts-std-8.11.tar.gz",
    "https://downloads.sourceforge.net/gs-fonts/gnu-gs-fonts-other-6.0.tar.gz"
  ],
  "dependencies": {
    "required": [
      "cups",
      "cups-filters",
      "libjpeg",
      "libpng",
      "openjpeg2"
    ]
  },
  "build": {
    "user": [
      "rm -rf freetype lcms2mt jpeg libpng openjpeg",
      "rm -rf zlib",
      "./configure --prefix=/usr           \\\n            --disable-compile-inits \\\n            --with-system-libtiff   \\\n            CFLAGS=\"${CFLAGS:--g -O3} -fPIC\"",
      "make",
      "make so"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR",
      "make soinstall DESTDIR=$DESTDIR",
      "install -v -m644 base/*.h $DESTDIR/usr/include/ghostscript",
      "ln -sfvn ghostscript $DESTDIR/usr/include/ps",
      "mv -v $DESTDIR/usr/share/doc/ghostscript/10.06.0 $DESTDIR/usr/share/doc/ghostscript-10.06.0",
      "rmdir $DESTDIR/usr/share/doc/ghostscript",
      "cp -r examples/ -T $DESTDIR/usr/share/ghostscript/10.06.0/examples",
      "tar -xvf ../ghostscript-fonts-std-8.11.tar.gz -C $DESTDIR/usr/share/ghostscript --no-same-owner",
      "tar -xvf ../gnu-gs-fonts-other-6.0.tar.gz -C $DESTDIR/usr/share/ghostscript --no-same-owner"
    ]
  },
  "post_install": [
    "fc-cache -v /usr/share/ghostscript/fonts/"
  ],
  "meta": false,
  "book": "pst/gs.html",
  "category": "printing",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
