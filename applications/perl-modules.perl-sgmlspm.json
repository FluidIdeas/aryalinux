{
  "name": "perl-modules.perl-sgmlspm",
  "version": "1.1",
  "description": "Perl module perl::sgmlspm used by applications and other Perl packages on the system.",
  "url": "https://www.cpan.org/authors/id/R/RA/RAAB/SGMLSpm-1.1.tar.gz",
  "dependencies": {},
  "build": {
    "user": [
      "chmod -v 644 MYMETA.yml",
      "perl Makefile.PL",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR",
      "ln -sv sgmlspl.pl $DESTDIR/usr/bin/sgmlspl"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "general/perl-modules.html",
  "category": "perl-module",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
