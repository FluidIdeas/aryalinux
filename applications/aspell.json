{
  "name": "aspell",
  "version": "0.60.8.2",
  "description": "The Aspell package contains an interactive spell checking program and the Aspell libraries. Aspell can either be used as a library or as an independent spell checker.",
  "url": [
    "https://ftpmirror.gnu.org/aspell/aspell-0.60.8.2.tar.gz"
  ],
  "dependencies": {
    "required": [
      "which"
    ]
  },
  "build": {
    "user": [
      "./configure --prefix=/usr",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR",
      "install -v -m755 scripts/ispell $DESTDIR/usr/bin/",
      "install -v -m755 scripts/spell $DESTDIR/usr/bin/",
      "ln -svfn aspell-0.60 $DESTDIR/usr/lib/aspell",
      "tar xf ../aspell6-en-2020.12.07-0.tar.bz2",
      "cd aspell6-en-2020.12.07-0 && PATH=$DESTDIR/usr/bin:$PATH LD_LIBRARY_PATH=$DESTDIR/usr/lib:$DESTDIR/usr/lib/aspell-0.60 ./configure --vars ASPELL_FLAGS=--prefix=$DESTDIR/usr",
      "cd aspell6-en-2020.12.07-0 && PATH=$DESTDIR/usr/bin:$PATH LD_LIBRARY_PATH=$DESTDIR/usr/lib:$DESTDIR/usr/lib/aspell-0.60 make",
      "cd aspell6-en-2020.12.07-0 && make install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "general/aspell.html",
  "category": "libraries",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "additionalUrls": [
    "https://ftpmirror.gnu.org/aspell/dict/en/aspell6-en-2020.12.07-0.tar.bz2"
  ]
}
