{
  "name": "kdsoap-ws-discovery-client",
  "version": "0.4.0",
  "description": "",
  "category": "",
  "dependencies": {
    "required": [
      "doxygen",
      "kdsoap"
    ]
  },
  "build": {
    "user": [
      "cmake -B build -D CMAKE_INSTALL_PREFIX=/usr    \\\n      -D CMAKE_BUILD_TYPE=Release     \\\n      -D CMAKE_SKIP_INSTALL_RPATH=ON  \\\n      -D QT_MAJOR_VERSION=6           \\\n      -W no-dev .",
      "make -C build"
    ],
    "package": [
      "make -C build install DESTDIR=$DESTDIR"
    ]
  },
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "meta": false,
  "book": "basicnet/kdsoap-ws-discovery-client.html",
  "url": [
    "https://download.kde.org/stable/kdsoap-ws-discovery-client/kdsoap-ws-discovery-client-0.4.0.tar.xz"
  ]
}
