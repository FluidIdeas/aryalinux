{
  "name": "deepin-session-ui",
  "version": "6.0.42",
  "description": "Deepin desktop-environment - Session UI module (Deepin Desktop Environment).",
  "category": "desktop-deepin",
  "dependencies": {
    "required": [
      "deepin-daemon",
      "deepin-pw-check",
      "deepin-wallpapers",
      "dtk6core",
      "dtk6gui",
      "dtk6widget",
      "glib2",
      "hicolor-icon-theme",
      "qt6",
      "systemd",
      "xcb-util-wm"
    ]
  },
  "build": {
    "user": [
      "cmake . -GNinja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_INSTALL_LIBEXECDIR=lib -DCMAKE_INSTALL_SYSCONFDIR=/etc ",
      "ninja"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "deepin/deepin-session-ui.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "url": [
    "https://github.com/linuxdeepin/dde-session-ui/archive/refs/tags/6.0.42.tar.gz"
  ]
}
