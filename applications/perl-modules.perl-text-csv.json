{
  "name": "perl-modules.perl-text-csv",
  "version": "2.06",
  "description": "Perl module perl::text::csv used by applications and other Perl packages on the system.",
  "url": [
    "https://www.cpan.org/authors/id/I/IS/ISHIGAKI/Text-CSV-2.06.tar.gz"
  ],
  "dependencies": {
    "required": [
      "biber"
    ]
  },
  "build": {
    "user": [
      "perl Makefile.PL",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "general/perl-modules.html",
  "category": "perl-module",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
