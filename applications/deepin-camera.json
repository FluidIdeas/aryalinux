{
  "name": "deepin-camera",
  "version": "6.5.13",
  "description": "Tool to view camera, take photo and video (Deepin Desktop Environment).",
  "category": "desktop-deepin",
  "dependencies": {
    "required": [
      "deepin-image-editor",
      "dtk6core",
      "dtk6gui",
      "dtk6widget",
      "ffmpeg",
      "ffmpegthumbnailer",
      "glib2",
      "hicolor-icon-theme",
      "libpciaccess",
      "pipewire",
      "qt6"
    ]
  },
  "build": {
    "user": [
      "cmake . -GNinja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_INSTALL_LIBEXECDIR=lib -DCMAKE_INSTALL_SYSCONFDIR=/etc ",
      "ninja"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "deepin/deepin-camera.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "url": [
    "https://github.com/linuxdeepin/deepin-camera/archive/refs/tags/6.5.13.tar.gz"
  ]
}
