{
  "name": "python-deps.iniconfig",
  "version": "2.3.0",
  "description": "Python package iniconfig required as a dependency of other Python modules.",
  "url": [
    "https://files.pythonhosted.org/packages/source/i/iniconfig/iniconfig-2.3.0.tar.gz"
  ],
  "dependencies": {},
  "build": {
    "user": [
      "pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD"
    ],
    "package": [
      "pip3 install --root=$DESTDIR --no-index --find-links dist --no-user iniconfig"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "general/python-dependencies.html",
  "category": "python-dependency",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
