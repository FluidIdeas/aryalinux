{
  "name": "libplacebo",
  "version": "7.360.0",
  "description": "",
  "category": "",
  "dependencies": {
    "required": [
      "glad",
      "glslang"
    ]
  },
  "build": {
    "user": [
      "mkdir build",
      "cd    build",
      "meson setup ..            \\\n      --prefix=/usr       \\\n      --buildtype=release \\\n      -D tests=true       \\\n      -D demos=false",
      "ninja"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja install"
    ]
  },
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "meta": false,
  "book": "multimedia/libplacebo.html",
  "url": [
    "https://github.com/haasn/libplacebo/archive/v7.360.0/libplacebo-7.360.0.tar.gz"
  ]
}
