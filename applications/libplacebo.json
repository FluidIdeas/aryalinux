{
  "name": "libplacebo",
  "version": "7.360.0",
  "description": "",
  "category": "",
  "dependencies": {
    "required": [
      "glad",
      "glslang",
      "vulkan-loader"
    ]
  },
  "build": {
    "user": [
      "meson setup build            \\\n      --prefix=/usr       \\\n      --buildtype=release \\\n      -D tests=false       \\\n      -D demos=false .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "meta": false,
  "book": "multimedia/libplacebo.html",
  "url": [
    "https://github.com/haasn/libplacebo/archive/v7.360.0/libplacebo-7.360.0.tar.gz"
  ]
}
