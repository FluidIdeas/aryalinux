{
  "name": "xfce4-appfinder",
  "version": "4.20.0",
  "description": "Xfce4 Appfinder is a tool to find and launch installed applications by searching the .desktop files installed on your system.",
  "url": "https://archive.xfce.org/src/xfce/xfce4-appfinder/4.20/xfce4-appfinder-4.20.0.tar.bz2",
  "dependencies": {
    "required": [
      "garcon"
    ]
  },
  "build": {
    "user": [
      "./configure --prefix=/usr",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [
    "gtk-update-icon-cache -qtf /usr/share/icons/hicolor",
    "update-desktop-database -q",
    "update-mime-database /usr/share/mime"
  ],
  "meta": false,
  "book": "xfce/xfce4-appfinder.html",
  "category": "desktop-xfce",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
