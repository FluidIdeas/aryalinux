{
  "name": "avahi",
  "version": "0.8",
  "description": "The Avahi package is a system which facilitates service discovery on a local network.",
  "url": "https://github.com/lathiat/avahi/releases/download/v0.8/avahi-0.8.tar.gz",
  "dependencies": {
    "required": [
      "glib2",
      "gtk3"
    ]
  },
  "build": {
    "user": [
      "patch -Np1 -i ../avahi-0.8-ipv6_race_condition_fix-1.patch",
      "sed -i '426a if (events & AVAHI_WATCH_HUP) { \\\nclient_free(c); \\\nreturn; \\\n}' avahi-daemon/simple-protocol.c",
      "./configure \\\n    --prefix=/usr        \\\n    --sysconfdir=/etc    \\\n    --localstatedir=/var \\\n    --disable-static     \\\n    --disable-libevent   \\\n    --disable-mono       \\\n    --disable-monodoc    \\\n    --disable-python     \\\n    --disable-qt3        \\\n    --disable-qt4        \\\n    --disable-qt5        \\\n    --enable-core-docs   \\\n    --with-distro=none   \\\n    --with-dbus-system-address='unix:path=/run/dbus/system_bus_socket'",
      "make",
      "mkdir -pv /etc/systemd/resolved.conf.d",
      "cat > /etc/systemd/resolved.conf.d/no-mdns.conf << EOF",
      "[Resolve]\nMulticastDNS=no\nEOF\nsystemctl enable avahi-daemon",
      "systemctl enable avahi-dnsconfd",
      "groupadd -fg 84 avahi",
      "useradd -c \"Avahi Daemon Owner\" -d /run/avahi-daemon -u 84 \\\n        -g avahi -s /bin/false avahi",
      "groupadd -fg 86 netdev"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "meta": false,
  "book": "basicnet/avahi.html",
  "category": "networking",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
