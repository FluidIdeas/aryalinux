{
  "name": "perl-deps.perl-namespace-autoclean",
  "version": "0.31",
  "description": "Perl module perl::namespace::autoclean providing build-time or runtime support for other Perl packages.",
  "url": [
    "https://cpan.metacpan.org/authors/id/E/ET/ETHER/namespace-autoclean-0.31.tar.gz"
  ],
  "dependencies": {
    "required": [
      "perl-deps.perl-namespace-clean",
      "perl-deps.perl-test-needs"
    ]
  },
  "build": {
    "user": [
      "perl Makefile.PL",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "general/perl-deps.html",
  "category": "perl-dependency",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
