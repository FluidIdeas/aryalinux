{
  "name": "balsa",
  "version": "2.6.5",
  "description": "The Balsa package contains a lightweight GTK+-based mail client.",
  "url": [
    "https://gitlab.gnome.org/GNOME/balsa/-/archive/2.6.5/balsa-2.6.5.tar.gz"
  ],
  "dependencies": {
    "required": [
      "enchant",
      "gmime3",
      "gpgme",
      "gtk3",
      "libical",
      "libnotify",
      "libsecret"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr       \\\n               --buildtype=release \\\n               -D html-widget=no \\\n               .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "xsoft/balsa.html",
  "category": "applications",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
