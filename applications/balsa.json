{
  "name": "balsa",
  "version": "2.6.5",
  "description": "The Balsa package contains a lightweight GTK+-based mail client.",
  "url": "https://gitlab.gnome.org/GNOME/balsa/-/archive/2.6.5/balsa-2.6.5.tar.gz",
  "dependencies": {
    "required": [
      "enchant",
      "gpgme",
      "libical",
      "libsecret",
      "mail"
    ]
  },
  "build": {
    "user": [
      "mkdir build",
      "cd    build",
      "meson setup .. --prefix=/usr       \\\n               --buildtype=release \\\n               -D html-widget=no",
      "ninja"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja install"
    ]
  },
  "meta": false,
  "book": "xsoft/balsa.html",
  "category": "applications",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
