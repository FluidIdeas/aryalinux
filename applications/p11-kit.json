{
  "name": "p11-kit",
  "version": "0.26.2",
  "description": "The p11-kit package provides a way to load and enumerate PKCS #11 (a Cryptographic Token Interface Standard) modules.",
  "url": "https://github.com/p11-glue/p11-kit/releases/download/0.26.2/p11-kit-0.26.2.tar.xz",
  "dependencies": {
    "required": [
      "libtasn1",
      "make-ca"
    ]
  },
  "build": {
    "user": [
      "sed '20,$ d' -i trust/trust-extract-compat",
      "cat >> trust/trust-extract-compat << \"EOF\"\n# Copy existing anchor modifications to /etc/ssl/local\n/usr/libexec/make-ca/copy-trust-modifications\n\n# Update trust stores\n/usr/sbin/make-ca -r\nEOF",
      "meson setup p11-build --prefix=/usr --buildtype=release -D trust_paths=/etc/pki/anchors .",
      "ninja -C p11-build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C p11-build install",
      "ln -sfv /usr/libexec/p11-kit/trust-extract-compat \\\n        $DESTDIR/usr/bin/update-ca-certificates",
      "ln -sfv ./pkcs11/p11-kit-trust.so $DESTDIR/usr/lib/libnssckbi.so"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "postlfs/p11-kit.html",
  "category": "security",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
