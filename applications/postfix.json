{
  "name": "postfix",
  "version": "3.10.8",
  "description": "The Postfix package contains a Mail Transport Agent (MTA). This is useful for sending email to other users of your host machine. It can also be configured to be a central mail server for your domain, a mail relay agent or simply a mail delivery agent to your local Internet Service Provider.",
  "url": [
    "https://ghostarchive.org/postfix/postfix-release/official/postfix-3.10.8.tar.gz"
  ],
  "dependencies": {
    "required": [
      "cyrus-sasl",
      "lmdb"
    ]
  },
  "build": {
    "user": [
      "sed -i 's/.\\x08//g' README_FILES/*",
      "CCARGS=\"-DNO_NIS -DNO_DB\"\nAUXLIBS=\"\"",
      "if [ -r /usr/lib/libsasl2.so ]; then\n  CCARGS=\"$CCARGS -DUSE_SASL_AUTH -DUSE_CYRUS_SASL -I/usr/include/sasl\"\n  AUXLIBS=\"$AUXLIBS -lsasl2\"\nfi",
      "if [ -r /usr/lib/liblmdb.so ]; then\n  CCARGS=\"$CCARGS -DHAS_LMDB\"\n  AUXLIBS=\"$AUXLIBS -llmdb\"\nfi",
      "if [ -r /usr/lib/libldap.so -a -r /usr/lib/liblber.so ]; then\n  CCARGS=\"$CCARGS -DHAS_LDAP\"\n  AUXLIBS=\"$AUXLIBS -lldap -llber\"\nfi",
      "if [ -r /usr/lib/libsqlite3.so ]; then\n  CCARGS=\"$CCARGS -DHAS_SQLITE\"\n  AUXLIBS=\"$AUXLIBS -lsqlite3 -lpthread\"\nfi",
      "if [ -r /usr/lib/libmysqlclient.so ]; then\n  CCARGS=\"$CCARGS -DHAS_MYSQL -I/usr/include/mysql\"\n  AUXLIBS=\"$AUXLIBS -lmysqlclient -lz -lm\"\nfi",
      "if [ -r /usr/lib/libpq.so ]; then\n  CCARGS=\"$CCARGS -DHAS_PGSQL -I/usr/include/postgresql\"\n  AUXLIBS=\"$AUXLIBS -lpq -lz -lm\"\nfi",
      "if [ -r /usr/lib/libssl.so -a -r /usr/lib/libcrypto.so ]; then\n  CCARGS=\"$CCARGS -DUSE_TLS -I/usr/include/openssl/\"\n  AUXLIBS=\"$AUXLIBS -lssl -lcrypto\"\nfi",
      "make CC=\"gcc -std=gnu17\" CCARGS=\"$CCARGS\" AUXLIBS=\"$AUXLIBS\" makefiles",
      "make"
    ],
    "package": [
      "sh postfix-install -non-interactive install_root=$DESTDIR \\\n   daemon_directory=/usr/lib/postfix \\\n   manpage_directory=/usr/share/man",
      "tar -xf ../../blfs-systemd-units-20251204.tar.xz -C ../../",
      "cd ../../blfs-systemd-units-20251204 && make install-postfix DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [
    "getent group postfix >/dev/null || groupadd -g 32 postfix",
    "getent group postdrop >/dev/null || groupadd -g 33 postdrop",
    "id -u postfix >/dev/null 2>&1 || useradd -c \"Postfix Daemon User\" -d /var/spool/postfix -g postfix -s /bin/false -u 32 postfix",
    "chown -v postfix:postfix /var/mail",
    "/usr/sbin/postfix -c /etc/postfix set-permissions",
    "/usr/sbin/postfix upgrade-configuration",
    "/usr/sbin/postfix check",
    "grep -q '^MAILER-DAEMON:' /etc/aliases 2>/dev/null || cat >> /etc/aliases << \"EOF\"\n# Begin /etc/aliases\n\nMAILER-DAEMON:    postmaster\npostmaster:       root\n\nroot:             <LOGIN>\n# End /etc/aliases\nEOF",
    "grep -q '^default_database_type' /etc/postfix/main.cf 2>/dev/null || echo 'default_database_type = lmdb' >> /etc/postfix/main.cf",
    "grep -q '^alias_database' /etc/postfix/main.cf 2>/dev/null || echo 'alias_database = lmdb:/etc/aliases' >> /etc/postfix/main.cf",
    "grep -q '^alias_maps' /etc/postfix/main.cf 2>/dev/null || echo 'alias_maps = lmdb:/etc/aliases' >> /etc/postfix/main.cf",
    "grep -q '^smtpd_forbid_bare_newline ' /etc/postfix/main.cf 2>/dev/null || echo 'smtpd_forbid_bare_newline = normalize' >> /etc/postfix/main.cf",
    "grep -q '^smtpd_forbid_bare_newline_exclusions' /etc/postfix/main.cf 2>/dev/null || echo 'smtpd_forbid_bare_newline_exclusions = $mynetworks' >> /etc/postfix/main.cf",
    "/usr/sbin/postfix start",
    "systemctl enable postfix"
  ],
  "meta": false,
  "book": "server/postfix.html",
  "category": "server",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "additionalUrls": [
    "https://www.linuxfromscratch.org/blfs/downloads/13.0-systemd/blfs-systemd-units-20251204.tar.xz"
  ]
}
