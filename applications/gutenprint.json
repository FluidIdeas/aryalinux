{
  "name": "gutenprint",
  "version": "5.3.5",
  "description": "The Gutenprint (formerly Gimp-Print) package contains high quality drivers for many brands and models of printers for use with Cups-2.4.16. See a list of supported printers at https://gimp-print.sourceforge.io/p_Supported_Printers.php.",
  "url": [
    "https://downloads.sourceforge.net/gimp-print/gutenprint-5.3.5.tar.xz"
  ],
  "dependencies": {
    "required": [
      "cups",
      "cups-filters"
    ]
  },
  "build": {
    "user": [
      "sed -i 's|$(PACKAGE)/doc|doc/$(PACKAGE)-$(VERSION)|' \\\n       {,doc/,doc/developer/}Makefile.in",
      "./configure --prefix=/usr    \\\n            --disable-static \\\n            --without-gimp2  \\\n            --without-gimp2-as-gutenprint",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [
    "systemctl restart cups"
  ],
  "meta": false,
  "book": "pst/gutenprint.html",
  "category": "printing",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
