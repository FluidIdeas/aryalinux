{
  "name": "deepin-pw-check",
  "version": "6.0.9",
  "description": "Tool to verify the validity of the password (Deepin Desktop Environment).",
  "category": "desktop-deepin",
  "dependencies": {
    "required": [
      "cracklib",
      "gtk3"
    ]
  },
  "build": {
    "environment": {
      "CGO_CPPFLAGS": "$CPPFLAGS",
      "CGO_CFLAGS": "$CFLAGS",
      "CGO_CXXFLAGS": "$CXXFLAGS",
      "CGO_LDFLAGS": "$LDFLAGS",
      "GOFLAGS": "-buildmode=pie -trimpath -mod=readonly -modcacherw"
    },
    "user": [
      "make"
    ],
    "package": [
      "make DESTDIR=$DESTDIR install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "deepin/deepin-pw-check.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "url": [
    "https://github.com/linuxdeepin/deepin-pw-check/archive/refs/tags/6.0.9.tar.gz"
  ]
}
