{
  "name": "perl-modules.perl-file-slurper",
  "version": "0.014",
  "description": "Perl module perl::file::slurper used by applications and other Perl packages on the system.",
  "url": "https://www.cpan.org/authors/id/L/LE/LEONT/File-Slurper-0.014.tar.gz",
  "dependencies": {
    "required": [
      "perl-deps.perl-test-warnings"
    ]
  },
  "build": {
    "user": [
      "perl Makefile.PL",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "general/perl-modules.html",
  "category": "perl-module",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
