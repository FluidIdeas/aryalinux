{
  "name": "thunar",
  "version": "4.20.7",
  "description": "Thunar is the Xfce file manager, a GTK+ 3 GUI to organise the files on your computer.",
  "url": [
    "https://archive.xfce.org/src/xfce/thunar/4.20/thunar-4.20.7.tar.bz2"
  ],
  "dependencies": {
    "required": [
      "exo",
      "hicolor-icon-theme",
      "libgudev"
    ]
  },
  "build": {
    "user": [
      "./configure --prefix=/usr --sysconfdir=/etc",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [
    "gtk-update-icon-cache -qtf /usr/share/icons/hicolor",
    "update-desktop-database -q"
  ],
  "meta": false,
  "book": "xfce/thunar.html",
  "category": "desktop-xfce",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
