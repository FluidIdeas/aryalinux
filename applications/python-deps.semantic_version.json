{
  "name": "python-deps.semantic_version",
  "version": "2.10.0",
  "description": "Python package semantic_version required as a dependency of other Python modules.",
  "url": [
    "https://files.pythonhosted.org/packages/source/s/semantic_version/semantic_version-2.10.0.tar.gz"
  ],
  "dependencies": {},
  "build": {
    "user": [
      "pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD"
    ],
    "package": [
      "pip3 install --root=$DESTDIR --no-index --find-links dist --no-user semantic_version"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "general/python-dependencies.html",
  "category": "python-dependency",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
