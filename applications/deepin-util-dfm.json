{
  "name": "deepin-util-dfm",
  "version": "1:1.2.32",
  "description": "Utilities of deepin file manager (Deepin Desktop Environment).",
  "category": "desktop-deepin",
  "dependencies": {
    "required": [
      "dtkcore",
      "glib2",
      "libisoburn",
      "libmediainfo",
      "libsecret",
      "lucene++",
      "qt5-base",
      "udisks2"
    ]
  },
  "build": {
    "user": [
      "cmake . -GNinja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_INSTALL_LIBEXECDIR=lib -DCMAKE_INSTALL_SYSCONFDIR=/etc ",
      "ninja"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "deepin/deepin-util-dfm.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "url": [
    "https://github.com/linuxdeepin/deepin-util-dfm/archive/refs/tags/1.2.32.tar.gz"
  ]
}
