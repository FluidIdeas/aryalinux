{
  "name": "gnome-settings-daemon",
  "version": "49.1",
  "description": "The GNOME Settings Daemon is responsible for setting various parameters of a GNOME Session and the applications that run under it.",
  "url": [
    "https://download.gnome.org/sources/gnome-settings-daemon/49/gnome-settings-daemon-49.1.tar.xz"
  ],
  "dependencies": {
    "required": [
      "alsa-lib",
      "colord",
      "cups",
      "gcr",
      "geoclue2",
      "geocode-glib",
      "gnome-desktop",
      "gsettings-desktop-schemas",
      "libcanberra",
      "libgudev",
      "libgweather",
      "libnotify",
      "libX11",
      "libXfixes",
      "ModemManager",
      "networkmanager",
      "nss",
      "polkit",
      "pulseaudio",
      "systemd",
      "upower",
      "wayland"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr       \\\n            --buildtype=release \\\n            -D gcr3=true        \\\n            .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "gnome/gnome-settings-daemon.html",
  "category": "desktop-gnome",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
