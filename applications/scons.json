{
  "name": "scons",
  "version": "4.10.1",
  "description": "SCons is a tool for building software (and other files) implemented in Python.",
  "url": "https://downloads.sourceforge.net/scons/SCons-4.10.1.tar.gz",
  "dependencies": {},
  "build": {
    "user": [
      "pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD"
    ],
    "package": [
      "pip3 install --root=$DESTDIR --no-index --find-links dist --no-user SCons",
      "install -v -m664 *.1 $DESTDIR/usr/share/man/man1"
    ]
  },
  "meta": false,
  "book": "general/scons.html",
  "category": "programming",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
