{
  "name": "deepin-terminal",
  "version": "6.5.36",
  "description": "Default terminal emulation application for Deepin (Deepin Desktop Environment).",
  "category": "desktop-deepin",
  "dependencies": {
    "required": [
      "dtk6core",
      "dtk6gui",
      "dtk6widget",
      "fontconfig",
      "glib2",
      "hicolor-icon-theme",
      "icu",
      "libchardet",
      "libsecret",
      "qt6",
      "uchardet"
    ]
  },
  "build": {
    "user": [
      "cmake . -GNinja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_INSTALL_LIBEXECDIR=lib -DCMAKE_INSTALL_SYSCONFDIR=/etc ",
      "ninja"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "deepin/deepin-terminal.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "url": [
    "https://github.com/linuxdeepin/deepin-terminal/archive/refs/tags/6.5.36.tar.gz"
  ]
}
