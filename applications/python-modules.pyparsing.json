{
  "name": "python-modules.pyparsing",
  "version": "3.3.2",
  "description": "Python module pyparsing for scripts and applications that depend on it.",
  "url": [
    "https://files.pythonhosted.org/packages/source/p/pyparsing/pyparsing-3.3.2.tar.gz"
  ],
  "dependencies": {},
  "build": {
    "user": [
      "pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD"
    ],
    "package": [
      "pip3 install --root=$DESTDIR --no-index --find-links dist --no-user pyparsing"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "general/python-modules.html",
  "category": "python-module",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
