{
  "name": "clucene",
  "version": "2.3.3.4",
  "description": "CLucene is a C++ version of Lucene, a high performance text search engine.",
  "url": [
    "https://downloads.sourceforge.net/clucene/clucene-core-2.3.3.4.tar.gz",
    "https://versaweb.dl.sourceforge.net/project/clucene/clucene/core-2.3.3.4/clucene-core-2.3.3.4.tar.gz"
  ],
  "dependencies": {
    "required": [
      "cmake",
      "boost"
    ]
  },
  "build": {
    "user": [
      "patch -Np1 -i ../../clucene-2.3.3.4-contribs_lib-1.patch",
      "sed -i '/Misc.h/a #include <ctime>' src/core/CLucene/document/DateTools.cpp",
      "cmake -B build -D CMAKE_INSTALL_PREFIX=/usr        \\\n      -D CMAKE_POLICY_VERSION_MINIMUM=3.5 \\\n      -D BUILD_CONTRIBS_LIB=ON            \\\n      -W no-dev .",
      "make -C build"
    ],
    "package": [
      "make -C build install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "general/clucene.html",
  "category": "libraries",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "additionalUrls": [
    "https://www.linuxfromscratch.org/patches/blfs/13.0/clucene-2.3.3.4-contribs_lib-1.patch"
  ]
}
