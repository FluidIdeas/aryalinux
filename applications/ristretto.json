{
  "name": "ristretto",
  "version": "0.13.4",
  "description": "Ristretto is a fast and lightweight image viewer for the Xfce desktop.",
  "url": [
    "https://archive.xfce.org/src/apps/ristretto/0.13/ristretto-0.13.4.tar.xz"
  ],
  "dependencies": {
    "required": [
      "libexif",
      "libxfce4ui"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr --buildtype=release .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "xfce/ristretto.html",
  "category": "desktop-xfce",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
