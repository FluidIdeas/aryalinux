{
  "name": "ristretto",
  "version": "0.13.4",
  "description": "Ristretto is a fast and lightweight image viewer for the Xfce desktop.",
  "url": "https://archive.xfce.org/src/apps/ristretto/0.13/ristretto-0.13.4.tar.xz",
  "dependencies": {
    "required": [
      "libexif"
    ]
  },
  "build": {
    "user": [
      "mkdir build",
      "cd    build",
      "meson setup --prefix=/usr --buildtype=release ..",
      "ninja"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja install"
    ]
  },
  "meta": false,
  "book": "xfce/ristretto.html",
  "category": "desktop-xfce",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
