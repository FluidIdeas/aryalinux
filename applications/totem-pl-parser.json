{
  "name": "totem-pl-parser",
  "version": "3.26.6",
  "description": "The Totem PL Parser package contains a simple GObject-based library used to parse multiple playlist formats.",
  "url": [
    "https://download.gnome.org/sources/totem-pl-parser/3.26/totem-pl-parser-3.26.6.tar.xz"
  ],
  "dependencies": {
    "required": [
      "glib2",
      "libarchive",
      "libgcrypt"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr --buildtype=release .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "gnome/totem-pl-parser.html",
  "category": "desktop-gnome",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
