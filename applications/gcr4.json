{
  "name": "gcr4",
  "version": "4.4.0.1",
  "description": "The Gcr package contains libraries used for displaying certificates and accessing key stores. It also provides the viewer for crypto files on the GNOME Desktop.",
  "url": "https://download.gnome.org/sources/gcr/4.4/gcr-4.4.0.1.tar.xz",
  "dependencies": {
    "required": [
      "glib2",
      "libgcrypt",
      "gnupg",
      "libsecret"
    ]
  },
  "build": {
    "user": [
      "mkdir build",
      "cd    build",
      "meson setup --prefix=/usr       \\\n            --buildtype=release \\\n            -D gtk_doc=false    \\\n            ..",
      "ninja",
      "sed -e \"/install_dir/s@,\\$@ / 'gcr-4.4.0.1'&@\" \\\n    -i ../docs/*/meson.build",
      "meson configure -D gtk_doc=true",
      "ninja"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja install"
    ]
  },
  "meta": false,
  "book": "gnome/gcr4.html",
  "category": "desktop-gnome",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
