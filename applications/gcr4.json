{
  "name": "gcr4",
  "version": "4.4.0.1",
  "description": "The Gcr package contains libraries used for displaying certificates and accessing key stores. It also provides the viewer for crypto files on the GNOME Desktop.",
  "url": [
    "https://download.gnome.org/sources/gcr/4.4/gcr-4.4.0.1.tar.xz"
  ],
  "dependencies": {
    "required": [
      "glib2",
      "gnupg",
      "gtk4",
      "libgcrypt",
      "libsecret",
      "libxslt",
      "p11-kit",
      "vala"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr       \\\n            --buildtype=release \\\n            -D gtk_doc=false    \\\n            .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "gnome/gcr4.html",
  "category": "desktop-gnome",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
