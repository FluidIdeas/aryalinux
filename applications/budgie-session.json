{
  "name": "budgie-session",
  "version": "1.0.1",
  "description": "Budgie Desktop session handler.",
  "category": "desktop-budgie",
  "url": [
    "https://github.com/BuddiesOfBudgie/budgie-session/archive/refs/tags/v1.0.1.tar.gz"
  ],
  "dependencies": {
    "required": [
      "dconf",
      "glib2",
      "gnome-desktop",
      "gsettings-desktop-schemas",
      "gtk3",
      "json-glib",
      "libepoxy",
      "systemd",
      "wayland"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr -Dbuildtype=release .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "budgie/budgie-session.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
