{
  "name": "papirus-icon-theme",
  "version": "20250501",
  "description": "Papirus icon theme (Budgie default icons).",
  "category": "applications",
  "url": [
    "https://github.com/PapirusDevelopmentTeam/papirus-icon-theme/archive/refs/tags/20250501.tar.gz",
    "https://sources.voidlinux.org/papirus-icon-theme-20250501/20250501.tar.gz",
    "http://deb.debian.org/debian/pool/main/p/papirus-icon-theme/papirus-icon-theme_20250501.orig.tar.gz"
  ],
  "build": {
    "package": [
      "make DESTDIR=$DESTDIR install"
    ]
  },
  "post_install": [
    "gtk-update-icon-cache /usr/share/icons/Papirus 2>/dev/null || true"
  ],
  "meta": false,
  "book": "budgie/papirus-icon-theme.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
