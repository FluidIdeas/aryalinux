{
  "name": "perl-deps.perl-text-diff",
  "version": "1.45",
  "description": "Perl module perl::text::diff providing build-time or runtime support for other Perl packages.",
  "url": "https://cpan.metacpan.org/authors/id/N/NE/NEILB/Text-Diff-1.45.tar.gz",
  "dependencies": {
    "required": [
      "perl-deps.perl-algorithm-diff"
    ]
  },
  "build": {
    "user": [
      "perl Makefile.PL",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "general/perl-deps.html",
  "category": "perl-dependency",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
