{
  "name": "samba",
  "version": "4.23.5",
  "description": "The Samba package provides file and print services to SMB/CIFS clients and Windows networking to Linux clients. Samba can also be configured as a Windows Domain Controller replacement, a file/print server acting as a member of a Windows Active Directory domain and a NetBIOS (RFC1001/1002) nameserver (which among other things provides LAN browsing support).",
  "url": [
    "https://download.samba.org/pub/samba/stable/samba-4.23.5.tar.gz"
  ],
  "dependencies": {
    "required": [
      "fuse",
      "gnutls",
      "gpgme",
      "icu",
      "jansson",
      "libtasn1",
      "libtirpc",
      "libxslt",
      "linux-pam",
      "lmdb",
      "mitkrb",
      "openldap",
      "perl-modules.perl-parse-yapp",
      "rpcsvc-proto"
    ]
  },
  "build": {
    "user": [
      "python3 -m venv --system-site-packages pyvenv",
      "./pyvenv/bin/pip3 install cryptography pyasn1 iso8601",
      "PYTHON=$PWD/pyvenv/bin/python3             \\\n./configure                                \\\n    --prefix=/usr                          \\\n    --sysconfdir=/etc                      \\\n    --localstatedir=/var                   \\\n    --with-piddir=/run/samba               \\\n    --with-pammodulesdir=/usr/lib/security \\\n    --enable-fhs                           \\\n    --without-ad-dc                        \\\n    --with-system-mitkrb5                  \\\n    --disable-rpath-install",
      "make",
      "sed '1s@^.*$@#!/usr/bin/python3@' \\\n    -i ./bin/default/source4/scripting/bin/*.inst"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR",
      "install -v -m644 examples/smb.conf.default $DESTDIR/etc/samba",
      "sed -e \"s;log file =.*;log file = /var/log/samba/%m.log;\"   \\\n    -e \"s;path = /usr/spool/samba;path = /var/spool/samba;\" \\\n    -i $DESTDIR/etc/samba/smb.conf.default",
      "install -vdm755 $DESTDIR/etc/openldap/schema",
      "install -v -m644    examples/LDAP/README \\\n                    $DESTDIR/etc/openldap/schema/README.samba",
      "install -v -m644    examples/LDAP/samba* \\\n                    $DESTDIR/etc/openldap/schema",
      "install -v -m755    examples/LDAP/{get*,ol*} \\\n                    $DESTDIR/etc/openldap/schema",
      "install -dvm 755 $DESTDIR/usr/lib/cups/backend",
      "ln -sfv /usr/bin/smbspool $DESTDIR/usr/lib/cups/backend/smb",
      "tar -xf ../../blfs-systemd-units-20251204.tar.xz -C ../../",
      "install -Dm644 ../../blfs-systemd-units-20251204/blfs/default/samba $DESTDIR/etc/default/samba",
      "install -Dm644 ../../blfs-systemd-units-20251204/blfs/tmpfiles/samba.conf $DESTDIR/usr/lib/tmpfiles.d/samba.conf",
      "install -Dm644 ../../blfs-systemd-units-20251204/blfs/units/nmbd.service $DESTDIR/usr/lib/systemd/system/nmbd.service",
      "install -Dm644 ../../blfs-systemd-units-20251204/blfs/units/samba.service $DESTDIR/usr/lib/systemd/system/samba.service",
      "install -Dm644 ../../blfs-systemd-units-20251204/blfs/units/smbd.service $DESTDIR/usr/lib/systemd/system/smbd.service",
      "install -Dm644 ../../blfs-systemd-units-20251204/blfs/units/smbdat.service $DESTDIR/usr/lib/systemd/system/smbd@.service",
      "install -Dm644 ../../blfs-systemd-units-20251204/blfs/units/smbd.socket $DESTDIR/usr/lib/systemd/system/smbd.socket",
      "install -Dm644 ../../blfs-systemd-units-20251204/blfs/units/winbindd.service $DESTDIR/usr/lib/systemd/system/winbindd.service"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "basicnet/samba.html",
  "category": "networking",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "additionalUrls": [
    "https://www.linuxfromscratch.org/blfs/downloads/13.0-systemd/blfs-systemd-units-20251204.tar.xz"
  ]
}
