{
  "name": "nfs-utils",
  "version": "2.8.5",
  "description": "The NFS Utilities package contains the userspace server and client tools necessary to use the kernel's NFS abilities. NFS is a protocol that allows sharing file systems over the network.",
  "url": [
    "https://www.kernel.org/pub/linux/utils/nfs-utils/2.8.5/nfs-utils-2.8.5.tar.xz"
  ],
  "dependencies": {
    "required": [
      "libevent",
      "libnl",
      "libtirpc",
      "libxml2",
      "rpcsvc-proto"
    ]
  },
  "build": {
    "user": [
      "./configure --prefix=/usr       \\\n            --sysconfdir=/etc   \\\n            --sbindir=/usr/sbin \\\n            --disable-nfsv4     \\\n            --disable-gss",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR",
      "chmod u+w,go+r $DESTDIR/usr/sbin/mount.nfs",
      "tar -xf ../../blfs-systemd-units-20251204.tar.xz -C ../../",
      "cd ../../blfs-systemd-units-20251204 && make install-nfs-server DESTDIR=$DESTDIR",
      "cd ../../blfs-systemd-units-20251204 && make install-nfs-client DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [
    "chown nobody:nogroup /var/lib/nfs"
  ],
  "meta": false,
  "book": "basicnet/nfs-utils.html",
  "category": "networking",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "additionalUrls": [
    "https://www.linuxfromscratch.org/blfs/downloads/13.0-systemd/blfs-systemd-units-20251204.tar.xz"
  ]
}
