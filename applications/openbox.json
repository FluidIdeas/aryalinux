{
  "name": "openbox",
  "version": "3.6.1",
  "description": "Openbox is a highly configurable desktop window manager with extensive standards support. It allows you to control almost every aspect of how you interact with your desktop.",
  "url": [
    "http://openbox.org/dist/openbox/openbox-3.6.1.tar.gz"
  ],
  "dependencies": {
    "required": [
      "installing",
      "pango"
    ]
  },
  "build": {
    "user": [
      "export LIBRARY_PATH=$XORG_PREFIX/lib",
      "patch -Np1 -i ../openbox-3.6.1-py3-1.patch",
      "autoreconf -fi",
      "./configure --prefix=/usr     \\\n            --sysconfdir=/etc \\\n            --disable-static  \\\n            --docdir=/usr/share/doc/openbox-3.6.1",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR",
      "rm -v $DESTDIR/usr/share/xsessions/openbox-{gnome,kde}.desktop"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "x/openbox.html",
  "category": "x11",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "additionalUrls": [
    "https://www.linuxfromscratch.org/patches/blfs/13.0/openbox-3.6.1-py3-1.patch"
  ]
}
