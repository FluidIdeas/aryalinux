{
  "name": "clisp",
  "version": "2.49.95",
  "description": "GNU Clisp is a Common Lisp implementation which includes an interpreter, compiler, debugger, and many extensions.",
  "url": "https://anduin.linuxfromscratch.org/BLFS/clisp/clisp-2.49.95.tar.xz",
  "dependencies": {
    "required": [
      "libsigsegv"
    ]
  },
  "build": {
    "user": [
      "mkdir -p build",
      "(cd build && ../configure --srcdir=.. --prefix=/usr --docdir=/usr/share/doc/clisp-2.49.95)",
      "(cd build && make)"
    ],
    "package": [
      "(cd build && make install DESTDIR=$DESTDIR)"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "general/clisp.html",
  "category": "programming",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
