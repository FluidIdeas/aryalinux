{
  "name": "python-modules.numpy",
  "version": "2.4.2",
  "description": "Python module numpy for scripts and applications that depend on it.",
  "url": "https://files.pythonhosted.org/packages/source/n/numpy/numpy-2.4.2.tar.gz",
  "dependencies": {
    "required": [
      "python-modules.cython",
      "python-deps.pyproject-metadata"
    ]
  },
  "build": {
    "user": [
      "pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir \\\n           -C setup-args=-Dallow-noblas=true $PWD"
    ],
    "package": [
      "pip3 install --root=$DESTDIR --no-index --find-links dist --no-user numpy"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "general/python-modules.html",
  "category": "python-module",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
