{
  "name": "lxqt-powermanagement",
  "version": "2.3.0",
  "description": "",
  "category": "",
  "dependencies": {
    "required": [
      "liblxqt",
      "lxqt-kidletime",
      "lxqt-solid",
      "upower"
    ]
  },
  "build": {
    "user": [
      "cmake -B build -D CMAKE_INSTALL_PREFIX=/usr \\\n      -D CMAKE_BUILD_TYPE=Release  \\\n      .",
      "make -C build"
    ],
    "package": [
      "make -C build install DESTDIR=$DESTDIR"
    ]
  },
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "meta": false,
  "book": "lxqt/lxqt-powermanagement.html",
  "url": [
    "https://github.com/lxqt/lxqt-powermanagement/releases/download/2.3.0/lxqt-powermanagement-2.3.0.tar.xz"
  ]
}
