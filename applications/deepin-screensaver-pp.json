{
  "name": "deepin-screensaver-pp",
  "version": "0.0.4",
  "description": "Optional PP screensaver resource for deepin screensaver (Deepin Desktop Environment).",
  "category": "desktop-deepin",
  "dependencies": {
    "required": [
      "deepin-screensaver"
    ]
  },
  "build": {
    "user": [
      "make"
    ],
    "package": [
      "make DESTDIR=$DESTDIR install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "deepin/deepin-screensaver-pp.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "url": [
    "https://github.com/linuxdeepin/deepin-screensaver-pp/archive/refs/tags/0.0.4.tar.gz"
  ]
}
