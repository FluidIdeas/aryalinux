{
  "name": "libnvme",
  "version": "1.16.1",
  "description": "",
  "category": "",
  "dependencies": {},
  "build": {
    "user": [
      "meson setup build --prefix=/usr --buildtype=release -D libdbus=auto .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "meta": false,
  "book": "general/libnvme.html",
