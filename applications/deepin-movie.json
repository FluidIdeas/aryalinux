{
  "name": "deepin-movie",
  "version": "1:5.15.10",
  "description": "Movie player based on mpv (Deepin Desktop Environment).",
  "category": "desktop-deepin",
  "dependencies": {
    "required": [
      "dconf",
      "deepin-daemon",
      "dtkcore",
      "dtkgui",
      "dtkwidget",
      "ffmpegthumbnailer",
      "gsettings-qt6",
      "libva",
      "mpv",
      "qt5-base",
      "qt5-multimedia",
      "qt5-svg",
      "qt5-x11extras",
      "qtdbusextended",
      "qtmpris"
    ]
  },
  "build": {
    "user": [
      "cmake . -GNinja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_INSTALL_LIBEXECDIR=lib -DCMAKE_INSTALL_SYSCONFDIR=/etc ",
      "ninja"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "deepin/deepin-movie.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "url": [
    "https://github.com/linuxdeepin/deepin-movie/archive/refs/tags/5.15.10.tar.gz"
  ]
}
