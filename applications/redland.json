{
  "name": "redland",
  "version": "1.0.17",
  "description": "Redland is a set of free software C libraries that provide support for the Resource Description Framework (RDF).",
  "url": [
    "https://download.librdf.org/source/redland-1.0.17.tar.gz"
  ],
  "dependencies": {
    "required": [
      "rasqal"
    ]
  },
  "build": {
    "user": [
      "./configure --prefix=/usr --disable-static",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "general/redland.html",
  "category": "libraries",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
