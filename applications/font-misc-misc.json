{
  "name": "font-misc-misc",
  "version": "1.1.3",
  "description": "Xorg legacy font-misc-misc (BLFS x7legacy chapter).",
  "url": [
    "https://xorg.freedesktop.org/archive/individual/font/font-misc-misc-1.1.3.tar.xz"
  ],
  "dependencies": {
    "required": [
      "font-isas-misc"
    ]
  },
  "build": {
    "environment": {
      "XORG_PREFIX": "/usr",
      "XORG_CONFIG": "--prefix=/usr --sysconfdir=/etc --localstatedir=/var --disable-static"
    },
    "user": [
      "./configure $XORG_CONFIG",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "x/font-misc-misc.html",
  "category": "x11",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
