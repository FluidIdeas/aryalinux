{
  "name": "libfm-qt",
  "version": "2.3.1",
  "description": "",
  "category": "",
  "dependencies": {
    "required": [
      "cmake",
      "libexif",
      "menu-cache",
      "qt6"
    ]
  },
  "build": {
    "user": [
      "cmake -B build -D CMAKE_INSTALL_PREFIX=/usr \\\n      -D CMAKE_BUILD_TYPE=Release  \\\n      .",
      "make -C build"
    ],
    "package": [
      "make -C build install DESTDIR=$DESTDIR"
    ]
  },
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "meta": false,
  "book": "lxqt/libfm-qt.html",
  "url": [
    "https://github.com/lxqt/libfm-qt/releases/download/2.3.1/libfm-qt-2.3.1.tar.xz"
  ]
}
