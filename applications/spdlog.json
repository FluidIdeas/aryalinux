{
  "name": "spdlog",
  "version": "1.17.0",
  "description": "Fast C++ logging library (DTK dependency).",
  "category": "libraries",
  "dependencies": {
    "required": [
      "fmt"
    ]
  },
  "build": {
    "user": [
      "cmake -B build -DCMAKE_INSTALL_PREFIX=/usr -DSPDLOG_BUILD_SHARED=ON -DSPDLOG_FMT_EXTERNAL=ON",
      "cmake --build build"
    ],
    "package": [
      "DESTDIR=$DESTDIR cmake --install build"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "deepin/spdlog.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "url": [
    "https://github.com/gabime/spdlog/archive/refs/tags/v1.17.0.tar.gz"
  ]
}
