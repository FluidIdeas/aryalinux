{
  "name": "wingpanel-indicator-sound",
  "version": "8.0.3",
  "description": "Wingpanel sound indicator.",
  "category": "desktop-pantheon",
  "url": [
    "https://github.com/elementary/wingpanel-indicator-sound/archive/refs/tags/8.0.3.tar.gz"
  ],
  "dependencies": {
    "required": [
      "granite",
      "libcanberra",
      "pulseaudio",
      "wingpanel"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr -Dbuildtype=release  .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "pantheon/wingpanel-indicator-sound.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
