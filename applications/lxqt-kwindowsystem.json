{
  "name": "lxqt-kwindowsystem",
  "version": "6.23.0",
  "description": "",
  "category": "",
  "dependencies": {
    "required": [
      "extra-cmake-modules",
      "plasma-wayland-protocols",
      "qt6",
      "x7lib"
    ]
  },
  "build": {
    "user": [
      "cmake -B build -D CMAKE_INSTALL_PREFIX=/usr \\\n      -D CMAKE_BUILD_TYPE=Release  \\\n      -D BUILD_TESTING=OFF         \\\n      -W no-dev .",
      "make -C build"
    ],
    "package": [
      "make -C build install DESTDIR=$DESTDIR"
    ]
  },
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "meta": false,
  "book": "lxqt/lxqt-kwindowsystem.html",
  "url": [
    "https://download.kde.org/stable/frameworks/6.23/kwindowsystem-6.23.0.tar.xz"
  ]
}
