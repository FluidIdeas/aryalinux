{
  "name": "yelp",
  "version": "49.0",
  "description": "The Yelp package contains a help browser used for viewing help files.",
  "url": [
    "https://download.gnome.org/sources/yelp/49/yelp-49.0.tar.xz"
  ],
  "dependencies": {
    "required": [
      "desktop-file-utils",
      "gsettings-desktop-schemas",
      "libadwaita",
      "webkitgtk",
      "yelp-xsl"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr --buildtype=release .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [
    "update-desktop-database -q"
  ],
  "meta": false,
  "book": "gnome/yelp.html",
  "category": "desktop-gnome",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
