{
  "name": "gtkmm4",
  "version": "4.20.0",
  "description": "",
  "category": "",
  "dependencies": {
    "required": [
      "gtk4",
      "pangomm2"
    ]
  },
  "build": {
    "user": [
      "mkdir build",
      "cd    build",
      "meson setup --prefix=/usr --buildtype=release ..",
      "ninja",
      "mv -v /usr/share/doc/gtkmm-4.0 /usr/share/doc/gtkmm-4.20.0"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja install"
    ]
  },
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "meta": false,
  "book": "x/gtkmm4.html",
  "url": [
    "https://download.gnome.org/sources/gtkmm/4.20/gtkmm-4.20.0.tar.xz"
  ]
}
