{
  "name": "deepin-draw",
  "version": "6.5.41",
  "description": "A lightweight drawing tool for Linux Deepin (Deepin Desktop Environment).",
  "category": "desktop-deepin",
  "dependencies": {
    "required": [
      "deepin-picker",
      "dtk6core",
      "dtk6gui",
      "dtk6widget",
      "hicolor-icon-theme",
      "qt6"
    ]
  },
  "build": {
    "user": [
      "make"
    ],
    "package": [
      "make DESTDIR=$DESTDIR install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "deepin/deepin-draw.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "url": [
    "https://github.com/linuxdeepin/deepin-draw/archive/refs/tags/6.5.41.tar.gz"
  ]
}
