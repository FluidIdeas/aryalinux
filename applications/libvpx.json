{
  "name": "libvpx",
  "version": "1.16.0",
  "description": "This package, from the WebM project, provides the reference implementations of the VP8 Codec (used in most current HTML5 video) and of the next-generation VP9 Codec.",
  "url": [
    "https://github.com/webmproject/libvpx/archive/v1.16.0/libvpx-1.16.0.tar.gz"
  ],
  "dependencies": {
    "required": [
      "yasm",
      "which"
    ]
  },
  "build": {
    "user": [
      "find -type f | xargs touch",
      "patch -Np1 -i ../libvpx-1.16.0-security_fix-1.patch",
      "sed -i 's/cp -p/cp/' build/make/Makefile",
      "mkdir libvpx-build",
      "(cd libvpx-build && ../configure --prefix=/usr    \\\n             --enable-shared  \\\n             --disable-static && make)"
    ],
    "package": [
      "make -C libvpx-build install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "multimedia/libvpx.html",
  "category": "multimedia",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "additionalUrls": [
    "https://www.linuxfromscratch.org/patches/blfs/13.0/libvpx-1.16.0-security_fix-1.patch"
  ]
}
