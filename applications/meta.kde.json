{
  "name": "meta.kde",
  "version": "1.0",
  "description": "Metapackage that installs KDE Frameworks 6, Plasma, and applications listed in the BLFS KDE chapters.",
  "category": "metapackage",
  "dependencies": {
    "required": [
      "ark",
      "breeze-icons",
      "dejavu-fonts-ttf",
      "dolphin",
      "dolphin-plugins",
      "extra-cmake-modules",
      "frameworks6",
      "graphics-session-tools",
      "gtk3",
      "gwenview",
      "hicolor-icon-theme",
      "k3b",
      "kddockwidgets",
      "kdenlive",
      "kde-poppler",
      "khelpcenter",
      "kio-extras",
      "kirigami-addons",
      "kmix",
      "konsole",
      "konversation",
      "kquickimageeditor",
      "libkcddb",
      "libkdcraw",
      "libkexiv2",
      "libnotify",
      "nouveau-firmware",
      "okular",
      "oxygen-icons",
      "phonon",
      "phonon-backend-vlc",
      "plasma-all",
      "plasma-graphics-tools",
      "plasma-wayland-protocols",
      "polkit-qt",
      "pulseaudio-qt",
      "qt6",
      "qtkeychain",
      "qtwebengine",
      "udisks2",
      "xdg-desktop-portal-kde",
      "xdg-user-dirs"
    ]
  },
  "build": {},
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "meta": true
}
