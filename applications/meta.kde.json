{
  "name": "meta.kde",
  "version": "1.0",
  "description": "Metapackage that installs the KDE Plasma desktop environment and selected applications.",
  "url": "",
  "dependencies": {
    "required": [
      "gtk2",
      "gtk3",
      "gconf",
      "pulseaudio",
      "qt5",
      "extra-cmake-modules",
      "phonon",
      "phonon-backend-gstreamer",
      "polkit-qt",
      "libdbusmenu-qt",
      "frameworks5",
      "fftw",
      "plasma-all",
      "ark5",
      "kdenlive",
      "kmix5",
      "khelpcenter",
      "konsole5",
      "lightdm",
      "libnotify",
      "udisks2",
      "dolphin",
      "dolphin-plugins",
      "kcalc",
      "gwenview5",
      "aryalinux-gtk-themes",
      "aryalinux-google-fonts",
      "aryalinux-wallpapers",
      "aryalinux-icons"
    ]
  },
  "build": {},
  "meta": true,
  "category": "metapackage",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
