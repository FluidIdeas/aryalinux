{
  "name": "gjs",
  "version": "1.86.0",
  "description": "Gjs is a set of Javascript bindings for GNOME.",
  "url": [
    "https://download.gnome.org/sources/gjs/1.86/gjs-1.86.0.tar.xz"
  ],
  "dependencies": {
    "required": [
      "cairo",
      "dbus",
      "glib2",
      "spidermonkey"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr          \\\n            --buildtype=release    \\\n            --wrap-mode=nofallback \\\n            .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "gnome/gjs.html",
  "category": "desktop-gnome",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
