{
  "name": "gjs",
  "version": "1.86.0",
  "description": "Gjs is a set of Javascript bindings for GNOME.",
  "url": "https://download.gnome.org/sources/gjs/1.86/gjs-1.86.0.tar.xz",
  "dependencies": {
    "required": [
      "cairo",
      "glib2",
      "spidermonkey"
    ]
  },
  "build": {
    "user": [
      "mkdir gjs-build",
      "cd    gjs-build",
      "meson setup --prefix=/usr          \\\n            --buildtype=release    \\\n            --wrap-mode=nofallback \\\n            ..",
      "ninja"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja install"
    ]
  },
  "meta": false,
  "book": "gnome/gjs.html",
  "category": "desktop-gnome",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
