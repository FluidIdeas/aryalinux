{
  "name": "gimp",
  "version": "3.0.6",
  "description": "The Gimp package contains the GNU Image Manipulation Program which is useful for photo retouching, image composition and image authoring.",
  "url": [
    "https://download.gimp.org/gimp/v3.0/gimp-3.0.6.tar.xz",
    "https://download.gimp.org/pub/gimp/help/gimp-help-3.0.2.tar.bz2"
  ],
  "dependencies": {
    "required": [
      "appstream",
      "gegl",
      "gexiv2",
      "gtk3",
      "harfbuzz",
      "libxml2",
      "lcms2",
      "poppler",
      "graphviz",
      "iso-codes",
      "python-modules.pygobject3",
      "xdg-utils"
    ]
  },
  "build": {
    "user": [
      "patch -Np1 -i ../gimp-3.0.6-security_fixes-1.patch",
      "meson setup gimp-build --prefix=/usr       \\\n      --buildtype=release \\\n      -D headless-tests=disabled .",
      "ninja -C gimp-build",
      "tar -xf ../gimp-help-3.0.2.tar.bz2",
      "(cd gimp-help-3.0.2 && sed -i 's/import libxml2//' configure && ALL_LINGUAS=\"en\" ./configure --prefix=/usr && make)"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C gimp-build install",
      "(cd gimp-help-3.0.2 && make install DESTDIR=$DESTDIR)",
      "chown -R root:root $DESTDIR/usr/share/gimp/3.0/help"
    ]
  },
  "post_install": [
    "gtk-update-icon-cache -qtf /usr/share/icons/hicolor",
    "update-desktop-database -q"
  ],
  "meta": false,
  "book": "xsoft/gimp.html",
  "category": "applications",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "additionalUrls": [
    "https://www.linuxfromscratch.org/patches/blfs/13.0/gimp-3.0.6-security_fixes-1.patch"
  ]
}
