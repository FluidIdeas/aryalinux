{
  "name": "gsettings-desktop-schemas",
  "version": "49.1",
  "description": "The GSettings Desktop Schemas package contains a collection of GSettings schemas for settings shared by various components of a GNOME Desktop.",
  "url": [
    "https://download.gnome.org/sources/gsettings-desktop-schemas/49/gsettings-desktop-schemas-49.1.tar.xz"
  ],
  "dependencies": {
    "required": [
      "glib2"
    ]
  },
  "build": {
    "user": [
      "sed -i -r 's:\"(/system):\"/org/gnome\\1:g' schemas/*.in",
      "meson setup build --prefix=/usr --buildtype=release .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [
    "glib-compile-schemas /usr/share/glib-2.0/schemas"
  ],
  "meta": false,
  "book": "gnome/gsettings-desktop-schemas.html",
  "category": "desktop-gnome",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
