{
  "name": "gnome-logs",
  "version": "45.0",
  "description": "The GNOME Logs package contains a log viewer for the systemd journal.",
  "url": [
    "https://download.gnome.org/sources/gnome-logs/45/gnome-logs-45.0.tar.xz"
  ],
  "dependencies": {
    "required": [
      "gsettings-desktop-schemas",
      "gtk4",
      "itstool",
      "libadwaita"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr --buildtype=release .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "gnome/gnome-logs.html",
  "category": "desktop-gnome",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
