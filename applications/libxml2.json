{
  "name": "libxml2",
  "version": "2.15.1",
  "description": "The libxml2 package contains libraries and utilities used for parsing XML files.",
  "url": "https://download.gnome.org/sources/libxml2/2.15/libxml2-2.15.1.tar.xz",
  "dependencies": {
    "required": [
      "icu"
    ]
  },
  "build": {
    "user": [
      "sed -i \"/'git'/,+3d\" meson.build",
      "mkdir build",
      "cd    build",
      "meson setup ..           \\\n      --prefix=/usr      \\\n      -D history=enabled \\\n      -D icu=enabled",
      "ninja",
      "sed -e \"/^dir_doc/s/\\$/ + '-' + meson.project_version()/\" \\\n    -i ../meson.build",
      "meson configure -D docs=enabled",
      "ninja",
      "tar xf ../../xmlts20130923.tar.gz -C ..",
      "systemctl stop httpd.service",
      "sed \"s/--static/--shared/\" -i /usr/bin/xml2-config"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja install"
    ]
  },
  "meta": false,
  "book": "general/libxml2.html",
  "category": "libraries",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
