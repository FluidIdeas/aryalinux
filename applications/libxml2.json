{
  "name": "libxml2",
  "version": "2.15.1",
  "description": "The libxml2 package contains libraries and utilities used for parsing XML files.",
  "url": "https://download.gnome.org/sources/libxml2/2.15/libxml2-2.15.1.tar.xz",
  "dependencies": {
    "required": [
      "icu"
    ]
  },
  "build": {
    "user": [
      "sed -i \"/'git'/,+3d\" meson.build",
      "meson setup build --prefix=/usr      \\\n      -D history=enabled \\\n      -D icu=enabled .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install",
      "sed \"s/--static/--shared/\" -i $DESTDIR/usr/bin/xml2-config"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "general/libxml2.html",
  "category": "libraries",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
