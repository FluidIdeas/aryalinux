{
  "name": "gnome-disk-utility",
  "version": "46.1",
  "description": "The GNOME Disk Utility package provides applications used for dealing with storage devices.",
  "url": [
    "https://download.gnome.org/sources/gnome-disk-utility/46/gnome-disk-utility-46.1.tar.xz"
  ],
  "dependencies": {
    "required": [
      "gnome-settings-daemon",
      "itstool",
      "libpwquality",
      "udisks2"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr --buildtype=release .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "gnome/gnome-disk-utility.html",
  "category": "desktop-gnome",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
