{
  "name": "gnome-disk-utility",
  "version": "46.1",
  "description": "The GNOME Disk Utility package provides applications used for dealing with storage devices.",
  "url": "https://download.gnome.org/sources/gnome-disk-utility/46/gnome-disk-utility-46.1.tar.xz",
  "dependencies": {
    "required": [
      "gnome-settings-daemon",
      "itstool",
      "libpwquality",
      "udisks2"
    ]
  },
  "build": {
    "user": [
      "mkdir build",
      "cd    build",
      "meson setup --prefix=/usr --buildtype=release ..",
      "ninja"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja install"
    ]
  },
  "meta": false,
  "book": "gnome/gnome-disk-utility.html",
  "category": "desktop-gnome",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
