{
  "name": "perl-deps.perl-datetime-timezone",
  "version": "2.66",
  "description": "Perl module perl::datetime::timezone providing build-time or runtime support for other Perl packages.",
  "url": [
    "https://cpan.metacpan.org/authors/id/D/DR/DROLSKY/DateTime-TimeZone-2.66.tar.gz"
  ],
  "dependencies": {
    "required": [
      "perl-deps.perl-class-singleton",
      "perl-deps.perl-module-runtime",
      "perl-deps.perl-params-validationcompiler",
      "perl-deps.perl-test-fatal",
      "perl-deps.perl-test-requires"
    ]
  },
  "build": {
    "user": [
      "perl Makefile.PL",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "general/perl-deps.html",
  "category": "perl-dependency",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
