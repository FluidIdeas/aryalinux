{
  "name": "glu",
  "version": "9.0.3",
  "description": "This package provides the Mesa OpenGL Utility library.",
  "url": "https://archive.mesa3d.org/glu/glu-9.0.3.tar.xz",
  "dependencies": {
    "required": [
      "mesa"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=$XORG_PREFIX \\\n      --buildtype=release   \\\n      -D gl_provider=gl     \\\n      -D default_library=shared .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "x/glu.html",
  "category": "x11",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
