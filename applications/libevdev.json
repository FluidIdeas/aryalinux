{
  "name": "libevdev",
  "version": "1.13.6",
  "description": "The libevdev package contains common functions for Xorg input drivers.",
  "url": [
    "https://www.freedesktop.org/software/libevdev/libevdev-1.13.6.tar.xz",
    "https://www.x.org/pub/individual/driver/xf86-input-evdev-2.11.0.tar.xz",
    "https://gitlab.freedesktop.org/libinput/libinput/-/archive/1.31.0/libinput-1.31.0.tar.gz",
    "https://www.x.org/pub/individual/driver/xf86-input-libinput-1.5.0.tar.xz",
    "https://www.x.org/pub/individual/driver/xf86-input-synaptics-1.10.0.tar.xz",
    "https://github.com/linuxwacom/xf86-input-wacom/releases/download/xf86-input-wacom-1.2.4/xf86-input-wacom-1.2.4.tar.bz2"
  ],
  "dependencies": {},
  "build": {
    "user": [
      "meson setup build --prefix=$XORG_PREFIX     \\\n      --buildtype=release       \\\n      -D documentation=disabled \\\n      -D tests=disabled         \\\n      .",
      "ninja -C build"
    ],
    "environment": {
      "XORG_PREFIX": "/usr"
    },
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "x/x7driver.html",
  "category": "x11",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
