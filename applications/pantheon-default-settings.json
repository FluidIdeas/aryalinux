{
  "name": "pantheon-default-settings",
  "version": "8.1.1",
  "description": "Default dconf settings for Pantheon.",
  "category": "desktop-pantheon",
  "url": [
    "https://github.com/elementary/default-settings/archive/refs/tags/8.1.1.tar.gz"
  ],
  "dependencies": {
    "required": [
      "accountsservice",
      "dbus",
      "dconf",
      "polkit"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr -Dbuildtype=release  .",
      "ninja -C build"
    ],
    "package": [
      "rm -f $DESTDIR/usr/share/cups/data/default-testpage.pdf",
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "pantheon/pantheon-default-settings.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
