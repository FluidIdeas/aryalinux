{
  "name": "gtksourceview",
  "version": "3.24.11",
  "description": "The GtkSourceView package contains libraries used for extending the GTK+ text functions to include syntax highlighting.",
  "url": "https://download.gnome.org/sources/gtksourceview/3.24/gtksourceview-3.24.11.tar.xz",
  "dependencies": {
    "required": [
      "gtk3",
      "glib2"
    ]
  },
  "build": {
    "user": [
      "sed -e 's/g_object_ref (buffer)/g_object_ref (GTK_SOURCE_BUFFER (buffer))/' \\\n    -i gtksourceview/gtksourceview.c",
      "./configure --prefix=/usr",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "meta": false,
  "book": "x/gtksourceview.html",
  "category": "x11",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
