{
  "name": "perl-deps.perl-file-copy-recursive",
  "version": "0.45",
  "description": "Perl module perl::file::copy::recursive providing build-time or runtime support for other Perl packages.",
  "url": [
    "https://cpan.metacpan.org/authors/id/D/DM/DMUEY/File-Copy-Recursive-0.45.tar.gz"
  ],
  "dependencies": {
    "required": [
      "perl-deps.perl-path-tiny",
      "perl-deps.perl-test-deep",
      "perl-deps.perl-test-fatal",
      "perl-deps.perl-test-file",
      "perl-deps.perl-test-warnings"
    ]
  },
  "build": {
    "user": [
      "perl Makefile.PL",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "general/perl-deps.html",
  "category": "perl-dependency",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
