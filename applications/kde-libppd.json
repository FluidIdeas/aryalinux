{
  "name": "kde-libppd",
  "version": "2.1.1",
  "description": "libppd built against kde-libcupsfilters. Do not install alongside gnome-libppd.",
  "category": "printing",
  "dependencies": {
    "required": [
      "kde-libcupsfilters"
    ]
  },
  "build": {
    "user": [
      "./configure --prefix=/usr                \\\n            --disable-static             \\\n            --with-cups-rundir=/run/cups \\\n            --enable-ppdc-utils          \\\n            --docdir=/usr/share/doc/libppd-2.1.1",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "meta": false,
  "book": "pst/libppd.html",
  "url": [
    "https://github.com/OpenPrinting/libppd/releases/download/2.1.1/libppd-2.1.1.tar.xz"
  ]
}
