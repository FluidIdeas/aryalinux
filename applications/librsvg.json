{
  "name": "librsvg",
  "version": "2.61.4",
  "description": "The librsvg package contains a library and tools used to manipulate, convert and view Scalable Vector Graphic (SVG) images.",
  "url": [
    "https://download.gnome.org/sources/librsvg/2.61/librsvg-2.61.4.tar.xz"
  ],
  "dependencies": {
    "required": [
      "cairo",
      "pango",
      "cargo-c"
    ],
    "recommended": [
      "gdk-pixbuf",
      "glib2",
      "vala"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr --buildtype=release .",
      "ninja -C build",
      "meson test -C build -v"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "general/librsvg.html",
  "category": "graphics",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
