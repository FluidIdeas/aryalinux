{
  "name": "libdaemon",
  "version": "0.14",
  "description": "The libdaemon package is a lightweight C library that eases the writing of UNIX daemons.",
  "url": [
    "https://0pointer.de/lennart/projects/libdaemon/libdaemon-0.14.tar.gz"
  ],
  "dependencies": {},
  "build": {
    "user": [
      "./configure --prefix=/usr --disable-static",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "general/libdaemon.html",
  "category": "libraries",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
