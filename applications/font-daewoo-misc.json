{
  "name": "font-daewoo-misc",
  "version": "1.0.4",
  "description": "Xorg legacy font-daewoo-misc (BLFS x7legacy chapter).",
  "url": [
    "https://xorg.freedesktop.org/archive/individual/font/font-daewoo-misc-1.0.4.tar.xz"
  ],
  "dependencies": {
    "required": [
      "font-jis-misc"
    ]
  },
  "build": {
    "environment": {
      "XORG_PREFIX": "/usr",
      "XORG_CONFIG": "--prefix=/usr --sysconfdir=/etc --localstatedir=/var --disable-static"
    },
    "user": [
      "./configure $XORG_CONFIG",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "x/font-daewoo-misc.html",
  "category": "x11",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
