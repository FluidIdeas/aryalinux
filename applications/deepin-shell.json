{
  "name": "deepin-shell",
  "version": "2.0.44",
  "description": "New DDE shell (Deepin Desktop Environment).",
  "category": "desktop-deepin",
  "dependencies": {
    "required": [
      "deepin-application-manager",
      "deepin-tray-loader",
      "dtk6core",
      "dtk6declarative",
      "dtk6gui",
      "dtk6widget",
      "icu",
      "qt6",
      "wayland",
      "xcb-util-wm",
      "yaml-cpp"
    ]
  },
  "build": {
    "user": [
      "sed -i '/target_compile_definitions(dde-shell-dock PRIVATE DS_LIB)/d' panels/dock/frame/CMakeLists.txt",
      "cmake . -GNinja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_INSTALL_LIBEXECDIR=lib -DCMAKE_INSTALL_SYSCONFDIR=/etc ",
      "ninja"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "deepin/deepin-shell.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "url": [
    "https://github.com/linuxdeepin/dde-shell/archive/refs/tags/2.0.44.tar.gz"
  ]
}
