{
  "name": "dtkwidget",
  "version": "1:6.7.42",
  "description": "DTK widgets library (Qt5 build) for Deepin Desktop Environment.",
  "category": "desktop-deepin",
  "dependencies": {
    "required": [
      "dtkcore",
      "dtkgui",
      "gsettings-qt5",
      "qt5-base",
      "qt5-imageformats",
      "qt5-svg",
      "qt5-x11extras",
      "startup-notification",
      "xcb-util"
    ]
  },
  "build": {
    "user": [
      "cmake . -Bbuild-qt5 -GNinja -DDTK5=ON -DBUILD_DOCS=OFF -DBUILD_PLUGINS=OFF -DBUILD_TESTING=OFF -DMKSPECS_INSTALL_DIR=lib/qt/mkspecs/modules -DQCH_INSTALL_DESTINATION=share/doc/qt -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_INSTALL_LIBEXECDIR=lib -DCMAKE_INSTALL_PREFIX=/usr",
      "cmake --build build-qt5"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build-qt5 install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "deepin/dtkwidget.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "url": [
    "https://github.com/linuxdeepin/dtkwidget/archive/refs/tags/6.7.42.tar.gz"
  ]
}
