{
  "name": "kde-libcupsfilters",
  "version": "2.1.1",
  "description": "libcupsfilters built against kde-poppler (Qt6 PDF bindings). Do not install alongside gnome-libcupsfilters.",
  "category": "printing",
  "dependencies": {
    "required": [
      "TTF-and-OTF-fonts",
      "kde-cups",
      "glib2",
      "kde-gs",
      "kde-poppler",
      "lcms2",
      "libexif",
      "libjpeg",
      "libpng",
      "libtiff",
      "qpdf"
    ]
  },
  "build": {
    "user": [
      "patch -Np1 -i ../libcupsfilters-2.1.1-security_fixes-1.patch",
      "./configure --prefix=/usr    \\\n            --disable-static \\\n            --docdir=/usr/share/doc/libcupsfilters-2.1.1",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "meta": false,
  "book": "pst/libcupsfilters.html",
  "url": [
    "https://github.com/OpenPrinting/libcupsfilters/releases/download/2.1.1/libcupsfilters-2.1.1.tar.xz"
  ],
  "additionalUrls": [
    "https://www.linuxfromscratch.org/patches/blfs/13.0/libcupsfilters-2.1.1-security_fixes-1.patch"
  ]
}
