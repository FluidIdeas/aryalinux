{
  "name": "libcloudproviders",
  "version": "0.3.6",
  "description": "The libcloudproviders package contains a library which provides a DBus API that allows cloud storage sync clients to expose their services.",
  "url": [
    "https://download.gnome.org/sources/libcloudproviders/0.3/libcloudproviders-0.3.6.tar.xz"
  ],
  "dependencies": {
    "required": [
      "glib2",
      "vala"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr --buildtype=release .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "general/libcloudproviders.html",
  "category": "libraries",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
