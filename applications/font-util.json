{
  "name": "font-util",
  "version": "1.4.1",
  "description": "Xorg font font-util (BLFS chapter).",
  "url": [
    "https://xorg.freedesktop.org/archive/individual/font/font-util-1.4.1.tar.xz"
  ],
  "dependencies": {
    "required": [
      "xcursor-themes"
    ]
  },
  "build": {
    "environment": {
      "XORG_PREFIX": "/usr",
      "XORG_CONFIG": "--prefix=/usr --sysconfdir=/etc --localstatedir=/var --disable-static"
    },
    "user": [
      "./configure $XORG_CONFIG",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "x/font-util.html",
  "category": "x11",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
