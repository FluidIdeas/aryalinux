{
  "name": "python-modules.pytest",
  "version": "9.0.2",
  "description": "Python module pytest for scripts and applications that depend on it.",
  "url": [
    "https://files.pythonhosted.org/packages/source/p/pytest/pytest-9.0.2.tar.gz"
  ],
  "dependencies": {
    "required": [
      "python-deps.iniconfig",
      "python-deps.setuptools_scm"
    ]
  },
  "build": {
    "user": [
      "pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD"
    ],
    "package": [
      "pip3 install --root=$DESTDIR --no-index --find-links dist --no-user pytest"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "general/python-modules.html",
  "category": "python-module",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
