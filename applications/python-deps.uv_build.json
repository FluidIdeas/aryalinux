{
  "name": "python-deps.uv_build",
  "version": "0.10.2",
  "description": "Python package uv_build required as a dependency of other Python modules.",
  "url": [
    "https://files.pythonhosted.org/packages/source/u/uv_build/uv_build-0.10.2.tar.gz"
  ],
  "dependencies": {},
  "build": {
    "user": [
      "pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD"
    ],
    "package": [
      "pip3 install --root=$DESTDIR --no-index --find-links dist --no-user uv_build"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "general/python-dependencies.html",
  "category": "python-dependency",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
