{
  "name": "xfce4-settings",
  "version": "4.20.3",
  "description": "The Xfce4 Settings package contains a collection of programs that are useful for adjusting your Xfce preferences.",
  "url": [
    "https://archive.xfce.org/src/xfce/xfce4-settings/4.20/xfce4-settings-4.20.3.tar.bz2"
  ],
  "dependencies": {
    "required": [
      "exo",
      "garcon",
      "libcanberra",
      "libxklavier"
    ]
  },
  "build": {
    "user": [
      "./configure --prefix=/usr --sysconfdir=/etc",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [
    "gtk-update-icon-cache -qtf /usr/share/icons/hicolor",
    "update-desktop-database -q",
    "update-mime-database /usr/share/mime"
  ],
  "meta": false,
  "book": "xfce/xfce4-settings.html",
  "category": "desktop-xfce",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
