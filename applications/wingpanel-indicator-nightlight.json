{
  "name": "wingpanel-indicator-nightlight",
  "version": "2.1.3",
  "description": "Wingpanel night light indicator.",
  "category": "desktop-pantheon",
  "url": [
    "https://github.com/elementary/wingpanel-indicator-nightlight/archive/refs/tags/2.1.3.tar.gz"
  ],
  "dependencies": {
    "required": [
      "wingpanel"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr -Dbuildtype=release  .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "pantheon/wingpanel-indicator-nightlight.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
