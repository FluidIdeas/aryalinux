{
  "name": "gnome-keyring",
  "version": "48.0",
  "description": "The GNOME Keyring package contains a daemon that keeps passwords and other secrets for users.",
  "url": "https://download.gnome.org/sources/gnome-keyring/48/gnome-keyring-48.0.tar.xz",
  "dependencies": {
    "required": [
      "dbus",
      "gcr",
      "linux-pam"
    ]
  },
  "build": {
    "user": [
      "sed -i 's:\"/desktop:\"/org:' schema/*.xml",
      "meson setup build-gkr --prefix=/usr --buildtype=release .",
      "ninja -C build-gkr"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build-gkr install"
    ]
  },
  "post_install": [
    "glib-compile-schemas /usr/share/glib-2.0/schemas"
  ],
  "meta": false,
  "book": "gnome/gnome-keyring.html",
  "category": "desktop-gnome",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
