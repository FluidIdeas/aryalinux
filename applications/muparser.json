{
  "name": "muparser",
  "version": "2.3.5",
  "description": "The muparser package is a fast math parser library for C and C++.",
  "url": [
    "https://github.com/beltoforion/muparser/archive/v2.3.5/muparser-2.3.5.tar.gz"
  ],
  "dependencies": {
    "required": [
      "cmake"
    ]
  },
  "build": {
    "user": [
      "cmake -B build -D CMAKE_INSTALL_PREFIX=/usr \\\n      -D CMAKE_BUILD_TYPE=Release  \\\n      .",
      "make -C build"
    ],
    "package": [
      "make -C build install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "lxqt/muparser.html",
  "category": "desktop-lxqt",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
