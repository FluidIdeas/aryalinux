{
  "name": "pantheon-camera",
  "version": "8.0.2",
  "description": "Pantheon camera.",
  "category": "applications",
  "url": [
    "https://github.com/elementary/camera/archive/refs/tags/8.0.2.tar.gz"
  ],
  "dependencies": {
    "required": [
      "glib2",
      "granite7",
      "gstreamer10",
      "gtk4"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr -Dbuildtype=release  .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "pantheon/pantheon-camera.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
