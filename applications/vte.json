{
  "name": "vte",
  "version": "0.82.3",
  "description": "The VTE package contains a virtual terminal widget for GTK applications.",
  "url": [
    "https://gitlab.gnome.org/GNOME/vte/-/archive/0.82.3/vte-0.82.3.tar.gz"
  ],
  "dependencies": {
    "required": [
      "libxml2",
      "fast_float",
      "icu",
      "gnutls",
      "gtk3",
      "vala"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr --buildtype=release -D docs=false .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install",
      "rm -v $DESTDIR/etc/profile.d/vte.*"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "gnome/vte.html",
  "category": "desktop-gnome",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
