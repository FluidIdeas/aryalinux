{
  "name": "xdg-utils",
  "version": "1.2.1",
  "description": "xdg-utils is a set of command line tools that assist applications with a variety of desktop integration tasks. It is required for Linux Standards Base (LSB) conformance.",
  "url": [
    "https://gitlab.freedesktop.org/xdg/xdg-utils/-/archive/v1.2.1/xdg-utils-v1.2.1.tar.gz"
  ],
  "dependencies": {
    "required": [
      "docbook",
      "links",
      "lynx",
      "xmlto"
    ]
  },
  "build": {
    "environment": {
      "XML_CATALOG_FILES": "/etc/xml/catalog"
    },
    "user": [
      "./configure --prefix=/usr",
      "make -C scripts scripts XMLTO='xmlto --skip-validation'"
    ],
    "package": [
      "make -C scripts install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "xsoft/xdg-utils.html",
  "category": "applications",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
