{
  "name": "deepin-qt-dbus-factory",
  "version": "6.0.1",
  "description": "A repository stores auto-generated Qt5 dbus code (libdframeworkdbus) (Deepin Desktop Environment).",
  "category": "desktop-deepin",
  "dependencies": {
    "required": [
      "qt5-base"
    ]
  },
  "build": {
    "user": [
      "make"
    ],
    "package": [
      "make DESTDIR=$DESTDIR install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "deepin/deepin-qt-dbus-factory.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "url": [
    "https://github.com/linuxdeepin/deepin-qt-dbus-factory/archive/refs/tags/6.0.1.tar.gz"
  ]
}
