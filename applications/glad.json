{
  "name": "glad",
  "version": "2.0.8",
  "description": "",
  "category": "",
  "dependencies": {},
  "build": {
    "user": [
      "pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD"
    ],
    "package": [
      "pip3 install --root=$DESTDIR --no-index --find-links dist --no-user glad2"
    ]
  },
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "meta": false,
  "book": "general/glad.html",
  "url": [
    "https://github.com/Dav1dde/glad/archive/v2.0.8/glad-2.0.8.tar.gz"
  ]
}
