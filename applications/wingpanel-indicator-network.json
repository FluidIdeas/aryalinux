{
  "name": "wingpanel-indicator-network",
  "version": "8.0.1",
  "description": "Wingpanel network indicator.",
  "category": "desktop-pantheon",
  "url": [
    "https://github.com/elementary/wingpanel-indicator-network/archive/refs/tags/8.0.1.tar.gz"
  ],
  "dependencies": {
    "required": [
      "granite",
      "libnma",
      "networkmanager",
      "wingpanel"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr -Dbuildtype=release  .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "pantheon/wingpanel-indicator-network.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
