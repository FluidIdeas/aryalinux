{
  "name": "sdl12-compat",
  "version": "1.2.68",
  "description": "sdl12-compat provides SDL 1.2 compatibility using SDL 2.0.",
  "category": "multimedia",
  "dependencies": {
    "required": [
      "alsa-lib",
      "desktop-file-utils",
      "ffmpeg",
      "installing",
      "liba52",
      "libgcrypt",
      "libmad",
      "lua",
      "qt6"
    ]
  },
  "build": {
    "user": [
      "cmake -B build -D CMAKE_INSTALL_PREFIX=/usr \\\n      -D CMAKE_BUILD_TYPE=Release  \\\n      -D BUILD_SHARED_LIBS=ON      \\\n      -G Ninja .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "meta": false,
  "book": "multimedia/vlc.html",
  "url": [
    "https://github.com/libsdl-org/sdl12-compat/archive/refs/tags/release-1.2.68.tar.gz"
  ],
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
