{
  "name": "opensp",
  "version": "1.5.2",
  "description": "The OpenSP package contains a C++ library for using SGML/XML files. This is useful for validating, parsing and manipulating SGML and XML documents.",
  "url": "https://downloads.sourceforge.net/openjade/OpenSP-1.5.2.tar.gz",
  "patches": [
    "https://www.linuxfromscratch.org/patches/blfs/13.0/OpenSP-1.5.2-gcc14-1.patch"
  ],
  "dependencies": {
    "required": [
      "sgml-common"
    ]
  },
  "build": {
    "pre": [
      "patch -Np1 -i ../OpenSP-1.5.2-gcc14-1.patch"
    ],
    "user": [
      "sed -i 's/32,/253,/' lib/Syntax.cxx",
      "sed -i 's/LITLEN          240 /LITLEN          8092/'    \\\n    unicode/{gensyntax.pl,unicode.syn}",
      "./configure --prefix=/usr                                \\\n            --disable-static                             \\\n            --disable-doc-build                          \\\n            --enable-default-catalog=/etc/sgml/catalog   \\\n            --enable-http                                \\\n            --enable-default-search-path=/usr/share/sgml",
      "make pkgdatadir=/usr/share/sgml/OpenSP-1.5.2"
    ],
    "package": [
      "make pkgdatadir=$DESTDIR/usr/share/sgml/OpenSP-1.5.2 \\\n     docdir=$DESTDIR/usr/share/doc/OpenSP-1.5.2      \\\n     install DESTDIR=$DESTDIR",
      "ln -v -sf onsgmls $DESTDIR/usr/bin/nsgmls",
      "ln -v -sf osgmlnorm $DESTDIR/usr/bin/sgmlnorm",
      "ln -v -sf ospam $DESTDIR/usr/bin/spam",
      "ln -v -sf ospcat $DESTDIR/usr/bin/spcat",
      "ln -v -sf ospent $DESTDIR/usr/bin/spent",
      "ln -v -sf osx $DESTDIR/usr/bin/sx",
      "ln -v -sf osx $DESTDIR/usr/bin/sgml2xml",
      "ln -v -sf libosp.so $DESTDIR/usr/lib/libsp.so"
    ]
  },
  "meta": false,
  "book": "pst/opensp.html",
  "category": "printing",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
