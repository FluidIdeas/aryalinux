{
  "name": "deepin-compressor",
  "version": "6.5.30",
  "description": "A fast and lightweight application for creating and extracting archives (Deepin Desktop Environment).",
  "category": "desktop-deepin",
  "dependencies": {
    "required": [
      "7zip",
      "deepin-picker",
      "deepin-shortcut-viewer",
      "dtk6core",
      "dtk6gui",
      "dtk6widget",
      "glib2",
      "hicolor-icon-theme",
      "karchive",
      "kcodecs",
      "libarchive",
      "libzip",
      "qt6"
    ]
  },
  "build": {
    "user": [
      "cmake . -GNinja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_INSTALL_LIBEXECDIR=lib -DCMAKE_INSTALL_SYSCONFDIR=/etc ",
      "ninja"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "deepin/deepin-compressor.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "url": [
    "https://github.com/linuxdeepin/deepin-compressor/archive/refs/tags/6.5.30.tar.gz"
  ]
}
