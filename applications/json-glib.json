{
  "name": "json-glib",
  "version": "1.10.8",
  "description": "The JSON GLib package is a library providing serialization and deserialization support for the JavaScript Object Notation (JSON) format described by RFC 4627.",
  "url": [
    "https://download.gnome.org/sources/json-glib/1.10/json-glib-1.10.8.tar.xz"
  ],
  "dependencies": {
    "required": [
      "glib2"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr --buildtype=release \\\n      -D documentation=disabled -D man=false .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "general/json-glib.html",
  "category": "libraries",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
