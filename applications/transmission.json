{
  "name": "transmission",
  "version": "4.1.1",
  "description": "Transmission is a cross-platform, open source BitTorrent client. This is useful for downloading large files (such as Linux ISOs) and reduces the need for the distributors to provide server bandwidth.",
  "url": [
    "https://github.com/transmission/transmission/releases/download/4.1.1/transmission-4.1.1.tar.xz"
  ],
  "dependencies": {
    "required": [
      "curl",
      "gtkmm4",
      "libevent",
      "libpsl",
      "librsvg"
    ]
  },
  "build": {
    "user": [
      "cmake -B build -D CMAKE_INSTALL_PREFIX=/usr \\\n      -D CMAKE_BUILD_TYPE=Release  \\\n      .",
      "make -C build"
    ],
    "package": [
      "make -C build install DESTDIR=$DESTDIR",
      "install -vdm755 $DESTDIR/usr/share/pixmaps",
      "rsvg-convert                                                   \\\n   $DESTDIR/usr/share/icons/hicolor/scalable/apps/transmission-gtk.svg \\\n   -o $DESTDIR/usr/share/pixmaps/transmission.png"
    ]
  },
  "post_install": [
    "gtk-update-icon-cache -qtf /usr/share/icons/hicolor",
    "update-desktop-database -q"
  ],
  "meta": false,
  "book": "xsoft/transmission.html",
  "category": "applications",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
