{
  "name": "openjade",
  "version": "1.3.2",
  "description": "The OpenJade package contains a DSSSL engine. This is useful for SGML and XML transformations into RTF, TeX, SGML and XML.",
  "url": [
    "https://downloads.sourceforge.net/openjade/openjade-1.3.2.tar.gz",
    "https://versaweb.dl.sourceforge.net/project/openjade/openjade/1.3.2/openjade-1.3.2.tar.gz"
  ],
  "dependencies": {
    "required": [
      "opensp"
    ]
  },
  "build": {
    "user": [
      "patch -Np1 -i ../openjade-1.3.2-upstream-1.patch",
      "sed -i -e '/getopts/{N;s#&G#g#;s#do .getopts.pl.;##;}' \\\n       -e '/use POSIX/ause Getopt::Std;' msggen.pl",
      "export CXXFLAGS=\"${CXXFLAGS:--O2 -g} -fno-lifetime-dse\"",
      "./configure --prefix=/usr                                \\\n            --mandir=/usr/share/man                      \\\n            --enable-http                                \\\n            --disable-static                             \\\n            --enable-default-catalog=/etc/sgml/catalog   \\\n            --enable-default-search-path=/usr/share/sgml \\\n            --datadir=/usr/share/sgml/openjade-1.3.2",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR",
      "make install-man DESTDIR=$DESTDIR",
      "ln -v -sf openjade $DESTDIR/usr/bin/jade",
      "ln -v -sf libogrove.so $DESTDIR/usr/lib/libgrove.so",
      "ln -v -sf libospgrove.so $DESTDIR/usr/lib/libspgrove.so",
      "ln -v -sf libostyle.so $DESTDIR/usr/lib/libstyle.so",
      "install -v -m644 dsssl/catalog $DESTDIR/usr/share/sgml/openjade-1.3.2/",
      "install -v -m644 dsssl/*.{dtd,dsl,sgm}              \\\n    $DESTDIR/usr/share/sgml/openjade-1.3.2",
      "install-catalog --add $DESTDIR/etc/sgml/openjade-1.3.2.cat  \\\n    $DESTDIR/usr/share/sgml/openjade-1.3.2/catalog",
      "install-catalog --add $DESTDIR/etc/sgml/sgml-docbook.cat    \\\n    $DESTDIR/etc/sgml/openjade-1.3.2.cat",
      "echo \"SYSTEM \\\"http://www.oasis-open.org/docbook/xml/4.5/docbookx.dtd\\\" \\\n    \\\"/usr/share/xml/docbook/xml-dtd-4.5/docbookx.dtd\\\"\" >> \\\n    $DESTDIR/usr/share/sgml/openjade-1.3.2/catalog"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "pst/openjade.html",
  "category": "printing",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "additionalUrls": [
    "https://www.linuxfromscratch.org/patches/blfs/13.0/openjade-1.3.2-upstream-1.patch"
  ]
}
