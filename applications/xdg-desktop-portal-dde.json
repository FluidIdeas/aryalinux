{
  "name": "xdg-desktop-portal-dde",
  "version": "1.1.4",
  "description": "A backend implementation for xdg-desktop-portal on Deepin desktop environment (Deepin Desktop Environment).",
  "category": "desktop-deepin",
  "dependencies": {
    "required": [
      "dtk6core",
      "dtk6declarative",
      "dtk6widget",
      "libdrm",
      "mesa",
      "pipewire",
      "qt6",
      "wayland",
      "xdg-desktop-portal"
    ]
  },
  "build": {
    "user": [
      "cmake . -GNinja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_INSTALL_LIBEXECDIR=lib -DCMAKE_INSTALL_SYSCONFDIR=/etc ",
      "ninja"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "deepin/xdg-desktop-portal-dde.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "url": [
    "https://github.com/linuxdeepin/xdg-desktop-portal-dde/archive/refs/tags/1.1.4.tar.gz"
  ]
}
