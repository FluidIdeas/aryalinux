{
  "name": "deepin-system-monitor",
  "version": "6.5.42",
  "description": "A more user-friendly system monitor (Deepin Desktop Environment).",
  "category": "desktop-deepin",
  "dependencies": {
    "required": [
      "dconf",
      "deepin-service-manager",
      "dtk6core",
      "dtk6gui",
      "dtk6widget",
      "icu",
      "libcap",
      "libnl",
      "libpcap",
      "polkit-qt",
      "qt6",
      "systemd",
      "xcb-util-wm"
    ]
  },
  "build": {
    "user": [
      "cmake . -GNinja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_INSTALL_LIBEXECDIR=lib -DCMAKE_INSTALL_SYSCONFDIR=/etc ",
      "ninja"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "deepin/deepin-system-monitor.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "url": [
    "https://github.com/linuxdeepin/deepin-system-monitor/archive/refs/tags/6.5.42.tar.gz"
  ]
}
