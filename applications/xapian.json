{
  "name": "xapian",
  "version": "1.4.30",
  "description": "Xapian is an open source search engine library.",
  "url": "https://oligarchy.co.uk/xapian/1.4.30/xapian-core-1.4.30.tar.xz",
  "dependencies": {},
  "build": {
    "user": [
      "./configure --prefix=/usr --disable-static",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "general/xapian.html",
  "category": "libraries",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
