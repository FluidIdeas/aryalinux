{
  "name": "xfce4-session",
  "version": "4.20.3",
  "description": "Xfce4 Session is a session manager for Xfce. Its task is to save the state of your desktop (opened applications and their location) and restore it during a next startup. You can create several different sessions and choose one of them on startup.",
  "url": [
    "https://archive.xfce.org/src/xfce/xfce4-session/4.20/xfce4-session-4.20.3.tar.bz2"
  ],
  "dependencies": {
    "required": [
      "libwnck",
      "libxfce4ui",
      "desktop-file-utils",
      "xscreensaver",
      "polkit-gnome",
      "xfdesktop"
    ]
  },
  "build": {
    "user": [
      "./configure --prefix=/usr       \\\n            --sysconfdir=/etc   \\\n            --disable-legacy-sm",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [
    "gtk-update-icon-cache -qtf /usr/share/icons/hicolor",
    "update-desktop-database -q",
    "update-mime-database /usr/share/mime"
  ],
  "meta": false,
  "book": "xfce/xfce4-session.html",
  "category": "desktop-xfce",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
