{
  "name": "pantheon-shortcut-overlay",
  "version": "8.1.0",
  "description": "Keyboard shortcut overlay for Pantheon.",
  "category": "desktop-pantheon",
  "url": [
    "https://github.com/elementary/shortcut-overlay/archive/refs/tags/8.1.0.tar.gz"
  ],
  "dependencies": {
    "required": [
      "glib2",
      "granite7",
      "libgee",
      "pantheon-wayland"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr -Dbuildtype=release  .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "pantheon/pantheon-shortcut-overlay.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
