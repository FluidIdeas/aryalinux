{
  "name": "python-modules.pygobject3",
  "version": "3.54.5",
  "description": "Python module pygobject3 for scripts and applications that depend on it.",
  "url": [
    "https://download.gnome.org/sources/pygobject/3.54/pygobject-3.54.5.tar.gz"
  ],
  "dependencies": {
    "required": [
      "glib2",
      "python-modules.pycairo"
    ]
  },
  "build": {
    "user": [
      "mv -v tests/test_gdbus.py{,.nouse}",
      "mv -v tests/test_overrides_gtk.py{,.nouse}",
      "meson setup build --prefix=/usr --buildtype=release .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "general/python-modules.html",
  "category": "python-module",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
