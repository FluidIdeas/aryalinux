{
  "name": "cinnamon-desktop",
  "version": "6.6.2",
  "description": "Common API library for Cinnamon modules.",
  "category": "libraries",
  "url": [
    "https://github.com/linuxmint/cinnamon-desktop/archive/refs/tags/6.6.2.tar.gz"
  ],
  "dependencies": {
    "required": [
      "cairo",
      "dconf",
      "gdk-pixbuf",
      "glib2",
      "gtk3",
      "pulseaudio",
      "systemd"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr -Dbuildtype=release .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "cinnamon/cinnamon-desktop.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
