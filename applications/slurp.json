{
  "name": "slurp",
  "version": "1.5.0",
  "description": "Region selection tool for Wayland compositors.",
  "category": "applications",
  "url": [
    "https://github.com/emersion/slurp/releases/download/v1.5.0/slurp-1.5.0.tar.gz"
  ],
  "dependencies": {
    "required": [
      "cairo",
      "libxkbcommon",
      "wayland",
      "wayland-protocols"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr -Dbuildtype=release slurp-1.5.0",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "budgie/slurp.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
