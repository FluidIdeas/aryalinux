{
  "name": "guile",
  "version": "3.0.11",
  "description": "The Guile package contains the GNU Project's extension language library. Guile also contains a stand alone Scheme interpreter.",
  "url": "https://ftpmirror.gnu.org/guile/guile-3.0.11.tar.xz",
  "dependencies": {
    "required": [
      "gc",
      "libunistring"
    ]
  },
  "build": {
    "user": [
      "./configure --prefix=/usr --disable-static",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR",
      "mkdir -p $DESTDIR/usr/share/gdb/auto-load/usr/lib",
      "mv $DESTDIR/usr/lib/libguile-*-gdb.scm $DESTDIR/usr/share/gdb/auto-load/usr/lib/"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "general/guile.html",
  "category": "programming",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
