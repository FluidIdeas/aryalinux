{
  "name": "libtheora",
  "version": "1.2.0",
  "description": "libtheora is the reference implementation of the Theora video codec.",
  "category": "multimedia",
  "dependencies": {
    "required": [
      "alsa-lib",
      "desktop-file-utils",
      "ffmpeg",
      "installing",
      "liba52",
      "libgcrypt",
      "libmad",
      "lua",
      "qt6"
    ]
  },
  "build": {
    "user": [
      "./configure --prefix=/usr \\\n            --disable-static",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "meta": false,
  "book": "multimedia/vlc.html",
  "url": [
    "https://downloads.xiph.org/releases/theora/libtheora-1.2.0.tar.xz"
  ],
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
