{
  "name": "meta.xfce",
  "version": "1.0",
  "description": "Metapackage that installs the Xfce desktop environment and applications listed in the BLFS Xfce chapters.",
  "category": "metapackage",
  "dependencies": {
    "required": [
      "adwaita-icon-theme",
      "dejavu-fonts-ttf",
      "exo",
      "garcon",
      "gnome-backgrounds",
      "gnome-themes-extra",
      "gvfs",
      "hicolor-icon-theme",
      "libwnck",
      "libxfce4ui",
      "libxfce4util",
      "libxfce4windowing",
      "lightdm",
      "lxde-icon-theme",
      "network-manager-applet",
      "parole",
      "ristretto",
      "thunar",
      "thunar-volman",
      "tumbler",
      "udisks2",
      "xcursor-themes",
      "xdg-user-dirs",
      "xdg-utils",
      "xfburn",
      "xfce4-appfinder",
      "xfce4-dev-tools",
      "xfce4-notifyd",
      "xfce4-panel",
      "xfce4-power-manager",
      "xfce4-pulseaudio-plugin",
      "xfce4-session",
      "xfce4-settings",
      "xfce4-terminal",
      "xfconf",
      "xfdesktop",
      "xfwm4"
    ]
  },
  "build": {},
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "meta": true
}
