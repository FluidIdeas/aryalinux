{
  "name": "dolphin",
  "version": "25.12.2",
  "description": "The dolphin package is a KDE Frameworks-based file manager.",
  "url": "https://download.kde.org/stable/release-service/25.12.2/src/dolphin-25.12.2.tar.xz",
  "dependencies": {
    "required": [
      "frameworks6",
      "phonon"
    ]
  },
  "build": {
    "user": [
      "mkdir build",
      "cd    build",
      "cmake -D CMAKE_INSTALL_PREFIX=$KF6_PREFIX \\\n      -D CMAKE_BUILD_TYPE=Release         \\\n      -D BUILD_TESTING=OFF                \\\n      -W no-dev ..",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "meta": false,
  "book": "kde/dolphin.html",
  "category": "desktop-kde",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
