{
  "name": "deepin-editor",
  "version": "6.5.53",
  "description": "Simple editor for Deepin (Deepin Desktop Environment).",
  "category": "desktop-deepin",
  "dependencies": {
    "required": [
      "dtk6core",
      "dtk6declarative",
      "dtk6gui",
      "dtk6widget",
      "hicolor-icon-theme",
      "icu",
      "kcodecs",
      "libchardet",
      "qt6",
      "syntax-highlighting",
      "uchardet"
    ]
  },
  "build": {
    "user": [
      "cmake . -GNinja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_INSTALL_LIBEXECDIR=lib -DCMAKE_INSTALL_SYSCONFDIR=/etc ",
      "ninja"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "deepin/deepin-editor.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "url": [
    "https://github.com/linuxdeepin/deepin-editor/archive/refs/tags/6.5.53.tar.gz"
  ]
}
