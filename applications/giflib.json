{
  "name": "giflib",
  "version": "5.2.2",
  "description": "The giflib package contains libraries for reading and writing GIFs as well as programs for converting and working with GIF files.",
  "url": "https://sourceforge.net/projects/giflib/files/giflib-5.2.2.tar.gz",
  "dependencies": {},
  "build": {
    "user": [
      "patch -Np1 -i ../giflib-5.2.2-upstream_fixes-1.patch",
      "patch -Np1 -i ../giflib-5.2.2-security_fixes-1.patch",
      "cp pic/gifgrid.gif doc/giflib-logo.gif",
      "make"
    ],
    "package": [
      "make PREFIX=/usr install DESTDIR=$DESTDIR",
      "rm -fv $DESTDIR/usr/lib/libgif.a"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "general/giflib.html",
  "category": "graphics",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
