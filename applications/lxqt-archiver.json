{
  "name": "lxqt-archiver",
  "version": "1.3.0",
  "description": "",
  "category": "",
  "dependencies": {
    "required": [
      "libfm-qt",
      "json-glib"
    ]
  },
  "build": {
    "user": [
      "cmake -B build -D CMAKE_BUILD_TYPE=Release  \\\n      -D CMAKE_INSTALL_PREFIX=/usr \\\n      .",
      "make -C build"
    ],
    "package": [
      "make -C build install DESTDIR=$DESTDIR"
    ]
  },
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "meta": false,
  "book": "lxqt/lxqt-archiver.html",
  "url": [
    "https://github.com/lxqt/lxqt-archiver/releases/download/1.3.0/lxqt-archiver-1.3.0.tar.xz"
  ]
}
