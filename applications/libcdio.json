{
  "name": "libcdio",
  "version": "2.1.0",
  "description": "libcdio is a library for CD-ROM and CD image access. The associated libcdio-cdparanoia library reads audio from the CD-ROM directly as data, with no analog step between, and writes the data to a file or pipe as .wav, .aifc or as raw 16 bit linear PCM.",
  "url": "https://ftpmirror.gnu.org/libcdio/libcdio-2.1.0.tar.bz2",
  "dependencies": {},
  "build": {
    "user": [
      "case $(uname -m) in\n   i?86)\n      sed '/CDIO_LSEEK/s/lseek64/lseek/'  -i lib/driver/_cdio_generic.c",
      "sed '/CDIO_FSEEK/s/fseeko64/fseek/' -i lib/driver/_cdio_stdio.c   ;;\nesac",
      "./configure --prefix=/usr --disable-static",
      "make",
      "tar -xf ../libcdio-paranoia-10.2+2.0.2.tar.bz2",
      "(cd libcdio-paranoia-10.2+2.0.2 && ./configure --prefix=/usr --disable-static && make)"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR",
      "make -C libcdio-paranoia-10.2+2.0.2 install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "multimedia/libcdio.html",
  "category": "multimedia",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
