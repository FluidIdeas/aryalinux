{
  "name": "libxfce4ui",
  "version": "4.20.2",
  "description": "The libxfce4ui package contains GTK+ 3 widgets that are used by other Xfce applications.",
  "url": [
    "https://archive.xfce.org/src/xfce/libxfce4ui/4.20/libxfce4ui-4.20.2.tar.bz2"
  ],
  "dependencies": {
    "required": [
      "gtk3",
      "startup-notification"
    ]
  },
  "build": {
    "user": [
      "./configure --prefix=/usr --sysconfdir=/etc",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "xfce/libxfce4ui.html",
  "category": "desktop-xfce",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
