{
  "name": "glib-networking",
  "version": "2.80.1",
  "description": "The GLib Networking package contains Network related gio modules for GLib.",
  "url": "https://download.gnome.org/sources/glib-networking/2.80/glib-networking-2.80.1.tar.xz",
  "dependencies": {
    "required": [
      "glib2",
      "gsettings-desktop-schemas"
    ]
  },
  "build": {
    "user": [
      "mkdir build",
      "cd    build",
      "meson setup             \\\n   --prefix=/usr        \\\n   --buildtype=release  \\\n   -D libproxy=disabled \\\n   ..",
      "ninja"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja install"
    ]
  },
  "meta": false,
  "book": "basicnet/glib-networking.html",
  "category": "networking",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
