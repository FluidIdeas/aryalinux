{
  "name": "dtk6log",
  "version": "0.0.6",
  "description": "Simple, convinient and thread safe logger for Qt-based C++ apps (Deepin Desktop Environment).",
  "category": "desktop-deepin",
  "dependencies": {
    "required": [
      "fmt",
      "qt6",
      "spdlog"
    ]
  },
  "build": {
    "user": [
      "cmake . -GNinja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_INSTALL_LIBEXECDIR=lib -DMKSPECS_INSTALL_DIR=lib/qt6/mkspecs/modules -DBUILD_WITH_SYSTEMD=ON -DBUILD_WITH_QT6=ON",
      "ninja"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "deepin/dtk6log.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "url": [
    "https://github.com/linuxdeepin/dtk6log/archive/refs/tags/0.0.6.tar.gz"
  ]
}
