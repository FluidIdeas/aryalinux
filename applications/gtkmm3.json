{
  "name": "gtkmm3",
  "version": "3.24.10",
  "description": "The Gtkmm package provides a C++ interface to GTK+ 3.",
  "url": [
    "https://download.gnome.org/sources/gtkmm/3.24/gtkmm-3.24.10.tar.xz"
  ],
  "dependencies": {
    "required": [
      "atkmm",
      "gtk3",
      "pangomm"
    ]
  },
  "build": {
    "user": [
      "meson setup gtkmm3-build --prefix=/usr --buildtype=release .",
      "ninja -C gtkmm3-build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C gtkmm3-build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "x/gtkmm3.html",
  "category": "x11",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
