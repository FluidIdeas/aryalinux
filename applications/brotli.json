{
  "name": "brotli",
  "version": "1.2.0",
  "description": "Brotli provides a general-purpose lossless compression algorithm that compresses data using a combination of a modern variant of the LZ77 algorithm, Huffman coding and 2nd order context modeling. Its libraries are particularly used for WOFF2 fonts on webpages.",
  "url": "https://github.com/google/brotli/archive/v1.2.0/brotli-1.2.0.tar.gz",
  "dependencies": {
    "required": [
      "cmake"
    ]
  },
  "build": {
    "user": [
      "cmake -B build -D CMAKE_INSTALL_PREFIX=/usr \\\n      -D CMAKE_BUILD_TYPE=Release  \\\n      -G Ninja .",
      "ninja -C build",
      "sed -e '/libraries +=/s/=.*/= [required_system_library[3:]]/' \\\n    -e '/package_configuration/d'                             \\\n    -e '/pkgconfig/d'                                         \\\n    -i setup.py",
      "USE_SYSTEM_BROTLI=1 pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install",
      "pip3 install --root=$DESTDIR --no-index --find-links dist --no-user Brotli"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "general/brotli.html",
  "category": "libraries",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
