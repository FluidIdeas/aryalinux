{
  "name": "mutter",
  "version": "49.4",
  "description": "Mutter is the window manager for GNOME. It is not invoked directly, but from GNOME Session (on a machine with a hardware accelerated video driver).",
  "url": "https://download.gnome.org/sources/mutter/49/mutter-49.4.tar.xz",
  "dependencies": {
    "required": [
      "at-spi2-core",
      "python-modules.docutils",
      "graphene",
      "libei",
      "libxcvt",
      "pipewire",
      "desktop-file-utils",
      "glib2",
      "libdisplay-info",
      "startup-notification",
      "x7driver",
      "xwayland"
    ]
  },
  "build": {
    "user": [
      "sed \"/tests_c_args =/s/$/ + ['-U', 'G_DISABLE_ASSERT']/\" -i src/tests/meson.build",
      "sed \"/c_args:/a '-U', 'G_DISABLE_ASSERT',\" -i src/tests/cogl/unit/meson.build",
      "mkdir build",
      "cd    build",
      "meson setup --prefix=/usr            \\\n            --buildtype=release      \\\n            -D tests=disabled        \\\n            -D profiler=false        \\\n            -D bash_completion=false \\\n            ..",
      "ninja",
      "mutter --wayland -- vte-2.91",
      "MUTTER_DEBUG_DUMMY_MODE_SPECS=1920x1080 mutter --wayland --nested -- vte-2.91"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja install"
    ]
  },
  "meta": false,
  "book": "gnome/mutter.html",
  "category": "desktop-gnome",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
