{
  "name": "deepin-screensaver",
  "version": "6.5.10",
  "description": "Deepin screensaver viewer and tools (Deepin Desktop Environment).",
  "category": "desktop-deepin",
  "dependencies": {
    "required": [
      "deepin-qt-dbus-factory",
      "dtkcore",
      "dtkwidget",
      "qt5-base",
      "qt5-declarative",
      "qt5-quickcontrols2",
      "qt5-x11extras",
      "xscreensaver"
    ]
  },
  "build": {
    "user": [
      "cmake . -GNinja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_INSTALL_LIBEXECDIR=lib -DCMAKE_INSTALL_SYSCONFDIR=/etc ",
      "ninja"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "deepin/deepin-screensaver.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "url": [
    "https://github.com/linuxdeepin/dde-screensaver/archive/refs/tags/6.5.10.tar.gz"
  ]
}
