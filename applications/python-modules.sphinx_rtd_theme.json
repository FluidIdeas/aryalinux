{
  "name": "python-modules.sphinx_rtd_theme",
  "version": "3.1.0",
  "description": "Python module sphinx_rtd_theme for scripts and applications that depend on it.",
  "url": [
    "https://files.pythonhosted.org/packages/source/s/sphinx_rtd_theme/sphinx_rtd_theme-3.1.0.tar.gz"
  ],
  "dependencies": {
    "required": [
      "python-dependencies",
      "python-modules.sphinx"
    ]
  },
  "build": {
    "user": [
      "pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD"
    ],
    "package": [
      "pip3 install --root=$DESTDIR --no-index --find-links dist --no-user sphinx_rtd_theme"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "general/python-modules.html",
  "category": "python-module",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
