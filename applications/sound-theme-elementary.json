{
  "name": "sound-theme-elementary",
  "version": "1.1.0",
  "description": "Elementary sound theme.",
  "category": "desktop-pantheon",
  "url": [
    "https://github.com/elementary/sound-theme/archive/refs/tags/1.1.0.tar.gz"
  ],
  "dependencies": {
    "required": []
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr -Dbuildtype=release  .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "pantheon/sound-theme-elementary.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
