{
  "name": "python-modules.lxml",
  "version": "6.0.2",
  "description": "Python module lxml for scripts and applications that depend on it.",
  "url": "https://files.pythonhosted.org/packages/source/l/lxml/lxml-6.0.2.tar.gz",
  "dependencies": {
    "required": [
      "libxslt"
    ]
  },
  "build": {
    "user": [
      "pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD"
    ],
    "package": [
      "pip3 install --root=$DESTDIR --no-index --find-links dist --no-user lxml"
    ]
  },
  "meta": false,
  "book": "general/python-modules.html",
  "category": "python-module",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
