{
  "name": "dtkcommon",
  "version": "6.7.43",
  "description": "DTK common files for Deepin Desktop Environment.",
  "category": "desktop-deepin",
  "dependencies": {
    "required": [
      "dconf"
    ]
  },
  "build": {
    "user": [
      "cmake . -GNinja -DCMAKE_INSTALL_LIBDIR=/usr/lib -DCMAKE_INSTALL_PREFIX=/usr",
      "ninja"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "deepin/dtkcommon.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "url": [
    "https://github.com/linuxdeepin/dtkcommon/archive/refs/tags/6.7.43.tar.gz"
  ]
}
