{
  "name": "xkill",
  "version": "1.0.7",
  "description": "Xorg application xkill (BLFS chapter).",
  "url": [
    "https://xorg.freedesktop.org/archive/individual/app/xkill-1.0.7.tar.xz"
  ],
  "dependencies": {
    "required": [
      "xkbutils"
    ]
  },
  "build": {
    "environment": {
      "XORG_PREFIX": "/usr",
      "XORG_CONFIG": "--prefix=/usr --sysconfdir=/etc --localstatedir=/var --disable-static"
    },
    "user": [
      "./configure $XORG_CONFIG",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "x/xkill.html",
  "category": "x11",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
