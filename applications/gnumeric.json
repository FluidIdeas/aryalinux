{
  "name": "gnumeric",
  "version": "1.12.60",
  "description": "The Gnumeric package contains a spreadsheet program which is useful for mathematical analysis.",
  "url": "https://download.gnome.org/sources/gnumeric/1.12/gnumeric-1.12.60.tar.xz",
  "dependencies": {
    "required": [
      "goffice010",
      "oxygen-icons",
      "gnome-icon-theme",
      "installing",
      "yelp"
    ]
  },
  "build": {
    "user": [
      "sed -i '/HELP_LINGUAS/s/de//' doc/Makefile.in",
      "./configure --prefix=/usr",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "xsoft/gnumeric.html",
  "category": "applications",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
