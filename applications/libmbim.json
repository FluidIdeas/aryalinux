{
  "name": "libmbim",
  "version": "1.34.0",
  "description": "The libmbim package contains a GLib-based library for talking to WWAN modems and devices which speak the Mobile Interface Broadband Model (MBIM) protocol.",
  "url": "https://gitlab.freedesktop.org/mobile-broadband/libmbim/-/archive/1.34.0/libmbim-1.34.0.tar.gz",
  "dependencies": {
    "required": [
      "glib2"
    ]
  },
  "build": {
    "user": [
      "mkdir build",
      "cd    build",
      "meson setup ..                 \\\n      --prefix=/usr            \\\n      --buildtype=release      \\\n      -D bash_completion=false \\\n      -D man=false",
      "ninja"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja install"
    ]
  },
  "meta": false,
  "book": "general/libmbim.html",
  "category": "libraries",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
