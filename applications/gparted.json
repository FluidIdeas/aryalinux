{
  "name": "gparted",
  "version": "1.8.0",
  "description": "Gparted is the Gnome Partition Editor, a Gtk 3 GUI for other command line tools that can create, reorganise or delete disk partitions.",
  "url": [
    "https://downloads.sourceforge.net/gparted/gparted-1.8.0.tar.gz",
    "https://versaweb.dl.sourceforge.net/project/gparted/gparted/1.8.0/gparted-1.8.0.tar.gz"
  ],
  "dependencies": {
    "required": [
      "gtkmm3",
      "parted"
    ]
  },
  "build": {
    "user": [
      "./configure --prefix=/usr    \\\n            --disable-doc    \\\n            --disable-static",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR",
      "sed -i 's/Exec=/Exec=sudo -A /' $DESTDIR/usr/share/applications/gparted.desktop"
    ]
  },
  "post_install": [
    "update-desktop-database -q"
  ],
  "meta": false,
  "book": "xsoft/gparted.html",
  "category": "applications",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
