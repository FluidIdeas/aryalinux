{
  "name": "glycin",
  "version": "2.0.8",
  "description": "",
  "category": "",
  "dependencies": {
    "required": [
      "fontconfig",
      "glib2",
      "lcms2",
      "libseccomp",
      "rust"
    ],
    "recommended": [
      "libheif",
      "libjxl",
      "librsvg",
      "vala"
    ],
    "post": [
      "gdk-pixbuf"
    ]
  },
  "build": {
    "user": [
      "cargo vendor",
      "patch -Np1 -i ../glycin-2.0.8-xorg_prefix-1.patch",
      "patch -Np1 -i ../glycin-2.0.8-xbm_xpm-1.patch",
      "cargo vendor",
      "meson setup build --prefix=/usr           \\\n            --buildtype=release     \\\n            -D libglycin-gtk4=false \\\n            -D vapi=false          \\\n            -D capi_docs=false     \\\n            -D tests=false .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "meta": false,
  "book": "general/glycin.html",
  "url": [
    "https://download.gnome.org/sources/glycin/2.0/glycin-2.0.8.tar.xz"
  ],
  "additionalUrls": [
    "https://www.linuxfromscratch.org/patches/blfs/13.0/glycin-2.0.8-xorg_prefix-1.patch",
    "https://www.linuxfromscratch.org/patches/blfs/13.0/glycin-2.0.8-xbm_xpm-1.patch"
  ]
}
