{
  "name": "phonon-backend-vlc",
  "version": "0.12.0",
  "description": "This package provides a Phonon backend which utilizes the VLC media framework.",
  "url": "https://download.kde.org/stable/phonon/phonon-backend-vlc/0.12.0/phonon-backend-vlc-0.12.0.tar.xz",
  "dependencies": {
    "required": [
      "phonon"
    ]
  },
  "build": {
    "user": [
      "mkdir build",
      "cd    build",
      "cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n      -D CMAKE_BUILD_TYPE=Release  \\\n      -D PHONON_BUILD_QT5=OFF      \\\n      ..",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "meta": false,
  "book": "kde/phonon-backend-vlc.html",
  "category": "desktop-kde",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
