{
  "name": "phonon-backend-vlc",
  "version": "0.12.0",
  "description": "This package provides a Phonon backend which utilizes the VLC media framework.",
  "url": "https://download.kde.org/stable/phonon/phonon-backend-vlc/0.12.0/phonon-backend-vlc-0.12.0.tar.xz",
  "dependencies": {
    "required": [
      "phonon"
    ]
  },
  "build": {
    "environment": {
      "KF6_PREFIX": "/usr"
    },
    "user": [
      "cmake -B build -D CMAKE_INSTALL_PREFIX=$KF6_PREFIX \\\n      -D CMAKE_BUILD_TYPE=Release  \\\n      -D PHONON_BUILD_QT5=OFF      \\\n      .",
      "make -C build"
    ],
    "package": [
      "make -C build install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "kde/phonon-backend-vlc.html",
  "category": "desktop-kde",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
