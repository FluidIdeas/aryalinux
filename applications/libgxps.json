{
  "name": "libgxps",
  "version": "0.3.2",
  "description": "The libgxps package provides an interface to manipulate XPS documents.",
  "url": [
    "https://download.gnome.org/sources/libgxps/0.3/libgxps-0.3.2.tar.xz"
  ],
  "dependencies": {
    "required": [
      "gtk3",
      "lcms2",
      "libjpeg",
      "libtiff",
      "libxslt"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr --buildtype=release .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "general/libgxps.html",
  "category": "graphics",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
