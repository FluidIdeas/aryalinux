{
  "name": "spirv-headers",
  "version": "b8a32968473c",
  "description": "SPIRV-Headers provides header files for the SPIR-V shader intermediate language.",
  "url": [
    "https://github.com/KhronosGroup/SPIRV-Headers/archive/b8a32968473ce852a809b9de5f04f02a5a9dfa78/SPIRV-Headers-b8a3296.tar.gz"
  ],
  "dependencies": {
    "required": [
      "cmake"
    ]
  },
  "build": {
    "user": [
      "cmake -B build -D CMAKE_INSTALL_PREFIX=/usr -G Ninja .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "general/spirv-headers.html",
  "category": "libraries",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
