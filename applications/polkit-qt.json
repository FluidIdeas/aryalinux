{
  "name": "polkit-qt",
  "version": "0.200.0",
  "description": "Polkit-Qt provides an API to PolicyKit in the Qt environment.",
  "url": [
    "https://download.kde.org/stable/polkit-qt-1/polkit-qt-1-0.200.0.tar.xz"
  ],
  "dependencies": {
    "required": [
      "cmake",
      "polkit",
      "qt6"
    ]
  },
  "build": {
    "environment": {
      "KF6_PREFIX": "/usr"
    },
    "user": [
      "cmake -B build -D CMAKE_INSTALL_PREFIX=$KF6_PREFIX \\\n      -D CMAKE_BUILD_TYPE=Release  \\\n      -D QT_MAJOR_VERSION=6        \\\n      -W no-dev .",
      "make -C build"
    ],
    "package": [
      "make -C build install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "kde/polkit-qt.html",
  "category": "desktop-kde",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
