{
  "name": "perl-modules.perl-xml-libxml-simple",
  "version": "1.01",
  "description": "Perl module perl::xml::libxml::simple used by applications and other Perl packages on the system.",
  "url": "https://www.cpan.org/authors/id/M/MA/MARKOV/XML-LibXML-Simple-1.01.tar.gz",
  "dependencies": {
    "required": [
      "perl-deps.perl-xml-libxml"
    ]
  },
  "build": {
    "user": [
      "perl Makefile.PL",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "meta": false,
  "book": "general/perl-modules.html",
  "category": "perl-module",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
