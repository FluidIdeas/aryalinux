{
  "name": "tk",
  "version": "8.6.17",
  "description": "The Tk package contains a TCL GUI Toolkit.",
  "url": "https://downloads.sourceforge.net/tcl/tk8.6.17-src.tar.gz",
  "dependencies": {
    "required": [
      "x7lib"
    ]
  },
  "build": {
    "user": [
      "cd unix",
      "./configure --prefix=/usr \\\n            --mandir=/usr/share/man \\\n            $([ $(uname -m) = x86_64 ]",
      "echo --enable-64bit)",
      "make",
      "sed -e \"s@^\\(TK_SRC_DIR='\\).*@\\1/usr/include'@\" \\\n    -e \"/TK_B/s@='\\(-L\\)\\?.*unix@='\\1/usr/lib@\" \\\n    -i tkConfig.sh",
      "ln -v -sf wish8.6 /usr/bin/wish",
      "chmod -v 755 /usr/lib/libtk8.6.so"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR",
      "make install-private-headers DESTDIR=$DESTDIR"
    ]
  },
  "meta": false,
  "book": "general/tk.html",
  "category": "programming",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
