{
  "name": "gtklock",
  "version": "4.0.0",
  "description": "GTK-based lock screen for Wayland (Budgie).",
  "category": "applications",
  "url": [
    "https://github.com/jovanlanik/gtklock/archive/refs/tags/v4.0.0.tar.gz"
  ],
  "dependencies": {
    "required": [
      "gtk-session-lock",
      "gtk3",
      "linux-pam",
      "wayland"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr -Dbuildtype=release gtklock-4.0.0",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "budgie/gtklock.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
