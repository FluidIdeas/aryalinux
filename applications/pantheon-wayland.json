{
  "name": "pantheon-wayland",
  "version": "1.1.0",
  "description": "Wayland integration library for Pantheon.",
  "category": "desktop-pantheon",
  "url": [
    "https://github.com/elementary/pantheon-wayland/archive/refs/tags/1.1.0.tar.gz"
  ],
  "dependencies": {
    "required": [
      "glib2",
      "gtk4",
      "wayland"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr -Dbuildtype=release  .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "pantheon/pantheon-wayland.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
