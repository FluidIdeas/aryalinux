{
  "name": "deepin-grand-search",
  "version": "5.5.10",
  "description": "System-wide desktop search for DDE (Deepin Desktop Environment).",
  "category": "desktop-deepin",
  "dependencies": {
    "required": []
  },
  "build": {
    "user": [
      "cmake . -GNinja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_INSTALL_LIBEXECDIR=lib -DCMAKE_INSTALL_SYSCONFDIR=/etc ",
      "ninja"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "deepin/deepin-grand-search.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "url": [
    "https://github.com/linuxdeepin/dde-grand-search/archive/refs/tags/5.5.10.tar.gz"
  ]
}
