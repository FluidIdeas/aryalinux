{
  "name": "gtksourceview4",
  "version": "4.8.4",
  "description": "The GtkSourceView package contains libraries used for extending the GTK+ text functions to include syntax highlighting.",
  "url": [
    "https://download.gnome.org/sources/gtksourceview/4.8/gtksourceview-4.8.4.tar.xz"
  ],
  "dependencies": {
    "required": [
      "glib2",
      "gtk3",
      "libxml2"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr --buildtype=release .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "x/gtksourceview4.html",
  "category": "x11",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
