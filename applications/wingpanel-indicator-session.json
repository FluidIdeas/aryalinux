{
  "name": "wingpanel-indicator-session",
  "version": "2.3.1",
  "description": "Wingpanel session indicator.",
  "category": "desktop-pantheon",
  "url": [
    "https://github.com/elementary/wingpanel-indicator-session/archive/refs/tags/2.3.1.tar.gz"
  ],
  "dependencies": {
    "required": [
      "accountsservice",
      "granite",
      "libhandy",
      "wingpanel"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr -Dbuildtype=release  .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "pantheon/wingpanel-indicator-session.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
