{
  "name": "cdrdao",
  "version": "1.2.6",
  "description": "The Cdrdao package contains CD recording utilities. These are useful for burning a CD in disk-at-once mode.",
  "url": "https://downloads.sourceforge.net/cdrdao/cdrdao-1.2.6.tar.bz2",
  "dependencies": {
    "required": [
      "gtkmm3",
      "libvorbis",
      "libmad"
    ]
  },
  "build": {
    "user": [
      "./configure --prefix=/usr --mandir=/usr/share/man",
      "make CC=\"gcc -std=gnu17\""
    ],
    "package": [
      "make install DESTDIR=$DESTDIR",
      "install -v -m755 -d $DESTDIR/usr/share/doc/cdrdao-1.2.6",
      "install -v -m644 README $DESTDIR/usr/share/doc/cdrdao-1.2.6"
    ]
  },
  "meta": false,
  "book": "multimedia/cdrdao.html",
  "category": "multimedia",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
