{
  "name": "cdrdao",
  "version": "1.2.6",
  "description": "The Cdrdao package contains CD recording utilities. These are useful for burning a CD in disk-at-once mode.",
  "url": [
    "https://downloads.sourceforge.net/cdrdao/cdrdao-1.2.6.tar.bz2",
    "https://versaweb.dl.sourceforge.net/project/cdrdao/cdrdao/1.2.6/cdrdao-1.2.6.tar.bz2"
  ],
  "dependencies": {
    "required": [
      "gtkmm3",
      "lame",
      "libao",
      "libmad",
      "libvorbis"
    ]
  },
  "build": {
    "user": [
      "./configure --prefix=/usr --mandir=/usr/share/man",
      "make CC=\"gcc -std=gnu17\""
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "multimedia/cdrdao.html",
  "category": "multimedia",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
