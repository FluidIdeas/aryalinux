{
  "name": "plank",
  "version": "0.11.89",
  "description": "Elementary dock for Pantheon.",
  "category": "libraries",
  "url": [
    "https://github.com/ricotz/plank/archive/refs/tags/0.11.89.tar.gz"
  ],
  "dependencies": {
    "required": [
      "bamf",
      "cairo",
      "gdk-pixbuf",
      "glib2",
      "gnome-menus",
      "gtk3",
      "libX11",
      "libXfixes",
      "libXi",
      "libgee",
      "libwnck",
      "pango"
    ]
  },
  "build": {
    "user": [
      "cd plank-0.11.89",
      "sed 's/0.19.6/0.20/' -i configure.ac",
      "NOCONFIGURE=1 ./autogen.sh",
      "./configure --prefix=/usr",
      "make"
    ],
    "package": [
      "make -C plank-0.11.89 DESTDIR=$DESTDIR install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "pantheon/plank.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
