{
  "name": "libshout",
  "version": "2.4.6",
  "description": "libshout sends live MP3 or Vorbis audio data to an Icecast server.",
  "category": "multimedia",
  "dependencies": {
    "required": [
      "libogg",
      "libvorbis"
    ]
  },
  "build": {
    "user": [
      "./configure --prefix=/usr \\\n            --disable-static",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "meta": false,
  "book": "multimedia/vlc.html",
  "url": [
    "https://downloads.xiph.org/releases/libshout/libshout-2.4.6.tar.gz"
  ],
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
