{
  "name": "pantheon-mail",
  "version": "8.0.1",
  "description": "Pantheon email client.",
  "category": "applications",
  "url": [
    "https://github.com/elementary/mail/archive/refs/tags/8.0.1.tar.gz"
  ],
  "dependencies": {
    "required": [
      "evolution-data-server",
      "glib2",
      "granite",
      "libhandy",
      "webkitgtk"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr -Dbuildtype=release  .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "pantheon/pantheon-mail.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
