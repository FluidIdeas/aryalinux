{
  "name": "file-roller",
  "version": "44.6",
  "description": "File Roller is an archive manager for GNOME with support for tar, bzip2, bzip3, gzip, zip, jar, compress, lzop, zstd, dmg, and many other archive formats.",
  "url": [
    "https://download.gnome.org/sources/file-roller/44/file-roller-44.6.tar.xz"
  ],
  "dependencies": {
    "required": [
      "cpio",
      "desktop-file-utils",
      "gtk4",
      "itstool",
      "json-glib",
      "libadwaita",
      "libarchive",
      "libportal",
      "nautilus"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr       \\\n            --buildtype=release \\\n            -D packagekit=false \\\n            .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [
    "gtk-update-icon-cache -qtf /usr/share/icons/hicolor",
    "update-desktop-database -q",
    "chmod -v 0755 /usr/libexec/file-roller/isoinfo.sh",
    "glib-compile-schemas /usr/share/glib-2.0/schemas"
  ],
  "meta": false,
  "book": "gnome/file-roller.html",
  "category": "desktop-gnome",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
