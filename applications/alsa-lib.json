{
  "name": "alsa-lib",
  "version": "1.2.15.3",
  "description": "The ALSA Library package contains the ALSA library used by programs (including ALSA Utilities) requiring access to the ALSA sound interface.",
  "url": [
    "https://www.alsa-project.org/files/pub/lib/alsa-lib-1.2.15.3.tar.bz2"
  ],
  "build": {
    "user": [
      "./configure",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR",
      "install -d $DESTDIR/usr/share/alsa",
      "tar -C $DESTDIR/usr/share/alsa --strip-components=1 -xf ../../alsa-ucm-conf-1.2.15.3.tar.bz2"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "multimedia/alsa-lib.html",
  "category": "multimedia",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "additionalUrls": [
    "https://www.alsa-project.org/files/pub/lib/alsa-ucm-conf-1.2.15.3.tar.bz2"
  ]
}
