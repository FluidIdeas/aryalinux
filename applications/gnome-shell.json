{
  "name": "gnome-shell",
  "version": "49.4",
  "description": "The GNOME Shell is the core user interface of the GNOME Desktop environment.",
  "url": [
    "https://download.gnome.org/sources/gnome-shell/49/gnome-shell-49.4.tar.xz"
  ],
  "dependencies": {
    "required": [
      "evolution-data-server",
      "gcr4",
      "gjs",
      "gnome-desktop",
      "ibus",
      "mutter",
      "polkit",
      "startup-notification",
      "desktop-file-utils",
      "gnome-autoar",
      "gnome-bluetooth",
      "gst10-plugins-base",
      "networkmanager",
      "power-profiles-daemon"
    ],
    "runtime": [
      "adwaita-icon-theme",
      "dconf",
      "gdm",
      "gnome-control-center",
      "gnome-menus",
      "libgweather",
      "systemd"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr       \\\n            --buildtype=release \\\n            -D tests=false      \\\n            .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "gnome/gnome-shell.html",
  "category": "desktop-gnome",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
