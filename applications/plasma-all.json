      "knighttime",
      "kpipewire",
      "kscreen",
      "kscreenlocker",
      "ksshaskpass",
      "ksystemstats",
      "kwallet-pam",
      "kwayland",
      "kwin",
      "kwin-x11",
      "kwrited",
      "layer-shell-qt",
      "libkscreen",
      "libksysguard",
      "libplasma",
