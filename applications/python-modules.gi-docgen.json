{
  "name": "python-modules.gi-docgen",
  "version": "2026.1",
  "description": "Python module gi-docgen for scripts and applications that depend on it.",
  "url": [
    "https://files.pythonhosted.org/packages/source/g/gi-docgen/gi_docgen-2026.1.tar.gz"
  ],
  "dependencies": {
    "required": [
      "python-deps.markdown"
    ]
  },
  "build": {
    "user": [
      "pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD"
    ],
    "package": [
      "pip3 install --root=$DESTDIR --no-index --find-links dist --no-user gi-docgen"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "general/python-modules.html",
  "category": "python-module",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
