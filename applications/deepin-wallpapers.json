{
  "name": "deepin-wallpapers",
  "version": "1:1.7.26",
  "description": "Default wallpapers for Deepin Desktop Environment.",
  "category": "desktop-deepin",
  "dependencies": {
    "required": [
      "deepin-api"
    ]
  },
  "build": {
    "user": [
      "make SYSTEMID=deepin"
    ],
    "package": [
      "install -dm755 $DESTDIR/usr/share/wallpapers",
      "cp -r deepin $DESTDIR/usr/share/wallpapers/",
      "cp -r deepin-solidwallpapers $DESTDIR/usr/share/wallpapers/",
      "cp -r deepin-livewallpapers $DESTDIR/usr/share/wallpapers/",
      "install -dm755 $DESTDIR/var/cache",
      "cp -r image-blur $DESTDIR/var/cache/",
      "install -dm755 $DESTDIR/usr/share/backgrounds/deepin",
      "ln -sf ../../wallpapers/deepin/desktop.jpg $DESTDIR/usr/share/backgrounds/deepin/desktop.jpg"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "deepin/deepin-wallpapers.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "url": [
    "https://github.com/linuxdeepin/deepin-wallpapers/archive/refs/tags/1.7.26.tar.gz"
  ]
}
