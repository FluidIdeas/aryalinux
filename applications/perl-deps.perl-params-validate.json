  "dependencies": {
    "required": [
      "perl-modules.perl-module-build",
      "perl-deps.perl-module-implementation",
      "perl-deps.perl-test-fatal",
      "perl-deps.perl-test-requires"
    ]
  },
  "build": {
    "user": [
      "perl Build.PL",
      "./Build"
    ],
    "package": [
      "./Build install --destdir $DESTDIR"
    ]
  },
  "meta": false,
  "book": "general/perl-deps.html",
  "category": "perl-dependency",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
