{
  "name": "deepin-image-editor",
  "version": "1.0.47",
  "description": "Public library for deepin-image-viewer and deepin-album (Deepin Desktop Environment).",
  "category": "desktop-deepin",
  "dependencies": {
    "required": [
      "deepin-util-dfm",
      "dtkcore",
      "dtkgui",
      "dtkwidget",
      "ffmpegthumbnailer",
      "libmediainfo",
      "libtiff",
      "qt5-base",
      "qt5-svg"
    ]
  },
  "build": {
    "user": [
      "cmake . -GNinja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_INSTALL_LIBEXECDIR=lib -DCMAKE_INSTALL_SYSCONFDIR=/etc ",
      "ninja"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "deepin/deepin-image-editor.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "url": [
    "https://github.com/linuxdeepin/deepin-image-editor/archive/refs/tags/1.0.47.tar.gz"
  ]
}
