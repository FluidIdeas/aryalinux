{
  "name": "evisum",
  "version": "0.6.4",
  "description": "GUI process viewer (htop-like) using EFL.",
  "category": "applications",
  "url": [
    "https://download.enlightenment.org/rel/apps/evisum/evisum-0.6.4.tar.xz"
  ],
  "dependencies": {
    "required": [
      "efl"
    ]
  },
  "build": {
    "environment": {
      "CFLAGS": "$CFLAGS -fvisibility=hidden"
    },
    "user": [
      "meson setup build --prefix=/usr .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install",
      "install -Dm644 -t $DESTDIR/usr/share/licenses/evisum/ AUTHORS"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "enlightenment/evisum.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
