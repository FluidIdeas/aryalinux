{
  "name": "perl-modules.perl-libwww-perl",
  "version": "6.81",
  "description": "Perl module perl::libwww::perl used by applications and other Perl packages on the system.",
  "url": "https://www.cpan.org/authors/id/O/OA/OALDERS/libwww-perl-6.81.tar.gz",
  "dependencies": {
    "required": [
      "perl-deps.perl-file-listing",
      "perl-deps.perl-http-cookies",
      "perl-modules.perl-html-parser",
      "perl-deps.perl-test-fatal",
      "perl-deps.perl-test-requiresinternet"
    ]
  },
  "build": {
    "user": [
      "perl Makefile.PL",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "general/perl-modules.html",
  "category": "perl-module",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
