{
  "name": "xclock",
  "version": "1.1.1",
  "description": "The xclock package contains a simple clock application which is used in the default xinit configuration.",
  "url": [
    "https://www.x.org/pub/individual/app/xclock-1.1.1.tar.xz"
  ],
  "dependencies": {
    "required": [
      "x7lib"
    ]
  },
  "build": {
    "user": [
      "./configure $XORG_CONFIG",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "x/xclock.html",
  "category": "x11",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
