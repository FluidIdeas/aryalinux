{
  "name": "wlopm",
  "version": "1.0.0",
  "description": "Wayland output power management utility.",
  "category": "applications",
  "url": [
    "https://git.sr.ht/~leon_plickat/wlopm/archive/v1.0.0.tar.gz"
  ],
  "dependencies": {
    "required": [
      "wayland"
    ]
  },
  "build": {
    "user": [
      "make"
    ],
    "package": [
      "install -d $DESTDIR/usr/share/bash-completion/completions",
      "make DESTDIR=$DESTDIR PREFIX=/usr install",
      "install -Dm644 LICENSE $DESTDIR/usr/share/licenses/wlopm/LICENSE"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "budgie/wlopm.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
