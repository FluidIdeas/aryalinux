{
  "name": "xfwm4",
  "version": "4.20.0",
  "description": "Xfwm4 is the window manager for Xfce.",
  "url": "https://archive.xfce.org/src/xfce/xfwm4/4.20/xfwm4-4.20.0.tar.bz2",
  "dependencies": {
    "required": [
      "libwnck",
      "startup-notification"
    ]
  },
  "build": {
    "user": [
      "./configure --prefix=/usr",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "xfce/xfwm4.html",
  "category": "desktop-xfce",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
