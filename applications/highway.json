{
  "name": "highway",
  "version": "1.3.0",
  "description": "",
  "category": "",
  "dependencies": {
    "required": [
      "cmake"
    ]
  },
  "build": {
    "user": [
      "cmake -B build -D CMAKE_INSTALL_PREFIX=/usr \\\n      -D CMAKE_BUILD_TYPE=Release  \\\n      -D BUILD_TESTING=OFF         \\\n      -D BUILD_SHARED_LIBS=ON      \\\n      -G Ninja .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "meta": false,
  "book": "general/highway.html",
  "url": [
    "https://github.com/google/highway/archive/1.3.0/highway-1.3.0.tar.gz"
  ]
}
