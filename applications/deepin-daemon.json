{
  "name": "deepin-daemon",
  "version": "6.1.77",
  "description": "Daemon handling the DDE session settings (Deepin Desktop Environment).",
  "category": "desktop-deepin",
  "dependencies": {
    "required": [
      "accountsservice",
      "alsa-lib",
      "deepin-api",
      "deepin-app-services",
      "deepin-application-manager",
      "deepin-desktop-base",
      "deepin-desktop-schemas",
      "deepin-desktop-theme",
      "deepin-polkit-agent",
      "deepin-polkit-agent-ext-gnomekeyring",
      "deepin-session-ui",
      "deepin-widgets",
      "deepin-wloutput-daemon",
      "gdk-pixbuf",
      "glib2",
      "gtk3",
      "gvfs",
      "iso-codes",
      "libnl",
      "librsvg",
      "libsecret",
      "libxkbfile",
      "linux-pam",
      "lsb-tools",
      "lshw",
      "pipewire",
      "pulseaudio",
      "sudo",
      "systemd",
      "udisks2",
      "upower",
      "xdg-utils"
    ],
    "optional": [
      "bluez",
      "iw",
      "networkmanager",
      "proxychains-ng"
    ]
  },
  "build": {
    "environment": {
      "CGO_CPPFLAGS": "$CPPFLAGS",
      "CGO_CFLAGS": "$CFLAGS",
      "CGO_CXXFLAGS": "$CXXFLAGS",
      "CGO_LDFLAGS": "$LDFLAGS",
      "GOFLAGS": "-buildmode=pie -trimpath -mod=readonly -modcacherw"
    },
    "user": [
      "sed -i 's#/usr/libexec#/usr/lib#' keybinding1/shortcuts/system_shortcut.go",
      "sed -i 's#${PREFIX}/libexec/#${PREFIX}/lib/#;s#${DESTDIR}/lib#${DESTDIR}${PREFIX}/lib#' Makefile",
      "sed -i 's|/etc/os-version|/etc/uos-version|' keybinding1/shortcuts/shortcut_manager.go",
      "sed -i 's|/usr/share/backgrounds/|/usr/share/backgrounds/deepin/|' accounts1/user.go",
      "sed -i 's|default_background.jpg|desktop.jpg|' accounts1/user.go",
      "sed -i 's|icons/default|icons/animal/raccoon.png|' accounts1/user.go",
      "make"
    ],
    "package": [
      "make DESTDIR=$DESTDIR PAM_MODULE_DIR=usr/lib/security install",
      "rm -f $DESTDIR/usr/share/dbus-1/system-services/org.deepin.dde.ImageEffect1.service $DESTDIR/usr/share/dbus-1/system.d/org.deepin.dde.ImageEffect1.conf $DESTDIR/usr/share/dbus-1/system.d/org.deepin.dde.ImageBlur1.conf",
      "install -Dm644 debian/dde-daemon.sysusers $DESTDIR/usr/lib/sysusers.d/deepin-daemon.conf"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "deepin/deepin-daemon.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "url": [
    "https://github.com/linuxdeepin/dde-daemon/archive/refs/tags/6.1.77.tar.gz"
  ]
}
