{
  "name": "kddockwidgets",
  "version": "2.4.0",
  "description": "",
  "category": "",
  "dependencies": {
    "required": [
      "fmt",
      "qt6",
      "vulkan-loader"
    ]
  },
  "build": {
    "user": [
      "cmake -B build -D CMAKE_INSTALL_PREFIX=$KF6_PREFIX \\\n      -D CMAKE_BUILD_TYPE=Release         \\\n      -W no-dev .",
      "make -C build"
    ],
    "package": [
      "make -C build install DESTDIR=$DESTDIR"
    ],
    "environment": {
      "KF6_PREFIX": "/usr"
    }
  },
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "meta": false,
  "book": "kde/kddockwidgets.html",
  "url": [
    "https://github.com/KDAB/KDDockWidgets/releases/download/v2.4.0/kddockwidgets-2.4.0.tar.gz"
  ]
}
