{
  "name": "libqalculate",
  "version": "5.9.0",
  "description": "The libqalculate package contains a library that provides functions for a multi-purpose calculator.",
  "url": [
    "https://github.com/Qalculate/libqalculate/releases/download/v5.9.0/libqalculate-5.9.0.tar.gz"
  ],
  "dependencies": {
    "required": [
      "curl",
      "icu"
    ]
  },
  "build": {
    "user": [
      "./configure --prefix=/usr    \\\n            --disable-static",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR",
      "rm -v $DESTDIR/usr/lib/libqalculate.la"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "general/libqalculate.html",
  "category": "libraries",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
