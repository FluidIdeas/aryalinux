{
  "name": "libdbusmenu-gtk3",
  "version": "18.10.20180917",
  "description": "DBus menu library (GTK3 bindings) for X-Apps.",
  "category": "libraries",
  "url": [
    "https://deb.debian.org/debian/pool/main/libd/libdbusmenu/libdbusmenu_18.10.20180917~bzr492+repack1.orig.tar.xz"
  ],
  "dependencies": {
    "required": [
      "gtk3",
      "libdbusmenu-glib"
    ]
  },
  "build": {
    "user": [
      "cd libdbusmenu-18.10.20180917~bzr492+repack1",
      "NOCONFIGURE=1 ./autogen.sh",
      "./configure --prefix=/usr --disable-dumper --disable-static --disable-tests --with-gtk=3",
      "make -C libdbusmenu-gtk"
    ],
    "package": [
      "make -C libdbusmenu-gtk DESTDIR=$DESTDIR install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "cinnamon/libdbusmenu-gtk3.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
