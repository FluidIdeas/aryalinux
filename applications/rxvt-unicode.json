{
  "name": "rxvt-unicode",
  "version": "9.31",
  "description": "rxvt-unicode is a clone of the terminal emulator rxvt, an X Window System terminal emulator which includes support for XFT and Unicode.",
  "url": [
    "http://dist.schmorp.de/rxvt-unicode/Attic/rxvt-unicode-9.31.tar.bz2"
  ],
  "dependencies": {
    "required": [
      "installing",
      "libptytty"
    ]
  },
  "build": {
    "user": [
      "./configure --prefix=/usr --enable-everything",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "xsoft/rxvt-unicode.html",
  "category": "applications",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
