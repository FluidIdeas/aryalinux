{
  "name": "fmt",
  "version": "12.1.0",
  "description": "",
  "category": "",
  "dependencies": {
    "required": [
      "cmake"
    ]
  },
  "build": {
    "user": [
      "cmake -B build -D CMAKE_INSTALL_PREFIX=/usr     \\\n      -D CMAKE_INSTALL_LIBDIR=/usr/lib \\\n      -D BUILD_SHARED_LIBS=ON          \\\n      -D FMT_TEST=OFF                  \\\n      -G Ninja .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "meta": false,
  "book": "general/fmt.html",
  "url": [
    "https://github.com/fmtlib/fmt/archive/12.1.0/fmt-12.1.0.tar.gz"
  ]
}
