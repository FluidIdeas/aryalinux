{
  "name": "lxqt-kwayland",
  "version": "6.6.1",
  "description": "",
  "category": "",
  "dependencies": {
    "required": [
      "extra-cmake-modules",
      "mesa",
      "plasma-wayland-protocols",
      "qt6",
      "wayland"
    ]
  },
  "build": {
    "user": [
      "cmake -B build -D CMAKE_INSTALL_PREFIX=/usr        \\\n      -D CMAKE_BUILD_TYPE=Release         \\\n      -D CMAKE_INSTALL_LIBEXECDIR=libexec \\\n      -D KDE_INSTALL_USE_QT_SYS_PATHS=ON  \\\n      -D BUILD_TESTING=OFF                \\\n      -W no-dev .",
      "make -C build"
    ],
    "package": [
      "make -C build install DESTDIR=$DESTDIR"
    ]
  },
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "meta": false,
  "book": "lxqt/lxqt-kwayland.html",
  "url": [
    "https://download.kde.org/stable/plasma/6.6.1/kwayland-6.6.1.tar.xz"
  ]
}
