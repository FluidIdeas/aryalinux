{
  "name": "tecla",
  "version": "49.0",
  "description": "",
  "category": "",
  "dependencies": {
    "required": [
      "libadwaita"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr --buildtype=release .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "meta": false,
  "book": "gnome/tecla.html",
  "url": [
    "https://download.gnome.org/sources/tecla/49/tecla-49.0.tar.xz"
  ]
}
