{
  "name": "font-xfree86-type1",
  "version": "1.0.5",
  "description": "Xorg font font-xfree86-type1 (BLFS chapter).",
  "url": [
    "https://xorg.freedesktop.org/archive/individual/font/font-xfree86-type1-1.0.5.tar.xz"
  ],
  "dependencies": {
    "required": [
      "font-misc-ethiopic"
    ]
  },
  "build": {
    "environment": {
      "XORG_PREFIX": "/usr",
      "XORG_CONFIG": "--prefix=/usr --sysconfdir=/etc --localstatedir=/var --disable-static"
    },
    "user": [
      "./configure $XORG_CONFIG",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "x/font-xfree86-type1.html",
  "category": "x11",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
