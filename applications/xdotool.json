{
  "name": "xdotool",
  "version": "4.20251130.1",
  "description": "xdotool is a command-line tool that lets you simulate keyboard input and mouse activity, move and resize windows, and more.",
  "url": [
    "https://github.com/jordansissel/xdotool/releases/download/v4.20251130.1/xdotool-4.20251130.1.tar.gz"
  ],
  "dependencies": {
    "required": [
      "x7lib"
    ]
  },
  "build": {
    "user": [
      "sed -i 's#/local##' libxdo.pc",
      "make WITHOUT_RPATH_FIX=1"
    ],
    "package": [
      "make PREFIX=/usr INSTALLMAN=/usr/share/man install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "general/xdotool.html",
  "category": "general",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
