{
  "name": "python-modules.blueprint-compiler",
  "version": "0.18.0",
  "description": "",
  "category": "",
  "dependencies": {
    "required": [
      "python-modules.pygobject3"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr --buildtype=release .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "meta": false,
  "book": "general/python-modules.html",
  "url": [
    "https://download.gnome.org/sources/blueprint-compiler/0.18/blueprint-compiler-0.18.0.tar.xz"
  ]
}
