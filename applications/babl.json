{
  "name": "babl",
  "version": "0.1.122",
  "description": "The Babl package is a dynamic, any to any, pixel format translation library.",
  "url": [
    "https://download.gimp.org/pub/babl/0.1/babl-0.1.122.tar.xz"
  ],
  "dependencies": {
    "recommended": [
      "glib2"
    ],
    "post": [
      "librsvg"
    ]
  },
  "build": {
    "user": [
      "meson setup bld --prefix=/usr --buildtype=release .",
      "ninja -C bld"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C bld install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "general/babl.html",
  "category": "graphics",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
