{
  "name": "gtk-theme-elementary",
  "version": "8.2.2",
  "description": "Elementary GTK stylesheet/theme.",
  "category": "desktop-pantheon",
  "url": [
    "https://github.com/elementary/stylesheet/archive/refs/tags/8.2.2.tar.gz"
  ],
  "dependencies": {
    "required": []
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr -Dbuildtype=release  .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "pantheon/gtk-theme-elementary.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
