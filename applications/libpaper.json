{
  "name": "libpaper",
  "version": "2.2.7",
  "description": "This package is intended to provide a simple way for applications to take actions based on a system or user-specified paper size.",
  "url": [
    "https://github.com/rrthomas/libpaper/releases/download/v2.2.7/libpaper-2.2.7.tar.gz"
  ],
  "dependencies": {},
  "build": {
    "user": [
      "./configure --prefix=/usr     \\\n            --sysconfdir=/etc \\\n            --disable-static",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR",
      "install -d $DESTDIR/etc/profile.d",
      "echo \"PAPERSIZE=a4\" > $DESTDIR/etc/profile.d/libpaper.sh"
    ]
  },
  "post_install": [
    "mkdir -pv ~/.config",
    "echo \"a4\" > ~/.config/papersize"
  ],
  "meta": false,
  "book": "general/libpaper.html",
  "category": "libraries",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
