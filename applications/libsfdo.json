{
  "name": "libsfdo",
  "version": "0.1.4",
  "description": "Freedesktop.org spec libraries (labwc dependency).",
  "category": "libraries",
  "url": [
    "https://gitlab.freedesktop.org/vyivel/libsfdo/-/archive/v0.1.4/libsfdo-0.1.4.tar.gz"
  ],
  "build": {
    "user": [
      "meson setup build --prefix=/usr -Dbuildtype=release .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "budgie/libsfdo.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
