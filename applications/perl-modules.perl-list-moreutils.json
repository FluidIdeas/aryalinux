{
  "name": "perl-modules.perl-list-moreutils",
  "version": "0.430",
  "description": "Perl module perl::list::moreutils used by applications and other Perl packages on the system.",
  "url": "https://www.cpan.org/authors/id/R/RE/REHSACK/List-MoreUtils-0.430.tar.gz",
  "dependencies": {
    "required": [
      "perl-deps.perl-exporter-tiny",
      "perl-deps.perl-list-moreutils-xs"
    ]
  },
  "build": {
    "user": [
      "perl Makefile.PL",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "meta": false,
  "book": "general/perl-modules.html",
  "category": "perl-module",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
