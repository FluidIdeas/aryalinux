{
  "name": "python-modules.pyxdg",
  "version": "0.28",
  "description": "PyXDG is a Python library to access freedesktop.org standards.",
  "url": "https://files.pythonhosted.org/packages/b0/25/7998cd2dec731acbd438fbf91bc619603fc5188de0a9a17699a781840452/pyxdg-0.28.tar.gz",
  "dependencies": {},
  "build": {
    "user": [
      "patch -Np1 -i ../pyxdg-0.28-python3_14-fixes-1.patch",
      "pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD"
    ],
    "package": [
      "pip3 install --root=$DESTDIR --no-index --find-links dist --no-user pyxdg"
    ]
  },
  "meta": false,
  "book": "general/python-modules.html",
  "category": "python-module",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
