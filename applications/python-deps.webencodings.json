{
  "name": "python-deps.webencodings",
  "version": "0.5.1",
  "description": "Python package webencodings required as a dependency of other Python modules.",
  "url": [
    "https://files.pythonhosted.org/packages/source/w/webencodings/webencodings-0.5.1.tar.gz"
  ],
  "dependencies": {},
  "build": {
    "user": [
      "pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD"
    ],
    "package": [
      "pip3 install --root=$DESTDIR --no-index --find-links dist --no-user webencodings"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "general/python-dependencies.html",
  "category": "python-dependency",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
