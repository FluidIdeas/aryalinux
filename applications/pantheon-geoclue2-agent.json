{
  "name": "pantheon-geoclue2-agent",
  "version": "1.0.6",
  "description": "Geoclue agent for Pantheon location services.",
  "category": "desktop-pantheon",
  "url": [
    "https://github.com/elementary/pantheon-agent-geoclue2/archive/refs/tags/1.0.6.tar.gz"
  ],
  "dependencies": {
    "required": [
      "geoclue",
      "glib2",
      "granite",
      "gtk3"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr -Dbuildtype=release  .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "pantheon/pantheon-geoclue2-agent.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
