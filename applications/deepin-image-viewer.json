{
  "name": "deepin-image-viewer",
  "version": "5.9.20",
  "description": "An image viewing tool with fashion interface and smooth performance (Deepin Desktop Environment).",
  "category": "desktop-deepin",
  "dependencies": {
    "required": [
      "deepin-image-editor",
      "deepin-qt5integration",
      "dtkcore",
      "dtkdeclarative",
      "dtkgui",
      "dtkwidget",
      "hicolor-icon-theme",
      "libraw",
      "qt5-base"
    ]
  },
  "build": {
    "user": [
      "cmake . -GNinja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_INSTALL_LIBEXECDIR=lib -DCMAKE_INSTALL_SYSCONFDIR=/etc ",
      "ninja"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "deepin/deepin-image-viewer.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "url": [
    "https://github.com/linuxdeepin/deepin-image-viewer/archive/refs/tags/5.9.20.tar.gz"
  ]
}
