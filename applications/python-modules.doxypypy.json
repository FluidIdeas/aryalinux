{
  "name": "python-modules.doxypypy",
  "version": "0.8.8.7",
  "description": "The Doxypypy package is a doxygen filter for python.",
  "url": [
    "https://files.pythonhosted.org/packages/source/d/doxypypy/doxypypy-0.8.8.7.tar.gz"
  ],
  "dependencies": {
    "required": [
      "doxygen",
      "python-deps.chardet"
    ]
  },
  "build": {
    "user": [
      "pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD"
    ],
    "package": [
      "pip3 install --root=$DESTDIR --no-index --find-links dist --no-user doxypypy"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "general/python-modules.html",
  "category": "python-module",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
