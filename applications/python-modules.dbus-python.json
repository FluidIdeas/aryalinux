{
  "name": "python-modules.dbus-python",
  "version": "1.4.0",
  "description": "Python module dbus-python for scripts and applications that depend on it.",
  "url": [
    "https://dbus.freedesktop.org/releases/dbus-python/dbus-python-1.4.0.tar.xz"
  ],
  "dependencies": {
    "required": [
      "dbus",
      "glib2",
      "patchelf",
      "python-deps.meson_python"
    ]
  },
  "build": {
    "user": [
      "pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD"
    ],
    "package": [
      "pip3 install --root=$DESTDIR --no-index --find-links dist --no-user dbus-python"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "general/python-modules.html",
  "category": "python-module",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
