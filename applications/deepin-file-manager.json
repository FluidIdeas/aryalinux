{
  "name": "deepin-file-manager",
  "version": "1:6.5.10.3",
  "description": "Deepin File Manager (Deepin Desktop Environment).",
  "category": "desktop-deepin",
  "dependencies": {
    "required": [
      "avfs",
      "cryfs",
      "cryptsetup",
      "dconf",
      "deepin-anything",
      "deepin-appearance",
      "deepin-pdfium",
      "deepin-qt-dbus-factory",
      "deepin-service-manager",
      "deepin-util-dfm",
      "docparser",
      "dtkcore",
      "dtkgui",
      "dtklog",
      "dtkwidget",
      "glib2",
      "gsettings-qt5",
      "icu",
      "kcodecs",
      "libsecret",
      "lucene++",
      "polkit-qt",
      "poppler",
      "qt5-base",
      "qt5-multimedia",
      "qt5-svg",
      "qt5-x11extras",
      "taglib"
    ]
  },
  "build": {
    "user": [
      "cmake . -GNinja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_INSTALL_LIBEXECDIR=lib -DCMAKE_INSTALL_SYSCONFDIR=/etc ",
      "ninja"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "deepin/deepin-file-manager.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "url": [
    "https://github.com/linuxdeepin/dde-file-manager/archive/refs/tags/6.5.10.3.tar.gz"
  ]
}
