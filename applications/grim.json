{
  "name": "grim",
  "version": "1.5.0",
  "description": "Screenshot utility for Wayland (portal-wlr dependency).",
  "category": "applications",
  "url": [
    "https://gitlab.freedesktop.org/emersion/grim/-/archive/v1.5.0/grim-v1.5.0.tar.gz"
  ],
  "dependencies": {
    "required": [
      "cairo",
      "libjpeg",
      "wayland",
      "wayland-protocols"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr -Dbuildtype=release .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "budgie/grim.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
