{
  "name": "xapp-symbolic-icons",
  "version": "1.1.0",
  "description": "Symbolic icon set for X-Apps and Cinnamon.",
  "category": "libraries",
  "url": [
    "https://github.com/xapp-project/xapp-symbolic-icons/archive/refs/tags/1.1.0.tar.gz"
  ],
  "dependencies": {
    "required": [
      "hicolor-icon-theme"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr -Dbuildtype=release .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "cinnamon/xapp-symbolic-icons.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
