{
  "name": "zsh",
  "version": "5.9",
  "description": "The zsh package contains a command interpreter (shell) usable as an interactive login shell and as a shell script command processor. Of the standard shells, zsh most closely resembles ksh but includes many enhancements.",
  "url": [
    "https://www.zsh.org/pub/zsh-5.9.tar.xz"
  ],
  "dependencies": {},
  "build": {
    "user": [
      "sed -e 's/set_from_init_file/texinfo_&/' \\\n    -i Doc/Makefile.in",
      "sed -e 's/^main/int &/'      \\\n    -e 's/exit(/return(/'    \\\n    -i aczsh.m4 configure.ac",
      "sed -e 's/test = /&(char**)/' \\\n    -i configure.ac",
      "autoconf",
      "sed -e 's|/etc/z|/etc/zsh/z|g' \\\n    -i Doc/*.*",
      "./configure --prefix=/usr            \\\n            --sysconfdir=/etc/zsh    \\\n            --enable-etcdir=/etc/zsh \\\n            --enable-cap             \\\n            --enable-gdbm",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [
    "grep -qF '/bin/zsh' /etc/shells || echo '/bin/zsh' >> /etc/shells"
  ],
  "meta": false,
  "book": "postlfs/zsh.html",
  "category": "system",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
