{
  "name": "libmicrodns",
  "version": "0.2.0",
  "description": "libmicrodns is a minimal mDNS resolver library.",
  "category": "multimedia",
  "dependencies": {},
  "build": {
    "user": [
      "meson setup build --prefix=/usr --buildtype=release .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "meta": false,
  "book": "multimedia/vlc.html",
  "url": [
    "https://github.com/videolabs/libmicrodns/archive/0.2.0/libmicrodns-0.2.0.tar.gz"
  ],
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
