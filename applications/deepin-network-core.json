{
  "name": "deepin-network-core",
  "version": "2.0.70",
  "description": "DDE network library and plugins (Deepin Desktop Environment).",
  "category": "desktop-deepin",
  "dependencies": {
    "required": []
  },
  "build": {
    "user": [
      "cmake . -GNinja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_INSTALL_LIBEXECDIR=lib -DCMAKE_INSTALL_SYSCONFDIR=/etc ",
      "ninja"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "deepin/deepin-network-core.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "url": [
    "https://github.com/linuxdeepin/dde-network-core/archive/refs/tags/2.0.70.tar.gz"
  ]
}
