{
  "name": "cryptsetup",
  "version": "2.8.4",
  "description": "cryptsetup is used to set up transparent encryption of block devices using the kernel crypto API.",
  "url": "https://www.kernel.org/pub/linux/utils/cryptsetup/v2.8/cryptsetup-2.8.4.tar.xz",
  "dependencies": {
    "required": [
      "json-c",
      "lvm2"
    ]
  },
  "build": {
    "user": [
      "./configure --prefix=/usr       \\\n            --disable-ssh-token \\\n            --disable-asciidoc",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "meta": false,
  "book": "postlfs/cryptsetup.html",
  "category": "security",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
