{
  "name": "libgnomekbd",
  "version": "3.28.1",
  "description": "Keyboard layout library for X-Apps.",
  "category": "libraries",
  "url": [
    "https://gitlab.gnome.org/Archive/libgnomekbd/-/archive/3.28.1/libgnomekbd-3.28.1.tar.gz"
  ],
  "dependencies": {
    "required": [
      "cairo",
      "dconf",
      "gdk-pixbuf",
      "glib2",
      "gtk3",
      "libxklavier",
      "pango"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr -Dbuildtype=release .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "cinnamon/libgnomekbd.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
