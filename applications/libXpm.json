{
  "name": "libXpm",
  "version": "3.5.18",
  "description": "Xorg library libXpm (BLFS chapter).",
  "url": [
    "https://xorg.freedesktop.org/archive/individual/lib/libXpm-3.5.18.tar.xz"
  ],
  "dependencies": {
    "required": [
      "libXmu"
    ]
  },
  "build": {
    "environment": {
      "XORG_PREFIX": "/usr",
      "XORG_CONFIG": "--prefix=/usr --sysconfdir=/etc --localstatedir=/var --disable-static"
    },
    "user": [
      "./configure $XORG_CONFIG --disable-open-zfile",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "x/libXpm.html",
  "category": "x11",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
