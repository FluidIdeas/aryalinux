{
  "name": "xcb-proto",
  "version": "1.17.0",
  "description": "The xcb-proto package provides the XML-XCB protocol descriptions that libxcb uses to generate the majority of its code and API.",
  "url": [
    "https://xorg.freedesktop.org/archive/individual/proto/xcb-proto-1.17.0.tar.xz"
  ],
  "dependencies": {},
  "build": {
    "environment": {
      "XORG_PREFIX": "/usr",
      "XORG_CONFIG": "--prefix=/usr --sysconfdir=/etc --localstatedir=/var --disable-static"
    },
    "user": [
      "PYTHON=python3 ./configure $XORG_CONFIG"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [
    "rm -f /usr/lib/pkgconfig/xcb-proto.pc"
  ],
  "meta": false,
  "book": "x/xcb-proto.html",
  "category": "x11",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
