{
  "name": "dtk6core",
  "version": "6.0.50",
  "description": "DTK core modules (Deepin Desktop Environment).",
  "category": "desktop-deepin",
  "dependencies": {
    "required": [
      "deepin-desktop-base",
      "dtk6log",
      "dtkcommon",
      "icu",
      "lshw",
      "qt6",
      "uchardet"
    ]
  },
  "build": {
    "user": [
      "cmake . -GNinja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_INSTALL_LIBEXECDIR=lib -DBUILD_DOCS=OFF -DBUILD_TESTING=OFF",
      "ninja"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "deepin/dtk6core.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "url": [
    "https://github.com/linuxdeepin/dtk6core/archive/refs/tags/6.0.50.tar.gz"
  ]
}
