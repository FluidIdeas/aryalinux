{
  "name": "libaom",
  "version": "3.13.1",
  "description": "",
  "category": "",
  "dependencies": {
    "required": [
      "yasm"
    ]
  },
  "build": {
    "user": [
      "patch -Np1 -i ../libaom-3.13.1-nasm3-1.patch",
      "sed -i 's/aom aom_static/aom/' build/cmake/aom_install.cmake",
      "cmake -B aom-build -D CMAKE_INSTALL_PREFIX=/usr \\\n      -D CMAKE_BUILD_TYPE=Release  \\\n      -D BUILD_SHARED_LIBS=1       \\\n      -D ENABLE_DOCS=no            \\\n      -G Ninja .",
      "ninja -C aom-build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C aom-build install",
      "rm -f $DESTDIR/usr/lib/libaom.a"
    ]
  },
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "meta": false,
  "book": "multimedia/libaom.html",
  "url": [
    "https://storage.googleapis.com/aom-releases/libaom-3.13.1.tar.gz"
  ],
  "additionalUrls": [
    "https://www.linuxfromscratch.org/patches/blfs/13.0/libaom-3.13.1-nasm3-1.patch"
  ]
}
