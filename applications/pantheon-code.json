{
  "name": "pantheon-code",
  "version": "8.3.0",
  "description": "Pantheon code editor.",
  "category": "applications",
  "url": [
    "https://github.com/elementary/code/archive/refs/tags/8.3.0.tar.gz"
  ],
  "dependencies": {
    "required": [
      "glib2",
      "granite",
      "gtk3",
      "gtksourceview4",
      "libhandy",
      "libpeas-2"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr -Dbuildtype=release  .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "pantheon/pantheon-code.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
