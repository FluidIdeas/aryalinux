{
  "name": "emacs",
  "version": "30.2",
  "description": "The Emacs package contains an extensible, customizable, self-documenting real-time display editor.",
  "url": [
    "https://ftpmirror.gnu.org/emacs/emacs-30.2.tar.xz"
  ],
  "dependencies": {
    "required": [
      "giflib",
      "gnutls",
      "harfbuzz",
      "jansson",
      "libtiff"
    ]
  },
  "build": {
    "user": [
      "./configure --prefix=/usr",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [
    "gtk-update-icon-cache -qtf /usr/share/icons/hicolor"
  ],
  "meta": false,
  "book": "postlfs/emacs.html",
  "category": "system",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
