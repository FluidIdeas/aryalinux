{
  "name": "libportal",
  "version": "0.9.1",
  "description": "The libportal package provides a library that contains GIO-style async APIs for most Flatpak portals.",
  "url": "https://github.com/flatpak/libportal/releases/download/0.9.1/libportal-0.9.1.tar.xz",
  "dependencies": {
    "required": [
      "glib2",
      "gtk3"
    ]
  },
  "build": {
    "user": [
      "patch -Np1 -i ../libportal-0.9.1-qt6.9_fixes-1.patch",
      "mkdir build",
      "cd    build",
      "meson setup --prefix=/usr       \\\n            --buildtype=release \\\n            -D vapi=false       \\\n            -D docs=false       \\\n            ..",
      "ninja",
      "sed -i \"/output/s/-1/-0.9.1/\" ../doc/meson.build",
      "meson configure -D docs=true",
      "ninja",
      "if [ -e /usr/include/libportal ]; then\n    rm -rf /usr/include/libportal.old",
      "mv -vf /usr/include/libportal{,.old}\nfi"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja install"
    ]
  },
  "meta": false,
  "book": "general/libportal.html",
  "category": "libraries",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
