{
  "name": "capnet-assist",
  "version": "8.0.2",
  "description": "Captive portal assistant for Pantheon.",
  "category": "desktop-pantheon",
  "url": [
    "https://github.com/elementary/capnet-assist/archive/refs/tags/8.0.2.tar.gz"
  ],
  "dependencies": {
    "required": [
      "gcr",
      "glib2",
      "granite7",
      "gtk4",
      "libadwaita",
      "networkmanager",
      "webkitgtk"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr -Dbuildtype=release  .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "pantheon/capnet-assist.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
