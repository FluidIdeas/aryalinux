{
  "name": "kio-extras",
  "version": "25.12.2",
  "description": "The kio-extras package contains additional components to increase the functionality of the KDE resource and network access abstractions.",
  "url": "https://download.kde.org/stable/release-service/25.12.2/src/kio-extras-25.12.2.tar.xz",
  "dependencies": {
    "required": [
      "frameworks6",
      "kdsoap-ws-discovery-client",
      "libproxy",
      "qcoro",
      "libkexiv2"
    ]
  },
  "build": {
    "user": [
      "mkdir build",
      "cd    build",
      "cmake -D CMAKE_INSTALL_PREFIX=$KF6_PREFIX \\\n      -D CMAKE_BUILD_TYPE=Release         \\\n      -D BUILD_TESTING=OFF                \\\n      -W no-dev ..",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "meta": false,
  "book": "kde/kio-extras.html",
  "category": "desktop-kde",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
