{
  "name": "gnome-connections",
  "version": "49.0",
  "description": "",
  "category": "",
  "dependencies": {
    "required": [
      "appstream",
      "gtk-vnc",
      "itstool",
      "libhandy1",
      "libsecret",
      "vala"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr --buildtype=release .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "meta": false,
  "book": "gnome/gnome-connections.html",
  "url": [
    "https://download.gnome.org/sources/gnome-connections/49/gnome-connections-49.0.tar.xz"
  ]
}
