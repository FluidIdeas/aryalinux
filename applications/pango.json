{
  "name": "pango",
  "version": "1.57.0",
  "description": "Pango is a library for laying out and rendering text, with an emphasis on internationalization. It can be used anywhere that text layout is needed, though most of the work on Pango so far has been done in the context of the GTK+ widget toolkit.",
  "url": [
    "https://download.gnome.org/sources/pango/1.57/pango-1.57.0.tar.xz"
  ],
  "dependencies": {
    "required": [
      "cairo",
      "fontconfig",
      "freetype2",
      "fribidi",
      "glib2",
      "harfbuzz",
      "x7lib"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr            \\\n            --buildtype=release      \\\n            --wrap-mode=nofallback   \\\n            -D introspection=enabled \\\n            .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "x/pango.html",
  "category": "x11",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
