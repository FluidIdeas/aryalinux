{
  "name": "docparser",
  "version": "1.0.26",
  "description": "A document parser library ported from document2html (Deepin Desktop Environment).",
  "category": "desktop-deepin",
  "dependencies": {
    "required": [
      "freetype2",
      "libxml2",
      "libzip",
      "gnome-poppler"
    ]
  },
  "build": {
    "user": [
      "sed -i 's/add_link_options(-z noexecstack -pie -fPIC)/add_link_options(-z noexecstack)/' CMakeLists.txt",
      "cmake . -GNinja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_INSTALL_LIBEXECDIR=lib -DCMAKE_INSTALL_SYSCONFDIR=/etc -DBUILD_TESTS=OFF",
      "ninja"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "deepin/docparser.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "url": [
    "https://github.com/linuxdeepin/docparser/archive/refs/tags/1.0.26.tar.gz"
  ]
}
