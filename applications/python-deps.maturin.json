{
  "name": "python-deps.maturin",
  "version": "1.12.3",
  "description": "Python package maturin required as a dependency of other Python modules.",
  "url": [
    "https://github.com/PyO3/maturin/archive/v1.12.3/maturin-1.12.3.tar.gz"
  ],
  "dependencies": {},
  "build": {
    "user": [
      "pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD"
    ],
    "package": [
      "pip3 install --root=$DESTDIR --no-index --find-links dist --no-user maturin"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "general/python-dependencies.html",
  "category": "python-dependency",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
