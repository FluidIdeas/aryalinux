{
  "name": "deepin-desktop-schemas",
  "version": "6.0.13",
  "description": "GSettings deepin desktop-wide schemas (Deepin Desktop Environment).",
  "category": "desktop-deepin",
  "dependencies": {
    "required": [
      "dconf",
      "deepin-gtk-theme",
      "deepin-icon-theme",
      "deepin-sound-theme"
    ]
  },
  "build": {
    "environment": {
      "CGO_CPPFLAGS": "$CPPFLAGS",
      "CGO_CFLAGS": "$CFLAGS",
      "CGO_CXXFLAGS": "$CXXFLAGS",
      "CGO_LDFLAGS": "$LDFLAGS",
      "GOFLAGS": "-buildmode=pie -trimpath -mod=readonly -modcacherw"
    },
    "user": [
      "make"
    ],
    "package": [
      "make DESTDIR=$DESTDIR install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "deepin/deepin-desktop-schemas.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "url": [
    "https://github.com/linuxdeepin/deepin-desktop-schemas/archive/refs/tags/6.0.13.tar.gz"
  ]
}
