{
  "name": "deepin-boot-maker",
  "version": "6.0.17",
  "description": "Tool to create a bootable usb stick quick and easy (Deepin Desktop Environment).",
  "category": "desktop-deepin",
  "dependencies": {
    "required": [
      "7zip",
      "cdrtools",
      "dosfstools",
      "dtk6core",
      "dtk6gui",
      "dtk6widget",
      "polkit-qt",
      "qt6",
      "udisks2"
    ]
  },
  "build": {
    "user": [
      "make"
    ],
    "package": [
      "make DESTDIR=$DESTDIR install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "deepin/deepin-boot-maker.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "url": [
    "https://github.com/linuxdeepin/deepin-boot-maker/archive/refs/tags/6.0.17.tar.gz"
  ]
}
