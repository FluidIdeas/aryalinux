{
  "name": "v4l-utils",
  "version": "1.32.0",
  "description": "v4l-utils provides a series of utilities for media devices, allowing the ability to handle the proprietary formats available from most webcams (libv4l), and providing tools to test V4L devices.",
  "url": [
    "https://www.linuxtv.org/downloads/v4l-utils/v4l-utils-1.32.0.tar.xz"
  ],
  "dependencies": {
    "required": [
      "alsa-lib",
      "libjpeg"
    ]
  },
  "build": {
    "user": [
      "sed -i '/^ir_bpf_enabled/s/=.*/= false/' utils/keytable/meson.build",
      "meson setup build            \\\n      --prefix=/usr       \\\n      --buildtype=release \\\n      -D gconv=disabled   \\\n      -D doxygen-doc=disabled \\\n      .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install",
      "for prog in v4l2gl v4l2grab\ndo\n   install -v -m755 contrib/test/$prog $DESTDIR/usr/bin\ndone"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "multimedia/v4l-utils.html",
  "category": "multimedia",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
