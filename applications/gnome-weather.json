{
  "name": "gnome-weather",
  "version": "48.0",
  "description": "GNOME Weather is a small application that allows you to monitor the current weather conditions for your city, or anywhere in the world, and to access updated forecasts provided by various internet services.",
  "url": "https://download.gnome.org/sources/gnome-weather/48/gnome-weather-48.0.tar.xz",
  "dependencies": {
    "required": [
      "geoclue2",
      "gjs"
    ]
  },
  "build": {
    "user": [
      "mkdir build",
      "cd    build",
      "meson setup --prefix=/usr --buildtype=release ..",
      "ninja"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja install"
    ]
  },
  "meta": false,
  "book": "gnome/gnome-weather.html",
  "category": "desktop-gnome",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
