{
  "name": "xkeyboard-config",
  "version": "2.46",
  "description": "The XKeyboardConfig package contains the keyboard configuration database for the X Window System.",
  "url": [
    "https://www.x.org/pub/individual/data/xkeyboard-config/xkeyboard-config-2.46.tar.xz"
  ],
  "dependencies": {
    "required": [
      "x7lib"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=$XORG_PREFIX --buildtype=release .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "x/xkeyboard-config.html",
  "category": "x11",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
