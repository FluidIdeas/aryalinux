{
  "name": "perl-modules.perl-html-parser",
  "version": "3.83",
  "description": "Perl module perl::html::parser used by applications and other Perl packages on the system.",
  "url": "https://www.cpan.org/authors/id/O/OA/OALDERS/HTML-Parser-3.83.tar.gz",
  "dependencies": {
    "required": [
      "perl-deps.perl-html-tagset",
      "perl-deps.perl-http-message"
    ]
  },
  "build": {
    "user": [
      "perl Makefile.PL",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "general/perl-modules.html",
  "category": "perl-module",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
