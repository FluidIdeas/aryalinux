{
  "name": "neon",
  "version": "0.36.0",
  "description": "neon is an HTTP and WebDAV client library, with a C interface.",
  "url": "https://notroj.github.io/neon/neon-0.36.0.tar.gz",
  "dependencies": {},
  "build": {
    "user": [
      "./configure --prefix=/usr    \\\n            --with-ssl       \\\n            --enable-shared  \\\n            --disable-static",
      "make",
      "make docs"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "meta": false,
  "book": "basicnet/neon.html",
  "category": "networking",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
