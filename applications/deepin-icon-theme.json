{
  "name": "deepin-icon-theme",
  "version": "2026.02.27",
  "description": "Icon theme for Deepin Desktop Environment.",
  "category": "desktop-deepin",
  "build": {
    "user": [
      "make hicolor-links"
    ],
    "package": [
      "make DESTDIR=$DESTDIR install",
      "cp -a ./Sea ./usr/share/icons/hicolor $DESTDIR/usr/share/icons/"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "deepin/deepin-icon-theme.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "url": [
    "https://github.com/linuxdeepin/deepin-icon-theme/archive/refs/tags/2026.02.27.tar.gz"
  ]
}
