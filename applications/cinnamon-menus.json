{
  "name": "cinnamon-menus",
  "version": "6.6.0",
  "description": "Menu specification library for Cinnamon.",
  "category": "libraries",
  "url": [
    "https://github.com/linuxmint/cinnamon-menus/archive/refs/tags/6.6.0.tar.gz"
  ],
  "dependencies": {
    "required": [
      "glib2"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr -Dbuildtype=release .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "cinnamon/cinnamon-menus.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
