{
  "name": "libcanberra",
  "version": "0.30",
  "description": "libcanberra is an implementation of the XDG Sound Theme and Name Specifications, for generating event sounds on free desktops, such as GNOME.",
  "url": [
    "https://0pointer.de/lennart/projects/libcanberra/libcanberra-0.30.tar.xz"
  ],
  "dependencies": {
    "required": [
      "libvorbis",
      "alsa-lib",
      "gtk3",
      "sound-theme-freedesktop"
    ]
  },
  "build": {
    "pre": [
      "patch -Np1 -i ../libcanberra-0.30-wayland-1.patch"
    ],
    "user": [
      "./configure --prefix=/usr --disable-oss",
      "make"
    ],
    "package": [
      "make docdir=/usr/share/doc/libcanberra-0.30 install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "multimedia/libcanberra.html",
  "category": "multimedia",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "additionalUrls": [
    "https://www.linuxfromscratch.org/patches/blfs/13.0/libcanberra-0.30-wayland-1.patch"
  ]
}
