{
  "name": "elementary-wallpapers",
  "version": "8.0.0",
  "description": "Elementary desktop wallpapers.",
  "category": "desktop-pantheon",
  "url": [
    "https://github.com/elementary/wallpapers/archive/refs/tags/8.0.0.tar.gz"
  ],
  "dependencies": {
    "required": []
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr -Dbuildtype=release  .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "pantheon/elementary-wallpapers.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
