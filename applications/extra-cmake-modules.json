{
  "name": "extra-cmake-modules",
  "version": "6.23.0",
  "description": "The Extra CMake Modules package contains extra CMake modules used by KDE Frameworks and other packages.",
  "url": "https://download.kde.org/stable/frameworks/6.23/extra-cmake-modules-6.23.0.tar.xz",
  "dependencies": {
    "required": [
      "cmake",
      "qt6"
    ]
  },
  "build": {
    "user": [
      "sed -i '/\"lib64\"/s/64//' kde-modules/KDEInstallDirsCommon.cmake",
      "sed -e '/PACKAGE_INIT/i set(SAVE_PACKAGE_PREFIX_DIR \"${PACKAGE_PREFIX_DIR}\")' \\\n    -e '/^include/a set(PACKAGE_PREFIX_DIR \"${SAVE_PACKAGE_PREFIX_DIR}\")' \\\n    -i ECMConfig.cmake.in",
      "mkdir build",
      "cd    build",
      "cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n      -D BUILD_WITH_QT6=ON         \\\n      -D DOC_INSTALL_DIR=/usr/share/doc/extra-cmake-modules-6.23.0 \\\n      ..",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "meta": false,
  "book": "kde/extra-cmake-modules.html",
  "category": "desktop-kde",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
