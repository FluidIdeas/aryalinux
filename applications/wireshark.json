{
  "name": "wireshark",
  "version": "4.6.3",
  "description": "The Wireshark package contains a network protocol analyzer, also known as a “sniffer.” This is useful for analyzing data captured “off the wire” from a live network connection, or data read from a capture file.",
  "url": "https://www.wireshark.org/download/src/all-versions/wireshark-4.6.3.tar.xz",
  "dependencies": {
    "required": [
      "cmake",
      "c-ares",
      "libgcrypt",
      "speex",
      "libpcap"
    ]
  },
  "build": {
    "user": [
      "mkdir build",
      "cd    build",
      "cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n      -D CMAKE_BUILD_TYPE=Release  \\\n      -D CMAKE_INSTALL_DOCDIR=/usr/share/doc/wireshark-4.6.3 \\\n      -G Ninja \\\n      ..",
      "ninja",
      "groupadd -g 62 wireshark",
      "pushd /usr/share/doc/wireshark-4.6.3",
      "for FILENAME in ../../wireshark/*.html; do\n      ln -s -v -f $FILENAME .\n   done",
      "popd\nunset FILENAME",
      "chown -v root:wireshark /usr/bin/tshark",
      "chmod -v 6550 /usr/bin/tshark",
      "usermod -a -G wireshark <username>"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja install",
      "install -v -m755 -d $DESTDIR/usr/share/doc/wireshark-4.6.3",
      "install -v -m644    ../README.linux ../doc/README.* ../doc/randpkt.txt \\\n                    $DESTDIR/usr/share/doc/wireshark-4.6.3",
      "install -v -m644 <Downloaded_Files> \\\n                 $DESTDIR/usr/share/doc/wireshark-4.6.3"
    ]
  },
  "meta": false,
  "book": "basicnet/wireshark.html",
  "category": "networking",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
