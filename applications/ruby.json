{
  "name": "ruby",
  "version": "4.0.1",
  "description": "The Ruby package contains the Ruby development environment. This is useful for object-oriented scripting.",
  "url": "https://cache.ruby-lang.org/pub/ruby/4.0/ruby-4.0.1.tar.xz",
  "dependencies": {
    "required": [
      "libyaml"
    ]
  },
  "build": {
    "user": [
      "./configure --prefix=/usr         \\\n            --disable-rpath       \\\n            --enable-shared       \\\n            --without-valgrind    \\\n            --without-baseruby    \\\n            ac_cv_func_qsort_r=no \\\n            --docdir=/usr/share/doc/ruby-4.0.1",
      "make",
      "make capi",
      "cd /path/to/web/app\nbundle update rake"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "meta": false,
  "book": "general/ruby.html",
  "category": "programming",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
