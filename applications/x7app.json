{
  "name": "x7app",
  "version": "7",
  "description": "BLFS Xorg Applications chapter — metapackage installing all X11 apps in dependency order.",
  "category": "metapackage",
  "dependencies": {
    "required": [
      "libpng",
      "mesa",
      "xbitmaps",
      "xcb-util"
    ]
  },
  "build": {},
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "post_install": [
    "rm -f /usr/bin/xkeystone"
  ],
  "meta": true,
  "book": "x/x7app.html"
}
