{
  "name": "x7app",
  "version": "7",
  "description": "BLFS Xorg Applications chapter \u2014 metapackage installing all X11 apps in dependency order.",
  "category": "metapackage",
  "dependencies": {
    "required": [
      "iceauth",
      "mkfontscale",
      "sessreg",
      "setxkbmap",
      "smproxy",
      "xauth",
      "xcmsdb",
      "xcursorgen",
      "xdpyinfo",
      "xdriinfo",
      "xev",
      "xgamma",
      "xhost",
      "xinput",
      "xkbcomp",
      "xkbevd",
      "xkbutils",
      "xkill",
      "xlsatoms",
      "xlsclients",
      "xmessage",
      "xmodmap",
      "xpr",
      "xprop",
      "xrandr",
      "xrdb",
      "xrefresh",
      "xset",
      "xsetroot",
      "xvinfo",
      "xwd",
      "xwininfo",
      "xwud"
    ]
  },
  "build": {},
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "post_install": [
    "rm -f /usr/bin/xkeystone"
  ],
  "meta": true,
  "book": "x/x7app.html"
}
