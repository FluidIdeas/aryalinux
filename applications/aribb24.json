{
  "name": "aribb24",
  "version": "1.0.3",
  "description": "aribb24 is a library for ARIB STD-B24 caption decoding.",
  "category": "multimedia",
  "dependencies": {
    "required": [
      "alsa-lib",
      "desktop-file-utils",
      "ffmpeg",
      "installing",
      "liba52",
      "libgcrypt",
      "libmad",
      "lua",
      "qt6"
    ]
  },
  "build": {
    "user": [
      "./configure --prefix=/usr \\\n            --disable-static",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "meta": false,
  "book": "multimedia/vlc.html",
  "url": [
    "https://github.com/nkoriyama/aribb24/archive/v1.0.3/aribb24-1.0.3.tar.gz"
  ],
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
