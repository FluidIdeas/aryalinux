{
  "name": "python-modules.pypa-build",
  "version": "1.4.0",
  "description": "",
  "category": "",
  "dependencies": {
    "required": [
      "python-deps.pyproject-hooks"
    ]
  },
  "build": {
    "user": [
      "pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD",
      "python3 -m venv --system-site-packages testenv",
      "source testenv/bin/activate",
      "pip3 install --group test",
      "python3 -m pytest\ndeactivate"
    ],
    "package": [
      "pip3 install --root=$DESTDIR --no-index --find-links dist --no-user build"
    ]
  },
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "meta": false,
  "book": "general/python-modules.html",
  "url": [
    "https://files.pythonhosted.org/packages/source/b/build/build-1.4.0.tar.gz"
  ]
}
