{
  "name": "gnome-system-monitor",
  "version": "49.1",
  "description": "The GNOME System Monitor package contains GNOME's replacement for gtop.",
  "url": "https://download.gnome.org/sources/gnome-system-monitor/49/gnome-system-monitor-49.1.tar.xz",
  "dependencies": {
    "required": [
      "adwaita-icon-theme",
      "gtkmm4",
      "libgtop"
    ]
  },
  "build": {
    "user": [
      "find . -name meson.build | xargs sed -i -e '/catch2/d'",
      "sed -i '145,155d' src/meson.build",
      "meson setup build --prefix=/usr --buildtype=release .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "gnome/gnome-system-monitor.html",
  "category": "desktop-gnome",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
