{
  "name": "fluxbox",
  "version": "1.3.7",
  "description": "The Fluxbox package contains a window manager.",
  "url": "https://downloads.sourceforge.net/fluxbox/fluxbox-1.3.7.tar.xz",
  "dependencies": {
    "required": [
      "installing"
    ]
  },
  "build": {
    "user": [
      "sed -i '/text_prop.value > 0/s/>/!=/' util/fluxbox-remote.cc",
      "./configure --prefix=/usr",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR",
      "install -d $DESTDIR/usr/share/xsessions",
      "install -vdm755 $DESTDIR/usr/share/xsessions",
      "cat > $DESTDIR/usr/share/xsessions/fluxbox.desktop << \"EOF\"\n[Desktop Entry]\nEncoding=UTF-8\nName=Fluxbox\nComment=This session logs you into Fluxbox\nExec=startfluxbox\nType=Application\nEOF"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "x/fluxbox.html",
  "category": "x11",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
