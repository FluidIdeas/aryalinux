{
  "name": "libxkbcommon",
  "version": "1.13.1",
  "description": "libxkbcommon is a keymap compiler and support library which processes a reduced subset of keymaps as defined by the XKB specification.",
  "url": [
    "https://github.com/lfs-book/libxkbcommon/archive/v1.13.1/libxkbcommon-1.13.1.tar.gz"
  ],
  "dependencies": {
    "required": [
      "xkeyboard-config",
      "libxcb",
      "wayland-protocols"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr        \\\n      --buildtype=release  \\\n      -D enable-docs=false .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "general/libxkbcommon.html",
  "category": "libraries",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
