{
  "name": "libuv",
  "version": "1.52.0",
  "description": "The libuv package is a multi-platform support library with a focus on asynchronous I/O.",
  "url": "https://dist.libuv.org/dist/v1.52.0/libuv-v1.52.0.tar.gz",
  "dependencies": {},
  "build": {
    "user": [
      "sh autogen.sh",
      "./configure --prefix=/usr --disable-static",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "general/libuv.html",
  "category": "libraries",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
