{
  "name": "enchant",
  "version": "2.8.15",
  "description": "The enchant package provides a generic interface into various existing spell checking libraries.",
  "url": [
    "https://github.com/rrthomas/enchant/releases/download/v2.8.15/enchant-2.8.15.tar.gz"
  ],
  "dependencies": {
    "required": [
      "aspell",
      "glib2",
      "vala"
    ]
  },
  "build": {
    "user": [
      "./configure --prefix=/usr     \\\n            --sysconfdir=/etc \\\n            --disable-static  \\\n            --docdir=/usr/share/doc/enchant-2.8.15",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "general/enchant.html",
  "category": "libraries",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
