{
  "name": "plasma-graphics-tools",
  "version": "1.0",
  "description": "AryaLinux utilities to switch Plasma between X11 and Wayland and to diagnose display/GPU problems.",
  "category": "desktop-kde",
  "url": [
    "https://raw.githubusercontent.com/FluidIdeas/aryalinux/main/graphics/plasma-graphics-tools-1.0.tar.xz"
  ],
  "dependencies": {
    "required": [
      "plasma-login-manager"
    ],
    "recommended": [
      "nouveau-firmware",
      "pciutils"
    ]
  },
  "build": {
    "user": [
      "test -x plasma-graphics-tools/aryalinux-plasma-session || { echo 'plasma-graphics-tools: scripts missing in source tree' >&2; exit 1; }",
      "echo \"$PWD/plasma-graphics-tools\" > .scripts-path"
    ],
    "package": [
      "SCRIPTS=$(cat .scripts-path) && install -Dm755 \"$SCRIPTS/aryalinux-plasma-session\" $DESTDIR/usr/bin/aryalinux-plasma-session",
      "SCRIPTS=$(cat .scripts-path) && install -Dm755 \"$SCRIPTS/aryalinux-graphics-diagnose\" $DESTDIR/usr/bin/aryalinux-graphics-diagnose",
      "SCRIPTS=$(cat .scripts-path) && install -d $DESTDIR/usr/share/doc/plasma-graphics-tools-1.0 && install -m644 \"$SCRIPTS/README.md\" $DESTDIR/usr/share/doc/plasma-graphics-tools-1.0/README.md"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "kde/plasma-all.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
