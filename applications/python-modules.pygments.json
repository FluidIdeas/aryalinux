{
  "name": "python-modules.pygments",
  "version": "2.19.2",
  "description": "Pygments is a general syntax highlighter written in Python, for more than 300 languages.",
  "url": "https://files.pythonhosted.org/packages/source/P/Pygments/pygments-2.19.2.tar.gz",
  "dependencies": {
    "required": [
      "python-deps.hatchling"
    ]
  },
  "build": {
    "user": [
      "pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD"
    ],
    "package": [
      "pip3 install --root=$DESTDIR --no-index --find-links dist --no-user Pygments"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "general/python-modules.html",
  "category": "python-module",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
