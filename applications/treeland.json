{
  "name": "treeland",
  "version": "0.8.7",
  "description": "Wayland compositor for Deepin Desktop Environment.",
  "category": "desktop-deepin",
  "dependencies": {
    "required": [
      "ddm",
      "deepin-session",
      "dtk6core",
      "dtk6declarative",
      "dtk6systemsettings",
      "libdrm",
      "libinput",
      "linux-pam",
      "mpv",
      "pixman",
      "qt6",
      "systemd",
      "wayland",
      "wlroots0.19",
      "xwayland"
    ]
  },
  "build": {
    "user": [
      "sed -i 's|/usr/share/backgrounds/default_background.jpg|/usr/share/backgrounds/deepin/desktop.jpg|' misc/dconfig/org.deepin.dde.treeland.json misc/dconfig/org.deepin.dde.treeland.user.json",
      "sed -i 's|/usr/share/wallpapers/deepin/deepin-default.jpg|/usr/share/wallpapers/deepin/desktop.jpg|' src/wallpaper/wallpapermanager.cpp",
      "cmake . -B build -G Ninja -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_INSTALL_LIBEXECDIR=lib -DCMAKE_INSTALL_SYSCONFDIR=/etc -DCMAKE_INSTALL_PREFIX=/usr",
      "cmake --build build"
    ],
    "package": [
      "DESTDIR=$DESTDIR cmake --install build"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "deepin/treeland.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "url": [
    "https://github.com/linuxdeepin/treeland/archive/refs/tags/0.8.7.tar.gz"
  ]
}
