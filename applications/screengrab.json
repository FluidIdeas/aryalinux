{
  "name": "screengrab",
  "version": "3.1.0",
  "description": "",
  "category": "",
  "dependencies": {
    "required": [
      "libqtxdg",
      "lxqt-build-tools",
      "lxqt-kwindowsystem"
    ]
  },
  "build": {
    "user": [
      "cmake -B build -D CMAKE_BUILD_TYPE=Release  \\\n      -D CMAKE_INSTALL_PREFIX=/usr \\\n      .",
      "make -C build"
    ],
    "package": [
      "make -C build install DESTDIR=$DESTDIR"
    ]
  },
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "meta": false,
  "book": "lxqt/screengrab.html",
  "url": [
    "https://github.com/lxqt/screengrab/releases/download/3.1.0/screengrab-3.1.0.tar.xz"
  ]
}
