{
  "name": "gtk4",
  "version": "4.20.3",
  "description": "The GTK 4 package contains libraries used for creating graphical user interfaces for applications.",
  "url": [
    "https://download.gnome.org/sources/gtk/4.20/gtk-4.20.3.tar.xz"
  ],
  "dependencies": {
    "required": [
      "gdk-pixbuf",
      "glib2",
      "glslc",
      "graphene",
      "gst10-plugins-bad",
      "hicolor-icon-theme",
      "iso-codes",
      "libepoxy",
      "librsvg",
      "libvpx",
      "libxkbcommon",
      "pango",
      "python-modules.pygobject3",
      "vulkan-loader",
      "wayland-protocols"
    ],
    "runtime": [
      "adwaita-icon-theme"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr --buildtype=release -D broadway-backend=true -D introspection=enabled -D vulkan=enabled .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "x/gtk4.html",
  "category": "x11",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
