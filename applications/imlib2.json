{
  "name": "imlib2",
  "version": "1.12.6",
  "description": "imlib2 is a graphics library for fast file loading, saving, rendering and manipulation.",
  "url": [
    "https://downloads.sourceforge.net/enlightenment/imlib2-1.12.6.tar.xz"
  ],
  "dependencies": {
    "required": [
      "giflib",
      "librsvg",
      "x7lib"
    ]
  },
  "build": {
    "user": [
      "./configure --prefix=/usr --disable-static",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "x/imlib2.html",
  "category": "x11",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
