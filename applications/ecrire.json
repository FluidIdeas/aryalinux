{
  "name": "ecrire",
  "version": "0.2.0",
  "description": "EFL simple text editor.",
  "category": "applications",
  "url": [
    "https://download.enlightenment.org/rel/apps/ecrire/ecrire-0.2.0.tar.xz"
  ],
  "dependencies": {
    "required": [
      "efl"
    ]
  },
  "build": {
    "environment": {
      "CFLAGS": "$CFLAGS -fvisibility=hidden"
    },
    "user": [
      "meson setup build --prefix=/usr .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install",
      "install -Dm644 -t $DESTDIR/usr/share/licenses/ecrire/ AUTHORS"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "enlightenment/ecrire.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
