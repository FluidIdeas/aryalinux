{
  "name": "libqrencode",
  "version": "4.1.1",
  "description": "",
  "category": "",
  "dependencies": {
    "required": [
      "libpng"
    ]
  },
  "build": {
    "user": [
      "sh autogen.sh",
      "./configure --prefix=/usr",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "meta": false,
  "book": "general/libqrencode.html",
  "url": [
    "https://github.com/fukuchi/libqrencode/archive/v4.1.1/libqrencode-4.1.1.tar.gz"
  ]
}
