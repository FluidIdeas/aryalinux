{
  "name": "perl-deps.perl-http-negotiate",
  "version": "6.01",
  "description": "Perl module perl::http::negotiate providing build-time or runtime support for other Perl packages.",
  "url": [
    "https://cpan.metacpan.org/authors/id/G/GA/GAAS/HTTP-Negotiate-6.01.tar.gz"
  ],
  "dependencies": {
    "required": [
      "perl-deps.perl-http-message"
    ]
  },
  "build": {
    "user": [
      "perl Makefile.PL",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "general/perl-deps.html",
  "category": "perl-dependency",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
