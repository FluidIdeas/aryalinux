{
  "name": "libmusicbrainz5",
  "version": "5.1.0",
  "description": "The libmusicbrainz package contains a library which allows you to access the data held on the MusicBrainz server.",
  "url": "https://github.com/metabrainz/libmusicbrainz/releases/download/release-5.1.0/libmusicbrainz-5.1.0.tar.gz",
  "dependencies": {
    "required": [
      "cmake",
      "neon"
    ]
  },
  "build": {
    "user": [
      "patch -Np1 -i ../libmusicbrainz-5.1.0-cmake_fixes-1.patch",
      "sed -e 's/xmlErrorPtr /const xmlError */'     \\\n    -i src/xmlParser.cc",
      "cmake -B build -D CMAKE_INSTALL_PREFIX=/usr \\\n      -D CMAKE_BUILD_TYPE=Release  \\\n      -D CMAKE_POLICY_VERSION_MINIMUM=3.5 .",
      "make -C build"
    ],
    "package": [
      "make -C build install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "multimedia/libmusicbrainz5.html",
  "category": "multimedia",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
