{
  "name": "nodejs",
  "version": "22.22.0",
  "description": "The Node.js package manager.",
  "url": [
    "https://nodejs.org/dist/v22.22.0/node-v22.22.0.tar.xz"
  ],
  "dependencies": {
    "required": [
      "brotli",
      "c-ares",
      "icu",
      "libuv",
      "nghttp2",
      "which"
    ]
  },
  "build": {
    "user": [
      "patch -Np1 -i ../node-v22.22.0-python_build_fix-1.patch",
      "./configure --prefix=/usr          \\\n            --shared-brotli        \\\n            --shared-cares         \\\n            --shared-libuv         \\\n            --shared-openssl       \\\n            --shared-nghttp2       \\\n            --shared-zlib          \\\n            --with-intl=system-icu",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "general/nodejs.html",
  "category": "libraries",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "additionalUrls": [
    "https://www.linuxfromscratch.org/patches/blfs/13.0/node-v22.22.0-python_build_fix-1.patch"
  ]
}
