{
  "name": "mousepad",
  "version": "0.6.5",
  "description": "Mousepad is a simple GTK text editor for the Xfce desktop environment.",
  "url": [
    "https://archive.xfce.org/src/apps/mousepad/0.6/mousepad-0.6.5.tar.xz"
  ],
  "dependencies": {
    "required": [
      "gspell",
      "gtksourceview4",
      "libxfce4ui"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr       \\\n            --buildtype=release",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "postlfs/mousepad.html",
  "category": "system",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
