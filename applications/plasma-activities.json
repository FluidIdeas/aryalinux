{
  "name": "plasma-activities",
  "version": "6.6.1",
  "description": "",
  "category": "",
  "dependencies": {
    "required": [
      "frameworks6"
    ]
  },
  "build": {
    "user": [
      "cmake -B build -D CMAKE_INSTALL_PREFIX=$KF6_PREFIX \\\n      -D CMAKE_BUILD_TYPE=Release         \\\n      -D BUILD_TESTING=OFF                \\\n      -W no-dev .",
      "make -C build"
    ],
    "package": [
      "make -C build install DESTDIR=$DESTDIR"
    ],
    "environment": {
      "KF6_PREFIX": "/usr"
    }
  },
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "meta": false,
  "book": "kde/plasma-activities.html",
  "url": [
    "https://download.kde.org/stable/plasma/6.6.1/plasma-activities-6.6.1.tar.xz"
  ]
}
