{
  "name": "xinit",
  "version": "1.4.4",
  "description": "The xinit package contains a usable script to start the xserver.",
  "url": [
    "https://www.x.org/pub/individual/app/xinit-1.4.4.tar.xz"
  ],
  "dependencies": {
    "required": [
      "x7lib",
      "twm",
      "xclock"
    ]
  },
  "build": {
    "user": [
      "./configure $XORG_CONFIG --with-xinitdir=/etc/X11/app-defaults",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [
    "ldconfig"
  ],
  "meta": false,
  "book": "x/xinit.html",
  "category": "x11",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
