{
  "name": "libdvdread",
  "version": "7.0.1",
  "description": "libdvdread is a library which provides a simple foundation for reading DVDs.",
  "url": "https://get.videolan.org/libdvdread/7.0.1/libdvdread-7.0.1.tar.xz",
  "dependencies": {},
  "build": {
    "user": [
      "sed -i \"/get_option/s/libdvdread/&-7.0.1/\" meson.build",
      "meson setup build --prefix=/usr --buildtype=release .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install",
      "rm -fv $DESTDIR/usr/lib/libdvdread.a"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "multimedia/libdvdread.html",
  "category": "multimedia",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
