{
  "name": "gnome-terminal",
  "version": "3.58.1",
  "description": "The GNOME Terminal package contains the terminal emulator for GNOME Desktop.",
  "url": [
    "https://gitlab.gnome.org/GNOME/gnome-terminal/-/archive/3.58.1/gnome-terminal-3.58.1.tar.gz"
  ],
  "dependencies": {
    "required": [
      "dconf",
      "gnome-shell",
      "gsettings-desktop-schemas",
      "itstool",
      "libhandy1",
      "nautilus",
      "vte"
    ]
  },
  "build": {
    "user": [
      "sed -i -r 's:\"(/system):\"/org/gnome\\1:g' src/external.gschema.xml",
      "meson setup build --prefix=/usr --buildtype=release .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [
    "glib-compile-schemas /usr/share/glib-2.0/schemas"
  ],
  "meta": false,
  "book": "gnome/gnome-terminal.html",
  "category": "desktop-gnome",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
