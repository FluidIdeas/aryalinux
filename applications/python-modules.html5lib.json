{
  "name": "python-modules.html5lib",
  "version": "1.1",
  "description": "html5lib is a pure-Python library for parsing HTML conforming to the WHATWG HTML specification.",
  "url": [
    "https://files.pythonhosted.org/packages/source/h/html5lib/html5lib-1.1.tar.gz"
  ],
  "additionalUrls": [
    "https://www.linuxfromscratch.org/patches/blfs/13.0/html5lib-1.1-python_3.14_buildfix-1.patch"
  ],
  "dependencies": {
    "required": [
      "python-dependencies",
      "python-modules.six"
    ]
  },
  "build": {
    "user": [
      "patch -Np1 -i ../html5lib-1.1-python_3.14_buildfix-1.patch",
      "sed -i 's/from pkg_resources import/from packaging.version import parse as/' setup.py",
      "sed -i 's/import pkg_resources/pkg_resources = None/' setup.py",
      "pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD"
    ],
    "package": [
      "pip3 install --root=$DESTDIR --no-index --find-links dist --no-user html5lib"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "general/python-modules.html",
  "category": "python-module",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
