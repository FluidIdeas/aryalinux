{
  "name": "gnome-calculator",
  "version": "49.2",
  "description": "GNOME Calculator is a powerful graphical calculator with financial, logical and scientific modes. It uses a multiple precision package to do its arithmetic to give a high degree of accuracy.",
  "url": "https://download.gnome.org/sources/gnome-calculator/49/gnome-calculator-49.2.tar.xz",
  "dependencies": {
    "required": [
      "gtksourceview5",
      "itstool",
      "libadwaita",
      "libsoup3",
      "vala"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr --buildtype=release .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "gnome/gnome-calculator.html",
  "category": "desktop-gnome",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
