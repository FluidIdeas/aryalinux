{
  "name": "python-modules.pyserial",
  "version": "3.5",
  "description": "Python module pyserial for scripts and applications that depend on it.",
  "url": "https://files.pythonhosted.org/packages/source/p/pyserial/pyserial-3.5.tar.gz",
  "dependencies": {
    "required": [
      "python-deps.setuptools_scm"
    ]
  },
  "build": {
    "user": [
      "pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD"
    ],
    "package": [
      "pip3 install --root=$DESTDIR --no-index --find-links dist --no-user pyserial"
    ]
  },
  "meta": false,
  "book": "general/python-modules.html",
  "category": "python-module",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
