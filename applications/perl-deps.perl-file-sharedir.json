{
  "name": "perl-deps.perl-file-sharedir",
  "version": "1.118",
  "description": "Perl module perl::file::sharedir providing build-time or runtime support for other Perl packages.",
  "url": "https://cpan.metacpan.org/authors/id/R/RE/REHSACK/File-ShareDir-1.118.tar.gz",
  "dependencies": {
    "required": [
      "perl-deps.perl-class-inspector",
      "perl-deps.perl-file-sharedir-install"
    ]
  },
  "build": {
    "user": [
      "perl Makefile.PL",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "meta": false,
  "book": "general/perl-deps.html",
  "category": "perl-dependency",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
