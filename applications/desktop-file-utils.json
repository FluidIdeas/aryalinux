{
  "name": "desktop-file-utils",
  "version": "0.28",
  "description": "The Desktop File Utils package contains command line utilities for working with Desktop entries. These utilities are used by Desktop Environments and other applications to manipulate the MIME-types application databases and help adhere to the Desktop Entry Specification.",
  "url": [
    "https://www.freedesktop.org/software/desktop-file-utils/releases/desktop-file-utils-0.28.tar.xz"
  ],
  "dependencies": {
    "required": [
      "glib2"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr --buildtype=release .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install",
      "rm -fv $DESTDIR/usr/bin/desktop-file-edit",
      "install -d $DESTDIR/usr/share/applications"
    ]
  },
  "post_install": [
    "update-desktop-database /usr/share/applications"
  ],
  "meta": false,
  "book": "general/desktop-file-utils.html",
  "category": "libraries",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
