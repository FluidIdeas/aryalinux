{
  "name": "xarchiver",
  "version": "0.5.4.26",
  "description": "XArchiver is a GTK+ archive manager with support for tar, xz, bzip2, gzip, zip, 7z, rar, lzo and many other archive formats.",
  "url": [
    "https://github.com/ib/xarchiver/archive/0.5.4.26/xarchiver-0.5.4.26.tar.gz"
  ],
  "dependencies": {
    "required": [
      "gtk3"
    ]
  },
  "build": {
    "user": [
      "sed '/TOGGLE.*prefer_unzip/s/TRUE/FALSE/' -i src/pref_dialog.c",
      "./configure  --prefix=/usr               \\\n             --libexecdir=/usr/lib/xfce4",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [
    "gtk-update-icon-cache -qtf /usr/share/icons/hicolor",
    "update-desktop-database -q"
  ],
  "meta": false,
  "book": "xsoft/xarchiver.html",
  "category": "applications",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
