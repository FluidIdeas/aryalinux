{
  "name": "kde-cups-filters",
  "version": "2.0.1",
  "description": "CUPS filters for the KDE printing stack (kde-libcupsfilters). Do not install alongside gnome-cups-filters.",
  "category": "printing",
  "url": [
    "https://github.com/OpenPrinting/cups-filters/releases/download/2.0.1/cups-filters-2.0.1.tar.xz"
  ],
  "dependencies": {
    "required": [
      "kde-libcupsfilters",
      "kde-libppd"
    ]
  },
  "build": {
    "user": [
      "sed -i '/proc_func)()/s/()/(FILE*, FILE*, void*)/' filter/foomatic-rip/process.h",
      "patch -Np1 -i ../../cups-filters-2.0.1-security_fix-1.patch",
      "./configure --prefix=/usr    \\\n            --disable-static \\\n            --docdir=/usr/share/doc/cups-filters-2.0.1",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "pst/cups-filters.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "additionalUrls": [
    "https://www.linuxfromscratch.org/patches/blfs/13.0/cups-filters-2.0.1-security_fix-1.patch"
  ]
}
