{
  "name": "perl-deps.perl-dist-checkconflicts",
  "version": "0.11",
  "description": "Perl module perl::dist::checkconflicts providing build-time or runtime support for other Perl packages.",
  "url": "https://cpan.metacpan.org/authors/id/D/DO/DOY/Dist-CheckConflicts-0.11.tar.gz",
  "dependencies": {
    "required": [
      "perl-deps.perl-module-runtime",
      "perl-deps.perl-test-fatal"
    ]
  },
  "build": {
    "user": [
      "perl Makefile.PL",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "meta": false,
  "book": "general/perl-deps.html",
  "category": "perl-dependency",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
