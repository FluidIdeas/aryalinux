{
  "name": "pulseaudio-qt",
  "version": "1.7.0",
  "description": "",
  "category": "",
  "dependencies": {
    "required": [
      "frameworks6",
      "pulseaudio"
    ]
  },
  "build": {
    "user": [
      "cmake -B build -D CMAKE_INSTALL_PREFIX=$KF6_PREFIX \\\n      -D CMAKE_PREFIX_PATH=$QT6DIR        \\\n      -D CMAKE_SKIP_INSTALL_RPATH=ON      \\\n      -D CMAKE_BUILD_TYPE=Release         \\\n      -D BUILD_TESTING=OFF                \\\n      .",
      "make -C build"
    ],
    "package": [
      "make -C build install DESTDIR=$DESTDIR"
    ],
    "environment": {
      "KF6_PREFIX": "/usr"
    }
  },
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "meta": false,
  "book": "kde/pulseaudio-qt.html",
  "url": [
    "https://download.kde.org/stable/pulseaudio-qt/pulseaudio-qt-1.7.0.tar.xz"
  ]
}
