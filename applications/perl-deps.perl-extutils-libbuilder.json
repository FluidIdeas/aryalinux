{
  "name": "perl-deps.perl-extutils-libbuilder",
  "version": "0.09",
  "description": "Perl module perl::extutils::libbuilder providing build-time or runtime support for other Perl packages.",
  "url": "https://cpan.metacpan.org/authors/id/A/AM/AMBS/ExtUtils-LibBuilder-0.09.tar.gz",
  "dependencies": {
    "required": [
      "perl-modules.perl-module-build"
    ]
  },
  "build": {
    "user": [
      "perl Build.PL",
      "./Build"
    ],
    "package": [
      "./Build install --destdir $DESTDIR"
    ]
  },
  "meta": false,
  "book": "general/perl-deps.html",
  "category": "perl-dependency",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
