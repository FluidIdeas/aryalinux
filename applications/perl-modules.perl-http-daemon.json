{
  "name": "perl-modules.perl-http-daemon",
  "version": "6.16",
  "description": "Perl module perl::http::daemon used by applications and other Perl packages on the system.",
  "url": "https://www.cpan.org/authors/id/O/OA/OALDERS/HTTP-Daemon-6.16.tar.gz",
  "dependencies": {
    "required": [
      "perl-deps.perl-http-message"
    ]
  },
  "build": {
    "user": [
      "perl Makefile.PL",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "meta": false,
  "book": "general/perl-modules.html",
  "category": "perl-module",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
