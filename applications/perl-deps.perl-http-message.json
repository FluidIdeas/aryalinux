{
  "name": "perl-deps.perl-http-message",
  "version": "7.01",
  "description": "Perl module perl::http::message providing build-time or runtime support for other Perl packages.",
  "url": [
    "https://cpan.metacpan.org/authors/id/O/OA/OALDERS/HTTP-Message-7.01.tar.gz"
  ],
  "dependencies": {
    "required": [
      "perl-deps.perl-clone",
      "perl-deps.perl-encode-locale",
      "perl-deps.perl-http-date",
      "perl-deps.perl-io-html",
      "perl-deps.perl-lwp-mediatypes",
      "perl-deps.perl-test-needs",
      "perl-deps.perl-try-tiny",
      "perl-modules.perl-uri"
    ]
  },
  "build": {
    "user": [
      "perl Makefile.PL",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "general/perl-deps.html",
  "category": "perl-dependency",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
