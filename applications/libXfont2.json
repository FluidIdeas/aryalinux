{
  "name": "libXfont2",
  "version": "2.0.7",
  "description": "Xorg library libXfont2 (BLFS chapter).",
  "url": [
    "https://xorg.freedesktop.org/archive/individual/lib/libXfont2-2.0.7.tar.xz"
  ],
  "dependencies": {
    "required": [
      "freetype2",
      "libfontenc"
    ]
  },
  "build": {
    "environment": {
      "XORG_PREFIX": "/usr",
      "XORG_CONFIG": "--prefix=/usr --sysconfdir=/etc --localstatedir=/var --disable-static"
    },
    "user": [
      "./configure $XORG_CONFIG --disable-devel-docs --docdir=/usr/share/doc/libXfont2-2.0.7",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "x/libXfont2.html",
  "category": "x11",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
