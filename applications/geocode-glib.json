{
  "name": "geocode-glib",
  "version": "3.26.4",
  "description": "Geocode GLib is a convenience library for the Yahoo! Place Finder APIs. The Place Finder web service allows you to do geocoding (finding longitude and latitude from an address), as well as reverse geocoding (finding an address from coordinates).",
  "url": [
    "https://download.gnome.org/sources/geocode-glib/3.26/geocode-glib-3.26.4.tar.xz"
  ],
  "dependencies": {
    "required": [
      "glib2",
      "json-glib",
      "libsoup3"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr           \\\n            --buildtype=release     \\\n            -D enable-gtk-doc=false \\\n            -D soup2=false          \\\n            .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "gnome/geocode-glib.html",
  "category": "desktop-gnome",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
