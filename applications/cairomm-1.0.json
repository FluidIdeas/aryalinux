{
  "name": "cairomm-1.0",
  "version": "1.14.5",
  "description": "The libcairomm-1.0 package provides a C++ interface to Cairo.",
  "url": [
    "https://www.cairographics.org/releases/cairomm-1.14.5.tar.xz"
  ],
  "dependencies": {
    "required": [
      "boost",
      "cairo",
      "libsigc"
    ]
  },
  "build": {
    "user": [
      "meson setup bld             \\\n      --prefix=/usr        \\\n      --buildtype=release  \\\n      -D build-tests=false  \\\n      -D boost-shared=true \\\n      .",
      "ninja -C bld"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C bld install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "x/cairomm-1.0.html",
  "category": "x11",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
