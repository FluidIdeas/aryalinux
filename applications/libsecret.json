{
  "name": "libsecret",
  "version": "0.21.7",
  "description": "The libsecret package contains a GObject based library for accessing the Secret Service API.",
  "url": "https://download.gnome.org/sources/libsecret/0.21/libsecret-0.21.7.tar.xz",
  "dependencies": {
    "required": [
      "glib2"
    ],
    "recommended": [
      "libgcrypt",
      "vala"
    ],
    "post": [
      "gnome-keyring"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr       \\\n            --buildtype=release \\\n            -D gtk_doc=false    .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "gnome/libsecret.html",
  "category": "desktop-gnome",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
