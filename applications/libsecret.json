{
  "name": "libsecret",
  "version": "0.21.7",
  "description": "The libsecret package contains a GObject based library for accessing the Secret Service API.",
  "url": "https://download.gnome.org/sources/libsecret/0.21/libsecret-0.21.7.tar.xz",
  "dependencies": {
    "required": [
      "glib2"
    ],
    "recommended": [
      "libgcrypt",
      "vala"
    ],
    "post": [
      "gnome-keyring"
    ]
  },
  "build": {
    "user": [
      "mkdir bld",
      "cd    bld",
      "meson setup --prefix=/usr       \\\n            --buildtype=release \\\n            -D gtk_doc=false    \\\n            ..",
      "ninja",
      "sed \"s/api_version_major/'0.21.7'/\"            \\\n    -i ../docs/reference/libsecret/meson.build",
      "meson configure -D gtk_doc=true",
      "ninja"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja install"
    ]
  },
  "meta": false,
  "book": "gnome/libsecret.html",
  "category": "desktop-gnome",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
