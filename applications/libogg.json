{
  "name": "libogg",
  "version": "1.3.6",
  "description": "The libogg package contains the Ogg file structure. This is useful for creating (encoding) or playing (decoding) a single physical bit stream.",
  "url": [
    "https://downloads.xiph.org/releases/ogg/libogg-1.3.6.tar.xz"
  ],
  "dependencies": {},
  "build": {
    "user": [
      "./configure --prefix=/usr    \\\n            --disable-static",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "multimedia/libogg.html",
  "category": "multimedia",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
