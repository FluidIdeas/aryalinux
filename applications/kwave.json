{
  "name": "kwave",
  "version": "25.12.2",
  "description": "The KWave package contains a KDE Frameworks-based Sound Editor application.",
  "url": [
    "https://download.kde.org/stable/release-service/25.12.2/src/kwave-25.12.2.tar.xz"
  ],
  "dependencies": {
    "required": [
      "alsa-lib",
      "audiofile",
      "fftw",
      "flac",
      "frameworks6",
      "id3lib",
      "libogg",
      "pulseaudio"
    ]
  },
  "build": {
    "environment": {
      "KF6_PREFIX": "/usr"
    },
    "user": [
      "cmake -B build -D CMAKE_INSTALL_PREFIX=$KF6_PREFIX \\\n      -D CMAKE_BUILD_TYPE=Release         \\\n      -D BUILD_TESTING=OFF                \\\n      -W no-dev .",
      "make -C build"
    ],
    "package": [
      "make -C build install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "multimedia/kwave.html",
  "category": "multimedia",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
