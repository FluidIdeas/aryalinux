{
  "name": "kwave",
  "version": "25.12.2",
  "description": "The KWave package contains a KDE Frameworks-based Sound Editor application.",
  "url": "https://download.kde.org/stable/release-service/25.12.2/src/kwave-25.12.2.tar.xz",
  "dependencies": {
    "required": [
      "audiofile",
      "id3lib",
      "alsa-lib",
      "libogg",
      "pulseaudio"
    ]
  },
  "build": {
    "user": [
      "mkdir build",
      "cd    build",
      "cmake -D CMAKE_INSTALL_PREFIX=$KF6_PREFIX \\\n      -D CMAKE_BUILD_TYPE=Release         \\\n      -D BUILD_TESTING=OFF                \\\n      -W no-dev ..",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "meta": false,
  "book": "multimedia/kwave.html",
  "category": "multimedia",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
