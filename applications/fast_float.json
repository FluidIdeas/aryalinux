{
  "name": "fast_float",
  "version": "8.2.3",
  "description": "Fast_float provides a set of C++ header files for efficient string to float operations.",
  "url": "https://github.com/fastfloat/fast_float/archive/v8.2.3/fast_float-8.2.3.tar.gz",
  "dependencies": {
    "required": [
      "cmake"
    ]
  },
  "build": {
    "user": [
      "mkdir build",
      "cd    build",
      "cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n      -D CMAKE_BUILD_TYPE=Release  \\\n      -G Ninja ..",
      "ninja"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja install"
    ]
  },
  "meta": false,
  "book": "general/fast_float.html",
  "category": "libraries",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
