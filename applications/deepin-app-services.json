{
  "name": "deepin-app-services",
  "version": "1.0.44",
  "description": "Service collection of DDE applications, including dconfig-center (Deepin Desktop Environment).",
  "category": "desktop-deepin",
  "dependencies": {
    "required": []
  },
  "build": {
    "user": [
      "cmake . -GNinja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_INSTALL_LIBEXECDIR=lib -DCMAKE_INSTALL_SYSCONFDIR=/etc ",
      "ninja"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "deepin/deepin-app-services.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "url": [
    "https://github.com/linuxdeepin/dde-app-services/archive/refs/tags/1.0.44.tar.gz"
  ]
}
