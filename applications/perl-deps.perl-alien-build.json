{
  "name": "perl-deps.perl-alien-build",
  "version": "2.84",
  "description": "Perl module perl::alien::build providing build-time or runtime support for other Perl packages.",
  "url": [
    "https://cpan.metacpan.org/authors/id/P/PL/PLICEASE/Alien-Build-2.84.tar.gz"
  ],
  "dependencies": {
    "required": [
      "perl-deps.perl-capture-tiny",
      "perl-deps.perl-ffi-checklib",
      "perl-deps.perl-file-chdir",
      "perl-modules.perl-file-which"
    ]
  },
  "build": {
    "user": [
      "perl Makefile.PL",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "general/perl-deps.html",
  "category": "perl-dependency",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
