{
  "name": "perl-deps.perl-test2-plugin-nowarnings",
  "version": "0.10",
  "description": "Perl module perl::test2::plugin::nowarnings providing build-time or runtime support for other Perl packages.",
  "url": "https://cpan.metacpan.org/authors/id/D/DR/DROLSKY/Test2-Plugin-NoWarnings-0.10.tar.gz",
  "dependencies": {
    "required": [
      "perl-deps.perl-test-simple",
      "perl-modules.perl-ipc-run3"
    ]
  },
  "build": {
    "user": [
      "perl Makefile.PL",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "general/perl-deps.html",
  "category": "perl-dependency",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
