{
  "name": "deepin-desktop-base",
  "version": "2:2026.05.25",
  "description": "Base component for Deepin Desktop Environment.",
  "category": "desktop-deepin",
  "build": {
    "user": [
      "make"
    ],
    "package": [
      "make DESTDIR=$DESTDIR install",
      "install -Dm644 $SOURCE_ROOT/distribution.info $DESTDIR/usr/share/deepin/distribution.info",
      "rm -f $DESTDIR/etc/lsb-release",
      "rm -rf $DESTDIR/etc/systemd",
      "ln -sf ../usr/lib/deepin/desktop-version $DESTDIR/etc/deepin-version",
      "install -Dm644 files/os-version $DESTDIR/etc/uos-version",
      "rm -rf $DESTDIR/usr/share/python-apt $DESTDIR/usr/share/distro-info"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "deepin/deepin-desktop-base.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "url": [
    "https://github.com/linuxdeepin/deepin-desktop-base/archive/refs/tags/2026.05.25.tar.gz"
  ]
}
