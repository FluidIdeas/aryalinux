{
  "name": "harfbuzz",
  "version": "12.3.2",
  "description": "The HarfBuzz package contains an OpenType text shaping engine.",
  "url": "https://github.com/harfbuzz/harfbuzz/releases/download/12.3.2/harfbuzz-12.3.2.tar.xz",
  "dependencies": {
    "required": [
      "freetype2",
      "icu"
    ],
    "recommended": [
      "glib2"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr --buildtype=release -D graphite2=enabled .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "general/harfbuzz.html",
  "category": "graphics",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
