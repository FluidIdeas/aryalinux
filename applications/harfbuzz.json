{
  "name": "harfbuzz",
  "version": "12.3.2",
  "description": "The HarfBuzz package contains an OpenType text shaping engine.",
  "url": "https://github.com/harfbuzz/harfbuzz/releases/download/12.3.2/harfbuzz-12.3.2.tar.xz",
  "dependencies": {
    "required": [
      "freetype2",
      "icu"
    ],
    "recommended": [
      "glib2"
    ]
  },
  "build": {
    "user": [
      "mkdir build",
      "cd    build",
      "meson setup ..             \\\n      --prefix=/usr        \\\n      --buildtype=release  \\\n      -D graphite2=enabled",
      "ninja"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja install"
    ]
  },
  "meta": false,
  "book": "general/harfbuzz.html",
  "category": "graphics",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
