{
  "name": "umockdev",
  "version": "0.19.4",
  "description": "The Umockdev package contains a framework that allows a developer to mock devices for use in unit testing.",
  "url": [
    "https://github.com/martinpitt/umockdev/releases/download/0.19.4/umockdev-0.19.4.tar.xz"
  ],
  "dependencies": {
    "required": [
      "libgudev",
      "libpcap",
      "vala"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr --buildtype=release .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "general/umockdev.html",
  "category": "libraries",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
