{
  "name": "procmail",
  "version": "3.24",
  "description": "The Procmail package contains an autonomous mail processor. This is useful for filtering and sorting incoming mail.",
  "url": [
    "https://github.com/BuGlessRB/procmail/archive/v3.24/procmail-3.24.tar.gz"
  ],
  "dependencies": {
    "required": [
      "mail"
    ]
  },
  "build": {
    "user": [
      "patch -Np1 -i ../procmail-3.24-consolidated_fixes-1.patch",
      "make CC=\"gcc -std=gnu17\" LOCKINGTEST=/tmp"
    ],
    "package": [
      "make CC=\"gcc -std=gnu17\" LOCKINGTEST=/tmp MANDIR=$DESTDIR/usr/share/man install DESTDIR=$DESTDIR",
      "make install-suid DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "basicnet/procmail.html",
  "category": "networking",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "additionalUrls": [
    "https://www.linuxfromscratch.org/patches/blfs/13.0/procmail-3.24-consolidated_fixes-1.patch"
  ]
}
