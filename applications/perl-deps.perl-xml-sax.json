{
  "name": "perl-deps.perl-xml-sax",
  "version": "1.02",
  "description": "Perl module perl::xml::sax providing build-time or runtime support for other Perl packages.",
  "url": "https://cpan.metacpan.org/authors/id/G/GR/GRANTM/XML-SAX-1.02.tar.gz",
  "dependencies": {
    "required": [
      "libxml2",
      "perl-deps.perl-xml-sax-base"
    ]
  },
  "build": {
    "user": [
      "perl Makefile.PL",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "meta": false,
  "book": "general/perl-deps.html",
  "category": "perl-dependency",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
