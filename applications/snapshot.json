{
  "name": "snapshot",
  "version": "49.1",
  "description": "",
  "category": "",
  "dependencies": {
    "required": [
      "libadwaita",
      "rust",
      "pipewire",
      "xdg-user-dirs"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr --buildtype=release .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "meta": false,
  "book": "gnome/snapshot.html",
  "url": [
    "https://download.gnome.org/sources/snapshot/49/snapshot-49.1.tar.xz"
  ]
}
