{
  "name": "deepin-appearance",
  "version": "1.1.81",
  "description": "Application resource management and control services for the dde desktop environment (Deepin Desktop Environment).",
  "category": "desktop-deepin",
  "dependencies": {
    "required": [
      "deepin-daemon",
      "deepin-service-manager",
      "dtk6core",
      "dtk6gui",
      "fontconfig",
      "glib2",
      "gsettings-qt6",
      "gtk3",
      "kconfig",
      "kglobalaccel",
      "kwindowsystem",
      "qt6",
      "xcb-util-cursor"
    ]
  },
  "build": {
    "user": [
      "cmake . -GNinja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_INSTALL_LIBEXECDIR=lib -DCMAKE_INSTALL_SYSCONFDIR=/etc ",
      "ninja"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "deepin/deepin-appearance.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "url": [
    "https://github.com/linuxdeepin/dde-appearance/archive/refs/tags/1.1.81.tar.gz"
  ]
}
