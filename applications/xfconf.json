{
  "name": "xfconf",
  "version": "4.20.0",
  "description": "Xfconf is the configuration storage system for Xfce.",
  "url": "https://archive.xfce.org/src/xfce/xfconf/4.20/xfconf-4.20.0.tar.bz2",
  "dependencies": {
    "required": [
      "libxfce4util"
    ]
  },
  "build": {
    "user": [
      "./configure --prefix=/usr",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "meta": false,
  "book": "xfce/xfconf.html",
  "category": "desktop-xfce",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
