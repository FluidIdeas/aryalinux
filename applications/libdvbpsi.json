{
  "name": "libdvbpsi",
  "version": "1.3.3",
  "description": "libdvbpsi decodes and generates MPEG TS and DVB PSI tables.",
  "category": "multimedia",
  "dependencies": {},
  "build": {
    "user": [
      "./configure --prefix=/usr \\\n            --disable-static",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "meta": false,
  "book": "multimedia/vlc.html",
  "url": [
    "https://download.videolan.org/pub/videolan/libdvbpsi/1.3.3/libdvbpsi-1.3.3.tar.bz2"
  ],
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
