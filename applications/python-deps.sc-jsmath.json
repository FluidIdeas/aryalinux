{
  "name": "python-deps.sc-jsmath",
  "version": "1.0.1",
  "description": "Python package sc-jsmath required as a dependency of other Python modules.",
  "url": [
    "https://files.pythonhosted.org/packages/source/s/sphinxcontrib-jsmath/sphinxcontrib-jsmath-1.0.1.tar.gz"
  ],
  "dependencies": {},
  "build": {
    "user": [
      "patch -Np1 -i ../sphinxcontrib-jsmath-1.0.1-sphinx9_fixes-1.patch",
      "pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD"
    ],
    "package": [
      "pip3 install --root=$DESTDIR --no-index --find-links dist --no-user sphinxcontrib-jsmath"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "general/python-dependencies.html",
  "category": "python-dependency",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "additionalUrls": [
    "https://www.linuxfromscratch.org/patches/blfs/13.0/sphinxcontrib-jsmath-1.0.1-sphinx9_fixes-1.patch"
  ]
}
