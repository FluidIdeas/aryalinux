{
  "name": "dtkcore",
  "version": "1:6.7.43",
  "description": "DTK core modules (Qt5 build) for Deepin Desktop Environment.",
  "category": "desktop-deepin",
  "dependencies": {
    "required": [
      "dbus",
      "deepin-desktop-base",
      "dtkcommon",
      "dtklog",
      "gsettings-qt5",
      "icu",
      "lshw",
      "qt5-base",
      "uchardet"
    ]
  },
  "build": {
    "user": [
      "sed -i 's|/etc/os-version|/etc/uos-version|' src/dsysinfo.cpp",
      "cmake . -Bbuild-qt5 -GNinja -DDTK5=ON -DBUILD_WITH_SYSTEMD=ON -DBUILD_TESTING=OFF -DMKSPECS_INSTALL_DIR=lib/qt/mkspecs/modules -DFEATURES_INSTALL_DIR=lib/qt/mkspecs/features -DQCH_INSTALL_DESTINATION=share/doc/qt -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_INSTALL_LIBEXECDIR=lib -DCMAKE_INSTALL_PREFIX=/usr",
      "cmake --build build-qt5"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build-qt5 install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "deepin/dtkcore.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "url": [
    "https://github.com/linuxdeepin/dtkcore/archive/refs/tags/6.7.43.tar.gz"
  ]
}
