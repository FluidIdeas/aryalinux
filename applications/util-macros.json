{
  "name": "util-macros",
  "version": "1.20.2",
  "description": "The util-macros package contains the m4 macros used by all of the Xorg packages.",
  "url": "https://www.x.org/pub/individual/util/util-macros-1.20.2.tar.xz",
  "dependencies": {
    "required": [
      "xorg7"
    ]
  },
  "build": {
    "user": [
      "./configure $XORG_CONFIG"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "x/util-macros.html",
  "category": "x11",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
