{
  "name": "libpeas",
  "version": "1.36.0",
  "description": "libpeas is a GObject based plugins engine, and is targeted at giving every application the chance to assume its own extensibility.",
  "url": "https://download.gnome.org/sources/libpeas/1.36/libpeas-1.36.0.tar.xz",
  "dependencies": {
    "required": [
      "glib2",
      "gtk3",
      "libxml2"
    ]
  },
  "build": {
    "user": [
      "mkdir build",
      "cd    build",
      "meson setup --prefix=/usr          \\\n            --buildtype=release    \\\n            --wrap-mode=nofallback \\\n            -D python3=false       \\\n            ..",
      "ninja",
      "sed \"/docs_dir =/s@\\$@/ 'libpeas-1.36.0'@\" \\\n    -i ../docs/reference/meson.build",
      "meson configure -D gtk_doc=true",
      "ninja"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja install"
    ]
  },
  "meta": false,
  "book": "gnome/libpeas.html",
  "category": "desktop-gnome",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
