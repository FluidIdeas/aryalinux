{
  "name": "lightdm",
  "version": "1.32.0",
  "description": "The lightdm package contains a lightweight display manager based upon GTK.",
  "url": [
    "https://github.com/CanonicalLtd/lightdm/releases/download/1.32.0/lightdm-1.32.0.tar.xz"
  ],
  "dependencies": {
    "required": [
      "exo",
      "glib2",
      "itstool",
      "libgcrypt",
      "libxklavier",
      "linux-pam",
      "vala"
    ]
  },
  "build": {
    "user": [
      "./configure --prefix=/usr                 \\\n            --libexecdir=/usr/lib/lightdm \\\n            --localstatedir=/var          \\\n            --sbindir=/usr/bin            \\\n            --sysconfdir=/etc             \\\n            --disable-static              \\\n            --disable-tests               \\\n            --with-greeter-user=lightdm   \\\n            --with-greeter-session=lightdm-gtk-greeter \\\n            --docdir=/usr/share/doc/lightdm-1.32.0",
      "make",
      "tar -xf ../lightdm-gtk-greeter-2.0.9.tar.gz",
      "(cd lightdm-gtk-greeter-2.0.9 && ./configure --prefix=/usr                 \\\n            --libexecdir=/usr/lib/lightdm \\\n            --sbindir=/usr/bin            \\\n            --sysconfdir=/etc             \\\n            --with-libxklavier            \\\n            --enable-kill-on-sigterm      \\\n            --disable-libido              \\\n            --disable-libindicator        \\\n            --disable-static              \\\n            --disable-maintainer-mode     \\\n            --docdir=/usr/share/doc/lightdm-gtk-greeter-2.0.9 && make)"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR",
      "install -v -m755 tests/src/lightdm-session $DESTDIR/usr/bin/lightdm-session",
      "sed -i '1 s/sh/bash --login/' $DESTDIR/usr/bin/lightdm-session",
      "rm -rf $DESTDIR/etc/init",
      "install -v -dm755 $DESTDIR/var/lib/lightdm      \\\n        $DESTDIR/var/lib/lightdm-data \\\n        $DESTDIR/var/cache/lightdm    \\\n        $DESTDIR/var/log/lightdm",
      "(cd lightdm-gtk-greeter-2.0.9 && make install DESTDIR=$DESTDIR)",
      "make install-lightdm DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [
    "groupadd -g 65 lightdm",
    "useradd  -c \"Lightdm Daemon\" \\\n         -d /var/lib/lightdm \\\n         -u 65 -g lightdm    \\\n         -s /bin/false lightdm",
    "chown -R lightdm:lightdm /var/lib/lightdm /var/lib/lightdm-data /var/cache/lightdm /var/log/lightdm",
    "ln -sf /opt/xorg/bin/Xorg /usr/bin/X",
    "systemctl enable lightdm"
  ],
  "meta": false,
  "book": "x/lightdm.html",
  "category": "x11",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "additionalUrls": [
    "https://github.com/Xubuntu/lightdm-gtk-greeter/releases/download/lightdm-gtk-greeter-2.0.9/lightdm-gtk-greeter-2.0.9.tar.gz"
  ]
}
