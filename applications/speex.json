{
  "name": "speex",
  "version": "1.2.1",
  "description": "Speex is an audio compression format designed specifically for speech. It is well-adapted to internet applications and provides useful features that are not present in most other CODECs.",
  "url": "https://downloads.xiph.org/releases/speex/speex-1.2.1.tar.gz",
  "dependencies": {
    "required": [
      "libogg"
    ]
  },
  "build": {
    "user": [
      "./configure --prefix=/usr    \\\n            --disable-static \\\n            --docdir=/usr/share/doc/speex-1.2.1",
      "make",
      "cd ..",
      "tar -xf speexdsp-1.2.1.tar.gz",
      "cd speexdsp-1.2.1",
      "./configure --prefix=/usr    \\\n            --disable-static \\\n            --docdir=/usr/share/doc/speexdsp-1.2.1",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR",
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "meta": false,
  "book": "multimedia/speex.html",
  "category": "multimedia",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
