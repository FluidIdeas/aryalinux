{
  "name": "swaybg",
  "version": "1.2.2",
  "description": "Wallpaper tool for Wayland compositors (Budgie backgrounds).",
  "category": "applications",
  "url": [
    "https://github.com/swaywm/swaybg/releases/download/v1.2.2/swaybg-1.2.2.tar.gz"
  ],
  "dependencies": {
    "required": [
      "cairo",
      "gdk-pixbuf",
      "wayland"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr -Dbuildtype=release .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "budgie/swaybg.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
