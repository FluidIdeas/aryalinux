{
  "name": "perl-modules.perl-archive-zip",
  "version": "1.68",
  "description": "Perl module perl::archive::zip used by applications and other Perl packages on the system.",
  "url": "https://www.cpan.org/authors/id/P/PH/PHRED/Archive-Zip-1.68.tar.gz",
  "dependencies": {
    "required": [
      "unzip"
    ]
  },
  "build": {
    "user": [
      "perl Makefile.PL",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "general/perl-modules.html",
  "category": "perl-module",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
