{
  "name": "id3lib",
  "version": "3.8.3",
  "description": "id3lib is a library for reading, writing and manipulating id3v1 and id3v2 multimedia data containers.",
  "url": [
    "https://downloads.sourceforge.net/id3lib/id3lib-3.8.3.tar.gz",
    "https://versaweb.dl.sourceforge.net/project/id3lib/id3lib/3.8.3/id3lib-3.8.3.tar.gz"
  ],
  "dependencies": {},
  "build": {
    "user": [
      "patch -Np1 -i ../id3lib-3.8.3-consolidated_patches-1.patch",
      "libtoolize -fc",
      "aclocal",
      "autoconf",
      "automake --add-missing --copy",
      "./configure --prefix=/usr --disable-static",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR",
      "install -v -m755 -d $DESTDIR/usr/share/man/man1",
      "cp doc/man/* $DESTDIR/usr/share/man/man1"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "multimedia/id3lib.html",
  "category": "multimedia",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "additionalUrls": [
    "https://www.linuxfromscratch.org/patches/blfs/13.0/id3lib-3.8.3-consolidated_patches-1.patch"
  ]
}
