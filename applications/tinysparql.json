{
  "name": "tinysparql",
  "version": "3.10.1",
  "description": "",
  "category": "",
  "dependencies": {
    "required": [
      "json-glib",
      "glib2",
      "icu",
      "python-modules.pygobject3"
    ]
  },
  "build": {
    "user": [
      "rm -fv /usr/lib/systemd/user/tracker-xdg-portal-3.service",
      "sed -e \"s/'generate'/&, '--no-namespace-dir'/\"         \\\n    -e \"/--output-dir/s/@OUTPUT@/&\\/tinysparql-3.10.1/\" \\\n    -i docs/reference/meson.build",
      "mkdir build",
      "cd    build",
      "meson setup --prefix=/usr       \\\n            --buildtype=release \\\n            -D man=false        \\\n            ..",
      "ninja"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja install"
    ]
  },
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "meta": false,
  "book": "gnome/tinysparql.html",
  "url": [
    "https://download.gnome.org/sources/tinysparql/3.10/tinysparql-3.10.1.tar.xz"
  ]
}
