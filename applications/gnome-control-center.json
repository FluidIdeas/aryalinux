{
  "name": "gnome-control-center",
  "version": "49.4",
  "description": "The GNOME Control Center package contains the GNOME settings manager.",
  "url": "https://download.gnome.org/sources/gnome-control-center/49/gnome-control-center-49.4.tar.xz",
  "dependencies": {
    "required": [
      "accountsservice",
      "python-modules.blueprint-compiler",
      "colord-gtk",
      "gnome-bluetooth",
      "gnome-online-accounts",
      "gnome-settings-daemon",
      "gsound",
      "libnma",
      "samba",
      "tecla",
      "udisks2",
      "ibus"
    ]
  },
  "build": {
    "user": [
      "mkdir build",
      "cd    build",
      "meson setup --prefix=/usr --buildtype=release ..",
      "ninja"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja install"
    ]
  },
  "meta": false,
  "book": "gnome/gnome-control-center.html",
  "category": "desktop-gnome",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
