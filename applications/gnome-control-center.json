{
  "name": "gnome-control-center",
  "version": "49.4",
  "description": "The GNOME Control Center package contains the GNOME settings manager.",
  "url": [
    "https://download.gnome.org/sources/gnome-control-center/49/gnome-control-center-49.4.tar.xz"
  ],
  "dependencies": {
    "required": [
      "ModemManager",
      "accountsservice",
      "colord-gtk",
      "gnome-cups",
      "gnome-cups-filters",
      "gnome-bluetooth",
      "gnome-online-accounts",
      "gnome-settings-daemon",
      "gsound",
      "ibus",
      "libadwaita",
      "libgtop",
      "libnma",
      "libpwquality",
      "mitkrb",
      "python-modules.blueprint-compiler",
      "samba",
      "shared-mime-info",
      "tecla",
      "udisks2"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr --buildtype=release .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "gnome/gnome-control-center.html",
  "category": "desktop-gnome",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
