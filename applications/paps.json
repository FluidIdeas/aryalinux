{
  "name": "paps",
  "version": "0.8.0",
  "description": "paps is a text to PostScript converter that works through Pango. Its input is a UTF-8 encoded text file and it outputs vectorized PostScript. It may be used for printing any complex script supported by Pango.",
  "url": [
    "https://github.com/dov/paps/releases/download/v0.8.0/paps-0.8.0.tar.gz"
  ],
  "dependencies": {
    "required": [
      "fmt"
    ]
  },
  "build": {
    "user": [
      "sed -i -r 's/g_utf8_(next|offset)/(char*) &/' src/paps.cc",
      "patch -Np1 -i ../paps-0.8.0-fmt_fix-1.patch",
      "./configure --prefix=/usr    \\\n            --disable-Werror \\\n            --mandir=/usr/share/man",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "pst/paps.html",
  "category": "printing",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "additionalUrls": [
    "https://www.linuxfromscratch.org/patches/blfs/13.0/paps-0.8.0-fmt_fix-1.patch"
  ]
}
