{
  "name": "perl-modules.perl-uri",
  "version": "5.34",
  "description": "Perl module perl::uri used by applications and other Perl packages on the system.",
  "url": "https://www.cpan.org/authors/id/O/OA/OALDERS/URI-5.34.tar.gz",
  "dependencies": {
    "required": [
      "perl-deps.perl-mime-base32",
      "perl-deps.perl-test-fatal",
      "perl-deps.perl-test-warnings"
    ]
  },
  "build": {
    "user": [
      "perl Makefile.PL",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "meta": false,
  "book": "general/perl-modules.html",
  "category": "perl-module",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
