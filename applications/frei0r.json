{
  "name": "frei0r",
  "version": "2.5.1",
  "description": "Frei0r is a minimalistic plugin API for video effects. Note that the 0 in the name is a zero, not a capital letter o.",
  "url": [
    "https://github.com/dyne/frei0r/archive/v2.5.1/frei0r-v2.5.1.tar.gz"
  ],
  "dependencies": {},
  "build": {
    "user": [
      "cmake -B build -D CMAKE_INSTALL_PREFIX=/usr \\\n      -D CMAKE_BUILD_TYPE=Release  \\\n      -W no-dev .",
      "cmake --build build"
    ],
    "package": [
      "cmake --install build --prefix=/usr --DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "multimedia/frei0r.html",
  "category": "multimedia",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
