{
  "name": "lxqt-admin",
  "version": "2.3.0",
  "description": "",
  "category": "",
  "dependencies": {
    "required": [
      "liblxqt"
    ]
  },
  "build": {
    "user": [
      "cmake -B build -D CMAKE_INSTALL_PREFIX=/usr \\\n      -D CMAKE_BUILD_TYPE=Release  \\\n      .",
      "make -C build"
    ],
    "package": [
      "make -C build install DESTDIR=$DESTDIR"
    ]
  },
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "meta": false,
  "book": "lxqt/lxqt-admin.html",
  "url": [
    "https://github.com/lxqt/lxqt-admin/releases/download/2.3.0/lxqt-admin-2.3.0.tar.xz"
  ]
}
