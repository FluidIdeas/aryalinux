{
  "name": "gtk-session-lock",
  "version": "0.2.0",
  "description": "Wayland session lock protocol library for GTK.",
  "category": "libraries",
  "url": [
    "https://github.com/Cu3PO42/gtk-session-lock/archive/refs/tags/v0.2.0.tar.gz"
  ],
  "dependencies": {
    "required": [
      "gtk3",
      "wayland",
      "wayland-protocols"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr -Dbuildtype=release gtk-session-lock-0.2.0",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "budgie/gtk-session-lock.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
