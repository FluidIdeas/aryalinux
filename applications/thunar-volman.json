{
  "name": "thunar-volman",
  "version": "4.20.0",
  "description": "Thunar Volume Manager is an extension for the Thunar file manager, which enables automatic management of removable drives and media.",
  "url": [
    "https://archive.xfce.org/src/xfce/thunar-volman/4.20/thunar-volman-4.20.0.tar.bz2"
  ],
  "dependencies": {
    "required": [
      "exo",
      "gvfs",
      "libgudev",
      "libnotify"
    ]
  },
  "build": {
    "user": [
      "./configure --prefix=/usr",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [
    "gtk-update-icon-cache -qtf /usr/share/icons/hicolor",
    "update-desktop-database -q"
  ],
  "meta": false,
  "book": "xfce/thunar-volman.html",
  "category": "desktop-xfce",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
