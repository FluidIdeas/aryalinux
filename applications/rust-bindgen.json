{
  "name": "rust-bindgen",
  "version": "0.72.0",
  "description": "rust-bindgen automatically generates Rust FFI bindings from C header files.",
  "url": [
    "https://github.com/rust-lang/rust-bindgen/archive/v0.72.0/rust-bindgen-0.72.0.tar.gz"
  ],
  "dependencies": {
    "required": [
      "llvm",
      "rust"
    ]
  },
  "build": {
    "user": [
      "cargo build --release"
    ],
    "package": [
      "install -Dm755 target/release/bindgen $DESTDIR/usr/bin/bindgen",
      "target/release/bindgen --generate-shell-completions bash > bindgen.bash",
      "install -Dm644 bindgen.bash $DESTDIR/usr/share/bash-completion/completions/bindgen",
      "target/release/bindgen --generate-shell-completions zsh > bindgen.zsh",
      "install -Dm644 bindgen.zsh $DESTDIR/usr/share/zsh/site-functions/_bindgen"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "general/rust-bindgen.html",
  "category": "programming",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
