{
  "name": "gnome-maps",
  "version": "49.4",
  "description": "GNOME Maps is a map application for GNOME.",
  "url": "https://download.gnome.org/sources/gnome-maps/49/gnome-maps-49.4.tar.xz",
  "dependencies": {
    "required": [
      "desktop-file-utils",
      "geoclue2",
      "gjs",
      "libadwaita",
      "libportal",
      "libshumate"
    ]
  },
  "build": {
    "user": [
      "mkdir build",
      "cd    build",
      "meson setup --prefix=/usr --buildtype=release ..",
      "ninja"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja install"
    ]
  },
  "meta": false,
  "book": "gnome/gnome-maps.html",
  "category": "desktop-gnome",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
