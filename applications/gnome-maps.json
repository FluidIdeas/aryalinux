{
  "name": "gnome-maps",
  "version": "49.4",
  "description": "GNOME Maps is a map application for GNOME.",
  "url": "https://download.gnome.org/sources/gnome-maps/49/gnome-maps-49.4.tar.xz",
  "dependencies": {
    "required": [
      "desktop-file-utils",
      "geoclue2",
      "gjs",
      "libadwaita",
      "libportal",
      "libshumate"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr --buildtype=release .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "gnome/gnome-maps.html",
  "category": "desktop-gnome",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
