{
  "name": "ModemManager",
  "version": "1.24.2",
  "description": "",
  "category": "",
  "dependencies": {
    "required": [
      "glib2",
      "libgudev",
      "libmbim",
      "libqmi",
      "polkit",
      "vala"
    ]
  },
  "build": {
    "user": [
      "meson setup build                 \\\n      --prefix=/usr            \\\n      --buildtype=release      \\\n      -D bash_completion=false \\\n      -D qrtr=false .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [
    "systemctl enable ModemManager"
  ],
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "meta": false,
  "book": "general/ModemManager.html",
  "url": [
    "https://gitlab.freedesktop.org/mobile-broadband/ModemManager/-/archive/1.24.2/ModemManager-1.24.2.tar.gz"
  ]
}
