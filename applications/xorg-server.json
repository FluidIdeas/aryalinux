{
  "name": "xorg-server",
  "version": "21.1.21",
  "description": "The Xorg Server is the core of the X Window system.",
  "url": [
    "https://www.x.org/pub/individual/xserver/xorg-server-21.1.21.tar.xz"
  ],
  "dependencies": {
    "required": [
      "libepoxy",
      "libtirpc",
      "libxcvt",
      "pixman",
      "xkeyboard-config"
    ]
  },
  "build": {
    "user": [
      "patch -Np1 -i ../xorg-server-21.1.21-tearfree_backport-1.patch",
      "meson setup build              \\\n      --prefix=$XORG_PREFIX \\\n      --localstatedir=/var  \\\n      -D glamor=true        \\\n      -D xkb_output_dir=/var/lib/xkb .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install",
      "install -v -dm755 $DESTDIR/etc/X11/xorg.conf.d"
    ]
  },
  "post_install": [
    "command -v systemd-tmpfiles >/dev/null && systemd-tmpfiles --create /usr/lib/tmpfiles.d/x11.conf || install -d -m 1777 /tmp/.X11-unix /tmp/.ICE-unix /tmp/.XIM-unix /tmp/.font-unix",
    "cat > /usr/lib/systemd/system/early-x11-sockets.service << \"EOF\"\n[Unit]\nDescription=Ensure X11 socket directories exist\nDefaultDependencies=no\nBefore=display-manager.service\nAfter=local-fs.target\n\n[Service]\nType=oneshot\nExecStart=/bin/mkdir -p /tmp/.X11-unix /tmp/.ICE-unix /tmp/.XIM-unix /tmp/.font-unix\nExecStart=/bin/chmod 1777 /tmp/.X11-unix /tmp/.ICE-unix /tmp/.XIM-unix /tmp/.font-unix\nRemainAfterExit=yes\n\n[Install]\nWantedBy=graphical.target\nEOF",
    "systemctl daemon-reload",
    "systemctl enable early-x11-sockets.service 2>/dev/null || true",
    "systemd-tmpfiles --create /usr/lib/tmpfiles.d/x11.conf 2>/dev/null || true"
  ],
  "meta": false,
  "book": "x/xorg-server.html",
  "category": "x11",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "additionalUrls": [
    "https://www.linuxfromscratch.org/patches/blfs/13.0/xorg-server-21.1.21-tearfree_backport-1.patch"
  ]
}
