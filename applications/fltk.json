{
  "name": "fltk",
  "version": "1.4.4",
  "description": "FLTK (pronounced \"fulltick\") is a cross-platform C++ GUI toolkit. FLTK provides modern GUI functionality and supports 3D graphics via OpenGL and its built-in GLUT emulation libraries used for creating graphical user interfaces for applications.",
  "url": [
    "https://github.com/fltk/fltk/releases/download/release-1.4.4/fltk-1.4.4-source.tar.gz"
  ],
  "dependencies": {
    "required": [
      "hicolor-icon-theme",
      "libjpeg",
      "libpng",
      "x7lib"
    ]
  },
  "build": {
    "user": [
      "./configure --prefix=/usr --enable-shared",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR",
      "rm -vf $DESTDIR/usr/lib/libfltk*.a"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "x/fltk.html",
  "category": "x11",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
