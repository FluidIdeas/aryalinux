{
  "name": "inih",
  "version": "0",
  "description": "This package is a simple .INI file parser written in C.",
  "url": [
    "https://github.com/benhoyt/inih/archive/r62/inih-r62.tar.gz"
  ],
  "dependencies": {},
  "build": {
    "user": [
      "meson setup build --prefix=/usr --buildtype=release .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "general/inih.html",
  "category": "libraries",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
