{
  "name": "biber",
  "version": "2.21",
  "description": "Biber is a BibTeX replacement for users of biblatex, written in Perl, with full Unicode support.",
  "url": [
    "https://github.com/plk/biber/archive/v2.21/biber-2.21.tar.gz"
  ],
  "dependencies": {
    "required": [
      "perl-modules.perl-autovivification",
      "perl-modules.perl-business-isbn",
      "perl-modules.perl-business-ismn",
      "perl-modules.perl-business-issn",
      "perl-modules.perl-class-accessor",
      "perl-modules.perl-data-compare",
      "perl-modules.perl-data-dump",
      "perl-modules.perl-data-uniqid",
      "perl-modules.perl-datetime-calendar-julian",
      "perl-modules.perl-datetime-format-builder",
      "perl-modules.perl-encode-eucjpascii",
      "perl-modules.perl-encode-hanextra",
      "perl-modules.perl-encode-jis2k",
      "perl-modules.perl-file-slurper",
      "perl-modules.perl-file-which",
      "perl-modules.perl-io-string",
      "perl-modules.perl-ipc-run3",
      "perl-modules.perl-lingua-translit",
      "perl-modules.perl-list-allutils",
      "perl-modules.perl-list-moreutils",
      "perl-modules.perl-log-log4perl",
      "perl-modules.perl-lwp-protocol-https",
      "perl-modules.perl-module-build",
      "perl-modules.perl-parse-recdescent",
      "perl-modules.perl-regexp-common",
      "perl-modules.perl-sort-key",
      "perl-modules.perl-test-differences",
      "perl-modules.perl-text-bibtex",
      "perl-modules.perl-text-csv",
      "perl-modules.perl-text-roman",
      "perl-modules.perl-unicode-collate",
      "perl-modules.perl-unicode-linebreak",
      "perl-modules.perl-xml-libxml-simple",
      "perl-modules.perl-xml-libxslt",
      "perl-modules.perl-xml-writer"
    ]
  },
  "build": {
    "user": [
      "perl ./Build.PL",
      "./Build"
    ],
    "package": [
      "./Build install --destdir $DESTDIR"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "pst/biber.html",
  "category": "printing",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
