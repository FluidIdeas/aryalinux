{
  "name": "perl-deps.perl-datetime",
  "version": "1.66",
  "description": "Perl module perl::datetime providing build-time or runtime support for other Perl packages.",
  "url": "https://cpan.metacpan.org/authors/id/D/DR/DROLSKY/DateTime-1.66.tar.gz",
  "dependencies": {
    "required": [
      "perl-deps.perl-datetime-locale",
      "perl-deps.perl-datetime-timezone",
      "perl-deps.perl-cpan-meta-check",
      "perl-deps.perl-test-fatal",
      "perl-deps.perl-test-without-module"
    ]
  },
  "build": {
    "user": [
      "perl Makefile.PL",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "general/perl-deps.html",
  "category": "perl-dependency",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
