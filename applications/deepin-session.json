{
  "name": "deepin-session",
  "version": "2.0.25",
  "description": "New deepin session, based on systemd and existing projects (Deepin Desktop Environment).",
  "category": "desktop-deepin",
  "dependencies": {
    "required": [
      "deepin-kwin",
      "deepin-qt5integration",
      "deepin-qt5platform-plugins",
      "deepin-qt6integration",
      "deepin-qt6platform-plugins",
      "deepin-session-ui",
      "deepin-shell",
      "dtk6core",
      "glib2",
      "libcap",
      "libsecret",
      "qt6",
      "systemd"
    ]
  },
  "build": {
    "user": [
      "sed -i 's|/etc/os-version|/etc/uos-version|' tools/dde-version-checker/main.cpp",
      "cmake . -GNinja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_INSTALL_LIBEXECDIR=lib -DCMAKE_INSTALL_SYSCONFDIR=/etc ",
      "ninja"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "deepin/deepin-session.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "url": [
    "https://github.com/linuxdeepin/dde-session/archive/refs/tags/2.0.25.tar.gz"
  ]
}
