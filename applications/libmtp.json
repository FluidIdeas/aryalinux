{
  "name": "libmtp",
  "version": "1.1.23",
  "description": "libmtp is a library for communicating with MTP media players.",
  "category": "multimedia",
  "dependencies": {
    "required": [
      "libusb"
    ]
  },
  "build": {
    "user": [
      "./configure --prefix=/usr \\\n            --disable-static",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "meta": false,
  "book": "multimedia/vlc.html",
  "url": [
    "https://deb.debian.org/debian/pool/main/libm/libmtp/libmtp_1.1.23.orig.tar.gz"
  ],
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
