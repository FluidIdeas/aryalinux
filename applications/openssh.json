{
  "name": "openssh",
  "version": "10.2p1",
  "description": "The OpenSSH package contains ssh clients and the sshd daemon. This is useful for encrypting authentication and subsequent traffic over a network. The ssh and scp commands are secure implementations of telnet and rcp.",
  "url": [
    "https://ftp.openbsd.org/pub/OpenBSD/OpenSSH/portable/openssh-10.2p1.tar.gz"
  ],
  "dependencies": {},
  "build": {
    "user": [
      "./configure --prefix=/usr                            \\\n            --sysconfdir=/etc/ssh                    \\\n            --with-privsep-path=/var/lib/sshd        \\\n            --with-default-path=/usr/bin             \\\n            --with-superuser-path=/usr/sbin:/usr/bin \\\n            --with-pid-dir=/run",
      "make"
    ],
    "package": [
      "install -v -g sys -m700 -d $DESTDIR/var/lib/sshd",
      "make install DESTDIR=$DESTDIR",
      "install -v -m755    contrib/ssh-copy-id $DESTDIR/usr/bin",
      "install -v -m644    contrib/ssh-copy-id.1 \\\n                    $DESTDIR/usr/share/man/man1",
      "tar -xf ../../blfs-systemd-units-20251204.tar.xz -C ../../",
      "cd ../../blfs-systemd-units-20251204 && make install-sshd DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [
    "getent group sshd >/dev/null || groupadd -g 50 sshd",
    "id -u sshd >/dev/null 2>&1 || useradd -c 'sshd PrivSep' -d /var/lib/sshd -g sshd -s /bin/false -u 50 sshd",
    "grep -q '^PermitRootLogin no' /etc/ssh/sshd_config || echo 'PermitRootLogin no' >> /etc/ssh/sshd_config",
    "grep -q '^PasswordAuthentication no' /etc/ssh/sshd_config || echo 'PasswordAuthentication no' >> /etc/ssh/sshd_config",
    "grep -q '^KbdInteractiveAuthentication no' /etc/ssh/sshd_config || echo 'KbdInteractiveAuthentication no' >> /etc/ssh/sshd_config",
    "test -f /etc/pam.d/sshd || (sed 's@d/login@d/sshd@g' /etc/pam.d/login > /etc/pam.d/sshd && chmod 644 /etc/pam.d/sshd)",
    "grep -q '^UsePAM yes' /etc/ssh/sshd_config || echo 'UsePAM yes' >> /etc/ssh/sshd_config",
    "systemctl enable sshd"
  ],
  "meta": false,
  "book": "postlfs/openssh.html",
  "category": "security",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "additionalUrls": [
    "https://www.linuxfromscratch.org/blfs/downloads/13.0-systemd/blfs-systemd-units-20251204.tar.xz"
  ]
}
