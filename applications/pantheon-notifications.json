{
  "name": "pantheon-notifications",
  "version": "8.1.2",
  "description": "Pantheon notification server.",
  "category": "desktop-pantheon",
  "url": [
    "https://github.com/elementary/notifications/archive/refs/tags/8.1.2.tar.gz"
  ],
  "dependencies": {
    "required": [
      "glib2",
      "granite7",
      "gtk4",
      "libadwaita",
      "libcanberra",
      "libhandy"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr -Dbuildtype=release  .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "pantheon/pantheon-notifications.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
