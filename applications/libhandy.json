{
  "name": "libhandy",
  "version": "1.8.3",
  "description": "GTK3 adaptive UI library for Pantheon/Gala.",
  "category": "libraries",
  "url": [
    "https://gitlab.gnome.org/GNOME/libhandy/-/archive/1.8.3/libhandy-1.8.3.tar.gz"
  ],
  "dependencies": {
    "required": [
      "cairo",
      "fribidi",
      "gdk-pixbuf",
      "glib2",
      "gtk3",
      "pango"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr -Dbuildtype=release -Dgtk_doc=false .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "pantheon/libhandy.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
