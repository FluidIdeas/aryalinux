{
  "name": "x7font",
  "version": "7",
  "description": "BLFS Xorg Fonts chapter — metapackage installing scalable font packages in dependency order.",
  "category": "metapackage",
  "dependencies": {
    "required": [
      "xcursor-themes"
    ]
  },
  "build": {},
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "post_install": [
    "install -d /usr/share/fonts",
    "ln -sf /usr/share/fonts/X11/OTF /usr/share/fonts/X11-OTF",
    "ln -sf /usr/share/fonts/X11/TTF /usr/share/fonts/X11-TTF"
  ],
  "meta": true,
  "book": "x/x7font.html"
}
