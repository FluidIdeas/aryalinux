{
  "name": "perl-deps.perl-config-autoconf",
  "version": "0.320",
  "description": "Perl module perl::config::autoconf providing build-time or runtime support for other Perl packages.",
  "url": "https://cpan.metacpan.org/authors/id/A/AM/AMBS/Config-AutoConf-0.320.tar.gz",
  "dependencies": {
    "required": [
      "perl-deps.perl-capture-tiny",
      "perl-modules.perl-file-slurper"
    ]
  },
  "build": {
    "user": [
      "perl Makefile.PL",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "meta": false,
  "book": "general/perl-deps.html",
  "category": "perl-dependency",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
