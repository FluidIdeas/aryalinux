{
  "name": "libgcrypt",
  "version": "1.12.0",
  "description": "The libgcrypt package contains a general purpose crypto library based on the code used in GnuPG. The library provides a high level interface to cryptographic building blocks using an extendable and flexible API.",
  "url": "https://www.gnupg.org/ftp/gcrypt/libgcrypt/libgcrypt-1.12.0.tar.bz2",
  "dependencies": {
    "required": [
      "libgpg-error"
    ]
  },
  "build": {
    "user": [
      "./configure --prefix=/usr",
      "make",
      "make -C doc html",
      "makeinfo --html --no-split -o doc/gcrypt_nochunks.html doc/gcrypt.texi",
      "makeinfo --plaintext       -o doc/gcrypt.txt           doc/gcrypt.texi"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR",
      "install -v -dm755   $DESTDIR/usr/share/doc$DESTDIR/libgcrypt-1.12.0",
      "install -v -m644    README doc/{README.apichanges,fips*,libgcrypt*} \\\n                    $DESTDIR/usr/share/doc$DESTDIR/libgcrypt-1.12.0",
      "install -v -dm755   $DESTDIR/usr/share/doc$DESTDIR/libgcrypt-1.12.0/html",
      "install -v -m644 doc/gcrypt.html/* \\\n                    $DESTDIR/usr/share/doc$DESTDIR/libgcrypt-1.12.0/html",
      "install -v -m644 doc/gcrypt_nochunks.html \\\n                    $DESTDIR/usr/share/doc$DESTDIR/libgcrypt-1.12.0",
      "install -v -m644 doc/gcrypt.{txt,texi} \\\n                    $DESTDIR/usr/share/doc$DESTDIR/libgcrypt-1.12.0"
    ]
  },
  "meta": false,
  "book": "general/libgcrypt.html",
  "category": "libraries",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
