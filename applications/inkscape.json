{
  "name": "inkscape",
  "version": "1.4.3",
  "description": "Inkscape is a what you see is what you get Scalable Vector Graphics editor. It is useful for creating, viewing and changing SVG images.",
  "url": "https://inkscape.org/gallery/item/58914/inkscape-1.4.3.tar.xz",
  "dependencies": {
    "required": [
      "boost",
      "gc",
      "gsl",
      "gtkmm3",
      "imagemagick",
      "lcms2",
      "potrace",
      "python-modules.cachecontrol",
      "python-modules.cssselect"
    ]
  },
  "build": {
    "user": [
      "patch -Np1 -i inkscape-1.4.3-poppler_26.02-1.patch",
      "sed -i 's/gfree/g_free/' src/extension/internal/pdfinput/pdf-input.cpp",
      "sed -e '/Stream.h/a#include <poppler/goo/gmem.h>' \\\n    -e 's/reset/rewind/'                          \\\n    -i src/extension/internal/pdfinput/svg-builder.cpp",
      "cmake -B build -D CMAKE_INSTALL_PREFIX=/usr \\\n      -D CMAKE_BUILD_TYPE=Release         \\\n      -W no-dev ..",
      "make -C build"
    ],
    "package": [
      "make -C build install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [
    "gtk-update-icon-cache -qtf /usr/share/icons/hicolor",
    "update-desktop-database -q"
  ],
  "meta": false,
  "book": "xsoft/inkscape.html",
  "category": "applications",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
