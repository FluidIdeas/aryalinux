{
  "name": "attica",
  "version": "6.23.0",
  "description": "KDE Frameworks 6 module attica.",
  "category": "desktop-kde",
  "url": [
    "https://download.kde.org/stable/frameworks/6.23/attica-6.23.0.tar.xz"
  ],
  "dependencies": {
    "required": [
      "breeze-icons",
      "docbook",
      "docbook-xsl",
      "extra-cmake-modules",
      "libcanberra",
      "libgcrypt",
      "libical",
      "libqrencode",
      "libsecret",
      "libxslt",
      "lmdb",
      "perl-modules.perl-uri",
      "plasma-wayland-protocols",
      "python-modules.PyYAML",
      "qca",
      "qt6",
      "shared-mime-info"
    ]
  },
  "build": {
    "environment": {
      "KF6_PREFIX": "/usr"
    },
    "user": [
      "cmake -B build -D CMAKE_INSTALL_PREFIX=$KF6_PREFIX \\\n      -D CMAKE_INSTALL_LIBEXECDIR=libexec \\\n      -D CMAKE_PREFIX_PATH=$QT6DIR \\\n      -D CMAKE_SKIP_INSTALL_RPATH=ON \\\n      -D CMAKE_BUILD_TYPE=Release \\\n      -D BUILD_TESTING=OFF \\\n      -D BUILD_PYTHON_BINDINGS=OFF \\\n      -W no-dev .",
      "make -C build"
    ],
    "package": [
      "make -C build install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "kde/frameworks6.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
