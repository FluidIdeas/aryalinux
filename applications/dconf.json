{
  "name": "dconf",
  "version": "49.0",
  "description": "The DConf package contains a low-level configuration system. Its main purpose is to provide a backend to GSettings on platforms that don't already have configuration storage systems.",
  "url": [
    "https://download.gnome.org/sources/dconf/0.49/dconf-0.49.0.tar.xz",
    "https://download.gnome.org/sources/dconf-editor/49/dconf-editor-49.0.tar.xz"
  ],
  "dependencies": {
    "required": [
      "dbus",
      "gtk3",
      "libhandy1",
      "libxml2",
      "libxslt"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr            \\\n            --buildtype=release      \\\n            -D bash_completion=false \\\n            .",
      "ninja -C build",
      "tar -xf ../../dconf-editor-49.0.tar.xz",
      "meson setup dconf-editor-49.0/build --prefix=/usr --buildtype=release dconf-editor-49.0",
      "ninja -C dconf-editor-49.0/build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install",
      "DESTDIR=$DESTDIR ninja -C dconf-editor-49.0/build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "gnome/dconf.html",
  "category": "desktop-gnome",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
