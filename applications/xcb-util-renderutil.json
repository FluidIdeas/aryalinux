{
  "name": "xcb-util-renderutil",
  "version": "0.3.10",
  "description": "XCB utility library for XCB render extension helpers.",
  "category": "x11",
  "url": [
    "https://xorg.freedesktop.org/archive/individual/lib/xcb-util-renderutil-0.3.10.tar.xz"
  ],
  "dependencies": {
    "required": [
      "libxcb",
      "xcb-util"
    ]
  },
  "build": {
    "user": [
      "./configure $XORG_CONFIG",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "x/xcb-utilities.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
