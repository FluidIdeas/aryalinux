{
  "name": "dtklog",
  "version": "6.7.43",
  "description": "DTK logger library (Qt5 build) for Deepin Desktop Environment.",
  "category": "desktop-deepin",
  "dependencies": {
    "required": [
      "qt5-base",
      "spdlog",
      "fmt"
    ]
  },
  "build": {
    "user": [
      "cmake . -Bbuild-qt5 -GNinja -DDTK5=ON -DBUILD_WITH_SYSTEMD=ON -DMKSPECS_INSTALL_DIR=lib/qt/mkspecs/modules -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_INSTALL_PREFIX=/usr",
      "cmake --build build-qt5"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build-qt5 install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "deepin/dtklog.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "url": [
    "https://github.com/linuxdeepin/dtklog/archive/refs/tags/6.7.43.tar.gz"
  ]
}
