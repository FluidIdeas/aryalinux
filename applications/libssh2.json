{
  "name": "libssh2",
  "version": "1.11.1",
  "description": "Libssh2 package is a client-side C library implementing the SSH2 protocol.",
  "url": "https://www.libssh2.org/download/libssh2-1.11.1.tar.gz",
  "dependencies": {},
  "build": {
    "user": [
      "./configure --prefix=/usr          \\\n            --disable-docker-tests \\\n            --disable-static",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "meta": false,
  "book": "general/libssh2.html",
  "category": "libraries",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
