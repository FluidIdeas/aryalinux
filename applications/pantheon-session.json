{
  "name": "pantheon-session",
  "version": "8.1.0",
  "description": "Pantheon session settings and autostart.",
  "category": "desktop-pantheon",
  "url": [
    "https://github.com/elementary/session-settings/archive/refs/tags/8.1.0.tar.gz"
  ],
  "dependencies": {
    "required": [
      "dconf",
      "gala",
      "gnome-keyring",
      "gnome-session",
      "gnome-settings-daemon",
      "granite",
      "pantheon-applications-menu",
      "plank",
      "wingpanel",
      "xdg-user-dirs-gtk"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr -Dbuildtype=release -Dfallback-session=gnome -Dx11=false .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "pantheon/pantheon-session.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
