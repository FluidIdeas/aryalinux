{
  "name": "nasm",
  "version": "3.01",
  "description": "NASM (Netwide Assembler) is an 80x86 assembler designed for portability and modularity. It includes a disassembler as well.",
  "url": [
    "https://www.nasm.us/pub/nasm/releasebuilds/3.01/nasm-3.01.tar.xz"
  ],
  "dependencies": {},
  "build": {
    "user": [
      "./configure --prefix=/usr",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "general/nasm.html",
  "category": "programming",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
