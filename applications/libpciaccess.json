{
  "name": "libpciaccess",
  "version": "0.18.1",
  "description": "Xorg library libpciaccess (BLFS chapter).",
  "url": [
    "https://xorg.freedesktop.org/archive/individual/lib/libpciaccess-0.18.1.tar.xz"
  ],
  "dependencies": {
    "required": [
      "libXxf86vm"
    ]
  },
  "build": {
    "environment": {
      "XORG_PREFIX": "/usr",
      "XORG_CONFIG": "--prefix=/usr --sysconfdir=/etc --localstatedir=/var --disable-static"
    },
    "user": [
      "rm -rf build",
      "meson setup build --prefix=$XORG_PREFIX --buildtype=release",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "x/libpciaccess.html",
  "category": "x11",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
