{
  "name": "libXt",
  "version": "1.3.1",
  "description": "Xorg library libXt (BLFS chapter).",
  "url": [
    "https://xorg.freedesktop.org/archive/individual/lib/libXt-1.3.1.tar.xz"
  ],
  "dependencies": {
    "required": [
      "libXScrnSaver"
    ]
  },
  "build": {
    "environment": {
      "XORG_PREFIX": "/usr",
      "XORG_CONFIG": "--prefix=/usr --sysconfdir=/etc --localstatedir=/var --disable-static"
    },
    "user": [
      "./configure $XORG_CONFIG --with-appdefaultdir=/etc/X11/app-defaults",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "x/libXt.html",
  "category": "x11",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
