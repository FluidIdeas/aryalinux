{
  "name": "xprintidle",
  "version": "0.3.0",
  "description": "Print user idle time from X11 (Budgie extras dependency).",
  "category": "applications",
  "url": [
    "https://github.com/g0hl1n/xprintidle/archive/0.3.0/xprintidle-0.3.0.tar.gz"
  ],
  "dependencies": {
    "required": [
      "libx11"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr -Dbuildtype=release xprintidle-0.3.0",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "budgie/xprintidle.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
