{
  "name": "swayidle",
  "version": "1.9.0",
  "description": "Idle management daemon for Wayland compositors.",
  "category": "applications",
  "url": [
    "https://github.com/swaywm/swayidle/releases/download/v1.9.0/swayidle-1.9.0.tar.gz",
    "https://github.com/swaywm/swayidle/archive/refs/tags/v1.9.0.tar.gz"
  ],
  "dependencies": {
    "required": [
      "libxkbcommon",
      "systemd",
      "wayland"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr -Dbuildtype=release .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "budgie/swayidle.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
