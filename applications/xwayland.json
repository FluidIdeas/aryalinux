{
  "name": "xwayland",
  "version": "24.1.9",
  "description": "The Xwayland package is an Xorg server running on top of the wayland server. It has been separated from the main Xorg server package. It allows running X clients inside a wayland session.",
  "url": "https://www.x.org/pub/individual/xserver/xwayland-24.1.9.tar.xz",
  "dependencies": {
    "required": [
      "libxcvt",
      "wayland-protocols",
      "x7app",
      "x7font",
      "libepoxy"
    ]
  },
  "build": {
    "environment": {
      "XORG_PREFIX": "/usr"
    },
    "user": [
      "sed -i '/install_man/,$d' meson.build",
      "mkdir build",
      "cd    build",
      "meson setup ..              \\\n      --prefix=$XORG_PREFIX \\\n      --buildtype=release   \\\n      -D xkb_output_dir=/var/lib/xkb",
      "ninja"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja install",
      "install -vm755 hw/vfb/Xvfb $DESTDIR/usr/bin"
    ]
  },
  "meta": false,
  "book": "x/xwayland.html",
  "category": "x11",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
