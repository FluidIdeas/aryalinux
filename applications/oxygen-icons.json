{
  "name": "oxygen-icons",
  "version": "6.1.0",
  "description": "",
  "category": "",
  "dependencies": {
    "required": [
      "extra-cmake-modules",
      "qt6"
    ]
  },
  "build": {
    "user": [
      "sed -i '/( oxygen/ s/)/scalable )/' CMakeLists.txt",
      "cmake -B build -D CMAKE_INSTALL_PREFIX=/usr -W no-dev ."
    ],
    "package": [
      "make -C build install DESTDIR=$DESTDIR"
    ]
  },
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "meta": false,
  "book": "x/oxygen-icons.html",
  "url": [
    "https://download.kde.org/stable/oxygen-icons/oxygen-icons-6.1.0.tar.xz"
  ]
}
