{
  "name": "deepin-device-formatter",
  "version": "1.5.11",
  "description": "A simple graphical interface for creating file system in a block device (Deepin Desktop Environment).",
  "category": "desktop-deepin",
  "dependencies": {
    "required": [
      "deepin-qt6integration",
      "deepin-qt6platform-plugins",
      "dtk6core",
      "dtk6gui",
      "dtk6widget",
      "qt6",
      "udisks2-qt6"
    ]
  },
  "build": {
    "user": [
      "cmake . -GNinja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_INSTALL_LIBEXECDIR=lib -DCMAKE_INSTALL_SYSCONFDIR=/etc ",
      "ninja"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "deepin/deepin-device-formatter.html",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  },
  "url": [
    "https://github.com/linuxdeepin/deepin-device-formatter/archive/refs/tags/1.5.11.tar.gz"
  ]
}
