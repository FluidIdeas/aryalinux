{
  "name": "libraw",
  "version": "0.22.0",
  "description": "Libraw is a library for reading RAW files obtained from digital cameras (CRW/CR2, NEF, RAF, DNG, and others).",
  "url": "https://www.libraw.org/data/LibRaw-0.22.0.tar.gz",
  "dependencies": {
    "required": [
      "libjpeg",
      "jasper",
      "lcms2"
    ]
  },
  "build": {
    "user": [
      "./configure --prefix=/usr    \\\n            --enable-jpeg    \\\n            --enable-jasper  \\\n            --enable-lcms    \\\n            --disable-static",
      "make"
    ],
    "package": [
      "make install DESTDIR=$DESTDIR"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "general/libraw.html",
  "category": "graphics",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
