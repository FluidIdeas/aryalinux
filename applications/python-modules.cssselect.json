{
  "name": "python-modules.cssselect",
  "version": "1.4.0",
  "description": "Python module cssselect for scripts and applications that depend on it.",
  "url": "https://files.pythonhosted.org/packages/source/c/cssselect/cssselect-1.4.0.tar.gz",
  "dependencies": {
    "required": [
      "python-deps.setuptools_scm"
    ]
  },
  "build": {
    "user": [
      "pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD"
    ],
    "package": [
      "pip3 install --root=$DESTDIR --no-index --find-links dist --no-user cssselect"
    ]
  },
  "meta": false,
  "book": "general/python-modules.html",
  "category": "python-module",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
