{
  "name": "libbluray",
  "version": "1.4.0",
  "description": "libbluray is an open-source library for Blu-Ray Disc playback in media players.",
  "category": "multimedia",
  "dependencies": {
    "required": [
      "libxml2"
    ]
  },
  "build": {
    "user": [
      "meson setup build --prefix=/usr       \\\n            --buildtype=release \\\n            -D enable_tools=false \\\n            -D bdj_jar=disabled   \\\n            .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "meta": false,
  "book": "multimedia/vlc.html",
  "url": [
    "https://download.videolan.org/pub/videolan/libbluray/1.4.0/libbluray-1.4.0.tar.xz"
  ],
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
