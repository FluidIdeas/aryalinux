{
  "name": "gnome-color-manager",
  "version": "3.36.2",
  "description": "GNOME Color Manager is a session framework for the GNOME desktop environment that makes it easy to manage, install and generate color profiles.",
  "url": "https://download.gnome.org/sources/gnome-color-manager/3.36/gnome-color-manager-3.36.2.tar.xz",
  "dependencies": {
    "required": [
      "colord",
      "itstool",
      "desktop-file-utils"
    ]
  },
  "build": {
    "user": [
      "sed /subdir\\(\\'man/d -i meson.build",
      "meson setup build --prefix=/usr --buildtype=release .",
      "ninja -C build"
    ],
    "package": [
      "DESTDIR=$DESTDIR ninja -C build install"
    ]
  },
  "post_install": [],
  "meta": false,
  "book": "gnome/gnome-color-manager.html",
  "category": "desktop-gnome",
  "install": {
    "extract": [
      "tar -xJf $PACKAGE -C /"
    ]
  }
}
